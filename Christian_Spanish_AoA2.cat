            <profile id="cb7f-4ad2-4312-c4db" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The General has a hand weapon, light armour and shield. Army General. May ride a horse (+9). May have heavy armour (+1), javelins (+2) and thrusting or throwing spear (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="90c3-cb9f-513f-bed5" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
