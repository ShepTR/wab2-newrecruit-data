              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Cavalry have a hand weapon, light armour, javelins and shield. Light Cavalry. Feigned Flight. May have throwing spear (+1).</characteristic>
              </characteristics>
