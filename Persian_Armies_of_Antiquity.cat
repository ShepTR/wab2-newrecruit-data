                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">6</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">6</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="84b3-fdfa-417b-af5c" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All Persian chariot crewmen count as having light armour and are armed with a bow. War wagons are pulled by oxen and so do not cause impact hits when they charge; they charge at normal speed. One bolt thrower or war wagon per 500 points in the army. (Armies of Antiquity p.13)</characteristic>
              </characteristics>
            </profile>
            <profile id="c373-f039-6953-bcff" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="f760-59c8-cc43-0801" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="61b1-417c-ded1-5818" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
            <infoLink id="ee6a-edd0-459b-963c" name="Bow" hidden="false" targetId="5d29-ba1e-8299-8085" type="profile"/>
