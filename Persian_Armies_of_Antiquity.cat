            </profile>
            <profile id="0722-7d8b-eae0-7c29" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons and javelins. May have light armour (+1 pt), shield (+1 pt), thrusting spear (+1 pt), bow (+2 pts), barding (+2 pts). Bactrians/Nobles and units with barding count rank bonus of up to +1 when charging. All levies &amp; mercenaries are subject to fear against all enemy units they do not outnumber by at least 2 to 1. (Armies of Antiquity p.13)</characteristic>
              </characteristics>
            </profile>
            <profile id="000e-46d2-badc-f791" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="23bb-1ad2-6e07-9ac6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6794-9558-d334-e213" type="atLeast"/>
