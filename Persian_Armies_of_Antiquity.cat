            </profile>
            <profile id="81ff-66c1-4d46-9693" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon. May have light armour (+3 pts). May ride in a light chariot (bought at an additional cost from the list) or be on a warhorse (+4 pts); if on a warhorse it may have barding (+4 pts). 0-1. (Armies of Antiquity p.12)</characteristic>
              </characteristics>
            </profile>
            <profile id="4ed3-48ac-765a-9c80" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="b51a-f95b-d68b-7d86" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="bddd-27a9-7276-8975" type="atLeast"/>
