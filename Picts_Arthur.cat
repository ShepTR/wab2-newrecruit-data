            </profile>
            <profile id="79bf-2935-7028-3c50" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Staff or similar hand weapon. May be mounted on a horse (M7, +8). Pagan Priest. No Character Advantages. 0-1. In the Later Southern Pictish Kingdoms the army may include either a Magus or a Christian Priest, not both. (The Age of Arthur p.65)</characteristic>
              </characteristics>
            </profile>
            <profile id="4cb9-96c7-9063-223f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="a559-d360-6917-d279" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="6eff-70fe-6cfb-fffb" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
