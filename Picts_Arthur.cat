            <profile id="c733-9703-79fc-3d66" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The unit must be led by a single Packmaster and may include up to six Hunting Hounds. The Packmaster has javelins and a buckler; the hounds have their teeth. Warband. Skirmishers. Missile hits are randomly divided between the Packmaster and the hounds; the hounds use the Master's Leadership unless he is killed. 0-1 unit. (The Age of Arthur p.66)</characteristic>
              </characteristics>
            </profile>
            <profile id="9a82-f3b5-69f7-07f6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
