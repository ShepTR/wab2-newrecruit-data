            <profile id="f066-ea9a-3ba1-93eb" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon. May have shield (+2), light armour (+3), horse (+8). Christian Priest. No Character Advantages. 0-1. Not available in the Early Southern Pictish Kingdoms or Picts of the North. (The Age of Arthur p.65)</characteristic>
              </characteristics>
            </profile>
            <profile id="8eca-fe73-3bff-5798" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
