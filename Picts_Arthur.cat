                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="2e07-b87f-ea08-2cbe" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, throwing spears, buckler, javelins and ponies. May have light armour (+3). Ponies may be exchanged for horses (+3, M7) in the Early and Later Southern Pictish Kingdoms. Light Cavalry. Not in the North or the Attecotti (no horses). 0-1 unit of Nobles (foot or mounted). (The Age of Arthur p.66)</characteristic>
              </characteristics>
            </profile>
            <profile id="bb0d-ad3a-4b03-1b35" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">5+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="259f-bb09-0fd5-9bea" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f6b1-1fd9-21a3-19f1" type="atLeast"/>
                <condition field="selections" scope="259f-bb09-0fd5-9bea" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ef2d-5ecf-3347-3661" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="4+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="259f-bb09-0fd5-9bea" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f6b1-1fd9-21a3-19f1" type="atLeast"/>
