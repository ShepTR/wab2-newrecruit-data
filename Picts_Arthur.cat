            <profile id="d4f6-ac6a-dd02-6105" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, throwing spears, buckler and javelins. May have light armour (+3; not in the North or the Attecotti). Light Infantry. Warband rules 1 and 2. In the Attecotti army all Nobles and Warriors are Fierce. 0-1 unit of Nobles (foot or mounted). (The Age of Arthur p.66)</characteristic>
              </characteristics>
            </profile>
            <profile id="ce2a-ac04-6e3e-23d0" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">6+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="b3c1-43a5-8ee9-83e1" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e424-0708-866c-a0d9" type="atLeast"/>
