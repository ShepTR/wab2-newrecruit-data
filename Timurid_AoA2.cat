          <profiles>
            <profile id="c261-dc81-e6a2-9608" name="2+ Timurid Cavalry" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
                <conditions>
                <condition field="selections" scope="9c2e-69eb-ed8b-5cc9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7d81-0409-fd16-4acd" type="atLeast"/>
                <condition field="selections" scope="9c2e-69eb-ed8b-5cc9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1d39-5e65-0458-5f88" type="atLeast"/>
                <condition field="selections" scope="9c2e-69eb-ed8b-5cc9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f77e-ba9f-0141-0160" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
                <conditions>
                <condition field="selections" scope="9c2e-69eb-ed8b-5cc9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7d81-0409-fd16-4acd" type="atLeast"/>
                <condition field="selections" scope="9c2e-69eb-ed8b-5cc9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1d39-5e65-0458-5f88" type="atLeast"/>
                <condition field="selections" scope="9c2e-69eb-ed8b-5cc9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f77e-ba9f-0141-0160" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="f1f5-a68f-e5f4-cb7a" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have a hand weapon, light armour, buckler and composite bow. May have heavy armour (+1), thrusting spear (+3) and swap buckler for shield (+1). May have cloth barding (+4). All heavy cavalry may be fielded dismounted (Timurids (–16), Subject Nobles (–14), Subject Cavalry (-9)) Timurid Cavalry are Drilled and Expert Horsemen, with Feigned Flight. May be Veteran (+1). May have lance (+8). If lance is taken, they lose Feigned Flight but gain First Charge. Units that do not have heavy armour or lance may be designated Light Cavalry (+2). They then have Parthian Shot.</characteristic>
              </characteristics>
            </profile>
            <profile id="8811-18d7-9bf4-8832" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">4+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="9c2e-69eb-ed8b-5cc9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7d81-0409-fd16-4acd" type="atLeast"/>
                <condition field="selections" scope="9c2e-69eb-ed8b-5cc9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1d39-5e65-0458-5f88" type="lessThan"/>
