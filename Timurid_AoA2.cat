                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="44f7-aac5-d94a-aad3" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have a hand weapon, light armour, buckler and composite bow. May have heavy armour (+1), thrusting spear (+3) and swap buckler for shield (+1). May have cloth barding (+4). All heavy cavalry may be fielded dismounted (Timurids (–16), Subject Nobles (–14), Subject Cavalry (-9)) Timurid Cavalry are Drilled and Expert Horsemen, with Feigned Flight. May be Veteran (+1). May have lance (+8). If lance is taken, they lose Feigned Flight but gain First Charge. Units that do not have heavy armour or lance may be designated Light Cavalry (+2). They then have Parthian Shot.</characteristic>
              </characteristics>
            </profile>
            <profile id="cc24-2b4a-6282-1cde" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">4+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="7633-8e7c-6e32-03c0" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c41c-4517-fb5e-1e22" type="atLeast"/>
                <condition field="selections" scope="7633-8e7c-6e32-03c0" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="31d7-75ae-0325-67bf" type="lessThan"/>
