                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="9076-2a0a-b089-a543" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="bb9d-6966-e3bf-536a" type="atLeast"/>
                <condition field="selections" scope="9076-2a0a-b089-a543" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="f15f-55eb-93b9-3b49" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
