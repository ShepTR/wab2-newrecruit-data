            <profile id="cdf4-46df-c7b5-0b1e" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All archers have a hand weapon, composite bow and shield. May have light armour (+2). Light Infantry. Militia Archers have improvised weapons and composite bow. Light Infantry. Levies.</characteristic>
              </characteristics>
            </profile>
            <profile id="5918-1825-24be-7348" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="6019-4c70-c384-0080" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="727b-a5f4-548c-9cc6" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
