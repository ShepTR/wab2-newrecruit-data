              </modifiers>
            </profile>
            <profile id="9347-217a-0120-0521" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The General rides a horse and has a hand weapon, light armour, composite bow and shield. Army General. Expert Horsemen. Feigned Flight. Parthian shot. May have heavy armour (+1), thrusting spear (+2) and cloth barding (+3). May take lance (+1) if so, remove Feigned Flight and Parthian shot.</characteristic>
              </characteristics>
            </profile>
            <profile id="c837-75bd-844d-b1a2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="9076-2a0a-b089-a543" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="bb9d-6966-e3bf-536a" type="atLeast"/>
