            <profile id="4e2b-3b3c-585c-b19f" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All ride a horse and have a hand weapon, light armour and shield. Feigned Flight. Parthian Shot. Amirs are Expert Horsemen and may have composite bow, (+4), thrusting spear (+3), heavy armour (+1) and cloth barding (+3). May take lance (+1) if so, loose Feigned Flight and Parthian Shot.</characteristic>
              </characteristics>
            </profile>
            <profile id="fac2-afec-3bec-c18b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
