                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">-</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">-</characteristic>
              </characteristics>
            </profile>
            <profile id="7ccf-4b0a-e68f-20cc" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Each machine has a crew of two to three men armed with swords. May have light armour (+2 pts per crewman). Bolt thrower: Range 48", Strength 5 (-1 per rank), no save, D4 wounds per hit. No more than one artillery piece per infantry unit in the army. One artillery piece or scythed chariot per 500 points in the army. (Armies of Antiquity p.17)</characteristic>
              </characteristics>
            </profile>
