            </profile>
            <profile id="6006-20cd-bd99-39d0" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Unarmed mahout and up to three crew armed with javelins or bows at +8 pts per crewman. Any crew may have light armour (+2 pts), pike (+1 pt) or shield (+1 pt). Elephant may have barding (+16 pts). Elephants: all elephants must be either African or Indian; you cannot mix both types in the same army. One elephant per 1,000 points in the army. (Armies of Antiquity p.17)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="125"/>
          </costs>
        </selectionEntry>
