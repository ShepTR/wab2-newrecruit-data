              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, thrusting spear, shield and horse. May wear light armour (+2 pts). Open Order. Combined Formation; may be included in a unit of Mounted Mercenary Knights in which case they are no longer Open Order. (Armies of Chivalry p.39)</characteristic>
              </characteristics>
            </profile>
            <profile id="b1f6-2a6e-64b0-c854" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="9b9a-6a46-2bb7-b84e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c6fe-2083-9f56-d297" type="atLeast"/>
