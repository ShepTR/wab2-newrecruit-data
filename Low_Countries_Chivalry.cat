            </profile>
            <profile id="23d2-39cf-4678-aee8" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, partial plate armour and shield. Armed with a lance and a warhorse. May wear full plate armour (free). The warhorse may have cloth barding (+4 pts). Impetuous, First Charge, Combined Formation (may include Sergeants). Mounted Mercenary Knights count a Rank Bonus of up to +1 if supported by Sergeants. (Armies of Chivalry p.38)</characteristic>
              </characteristics>
            </profile>
            <profile id="5c82-9058-5662-07c5" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="46d6-f9aa-3eea-c296" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e4cc-fc87-1864-b1f1" type="lessThan"/>
