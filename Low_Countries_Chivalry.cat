            <profile id="f330-8548-15a3-26d0" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and shield. May wear partial plate (mounted free, dismounted +2 pts) or full plate armour (mounted free, dismounted +4 pts). Rides a warhorse (free) if mounted. The warhorse may have cloth barding (+4 pts). Army Battle Standard. 0-1. (Armies of Chivalry p.38)</characteristic>
              </characteristics>
            </profile>
            <profile id="5553-3b88-fada-a036" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
