            <profile id="a47b-9a76-490e-df2d" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, partial plate armour and shield. May be mounted with a lance and a warhorse. Armed with a double-handed weapon (free) or a pike (+2 pts) if on foot. May wear full plate armour (mounted free, dismounted +2 pts). The warhorse may have cloth barding (+4 pts). Army General. 0-1. (Armies of Chivalry p.38)</characteristic>
              </characteristics>
            </profile>
            <profile id="62d3-d0f5-444e-7851" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
