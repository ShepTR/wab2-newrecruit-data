                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">4+</characteristic>
              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="3+">
                <conditions>
                <condition field="selections" scope="fce2-1c90-cc11-26f8" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="df0b-93f2-1d10-c03d" type="atLeast"/>
