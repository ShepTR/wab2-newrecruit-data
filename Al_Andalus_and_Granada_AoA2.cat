                <conditions>
                <condition field="selections" scope="fce2-1c90-cc11-26f8" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="df0b-93f2-1d10-c03d" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="7d3a-b189-302d-9aa3" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Lancers have a hand weapon, light armour, throwing or thrusting spear and shield. May take lance (+3) and have heavy armour (+1). All Andalusian cavalry other than lancers may change from skirmish to open order formation or from open order to skirmish using a Reform move.</characteristic>
              </characteristics>
            </profile>
            <profile id="d3cf-2cb7-8407-2b17" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="fce2-1c90-cc11-26f8" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="df0b-93f2-1d10-c03d" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
