                <conditions>
                <condition field="selections" scope="db4f-1966-634c-6eef" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="cfdc-44f1-fd73-67f7" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="bf1a-feef-afc6-5464" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Jinetes have a hand weapon and javelins. Light Cavalry. Feigned Flight. May have a throwing spear (+3) and shield (+1). Up to half of Jinetes units may have composite bow (+4), in which case they are Expert Horsemen but may not take throwing spears. All Andalusian cavalry other than lancers may change from skirmish to open order formation or from open order to skirmish using a Reform move.</characteristic>
              </characteristics>
            </profile>
            <profile id="f1aa-4848-fc1b-f30e" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="db4f-1966-634c-6eef" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="cfdc-44f1-fd73-67f7" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="9221-8237-12fc-d4f4" name="Feigned Flight" hidden="false" targetId="23ce-0721-aa10-1f4d" type="rule"/>
            <infoLink id="7e81-dfff-7825-901a" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
