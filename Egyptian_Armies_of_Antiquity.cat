            <profile id="6bd1-abdd-4424-f1a4" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Khepesh (sickle sword), axe, mace or other hand weapon, throwing spear and shield. May have a double-handed weapon such as a mace-axe instead of a throwing spear (+2 pts). May have light armour (+2 pts). Types include spearmen, mace-axe men and khepesh men. (Armies of Antiquity p.5)</characteristic>
              </characteristics>
            </profile>
            <profile id="df93-2f01-33f5-7ab2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="c1f7-eb27-746f-760b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fe12-69d7-6e49-a18c" type="atLeast"/>
