              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, light armour and shield. May have composite bow +3, spear +2, javelins +2. May ride in a chariot bought at an additional cost from this army list. Army General. 0-1 General (King or General). (Chariot Wars p.49)</characteristic>
              </characteristics>
            </profile>
            <profile id="7a03-a668-0f2d-b000" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
