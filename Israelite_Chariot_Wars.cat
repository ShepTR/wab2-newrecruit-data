      <selectionEntries>
        <selectionEntry id="4ca5-246c-a914-fa80" name="Ark &amp; four priests" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ccc1-f292-c974-9016" type="min"/>
          </constraints>
          <profiles>
            <profile id="587d-00c1-c941-0b8d" name="Ark &amp; four priests" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">0</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">4</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">10</characteristic>
              </characteristics>
            </profile>
            <profile id="34b2-a225-c091-b415" name="Equipment and options (as printed in WAB2 army list)" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The Ark of the Covenant is a portable shrine accompanied by four priests armed with swords and light armour. Army Standard. May only be chosen instead of an army standard bearer, and only if the army does not include any chariots. The Ark and the Priests form a single unit and may not join other units; placed on a single base and move and manoeuvre as a heavy chariot; may not charge. Any unit within 6" of the Ark may automatically rally. Any unit within sight of the Ark may re-roll any Break or Rally tests. If the Ark flees or is captured or destroyed, all units within sight must take an immediate Panic test. The Priests are treated as being stubborn. 0-1 (instead of Army Standard Bearer). (Chariot Wars p.49)</characteristic>
              </characteristics>
            </profile>
            <profile id="1c0b-b766-0d0e-c13b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="cc7e-4322-1379-9e75" name="Army Standard" hidden="false" targetId="41fc-5de5-0862-91b8" type="rule"/>
            <infoLink id="7358-266b-8520-7702" name="Sacred Ark" hidden="false" targetId="b26f-4ed9-3173-6c4c" type="rule"/>
            <infoLink id="75d1-6e3e-5dfe-6ec6" name="Stubborn" hidden="false" targetId="ce73-f053-8ef6-626c" type="rule"/>
