              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The general rides a horse and has a hand weapon and light armour. Army General. May have heavy armour (+1), composite bow (+4) and thrusting spear (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="fc2f-6759-2af2-9de9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="3895-4269-f202-5695" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="7284-b9f1-3d0c-f4b9" type="atLeast"/>
