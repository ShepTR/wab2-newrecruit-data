            <profile id="3459-c627-959f-d7de" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Has a hand weapon, light armour and shield. Army General. May have heavy armour (+1), throwing or thrusting spear (+2), javelins (+1) or two-handed axe (+3). May ride a horse (+9), or count as Riding Horses (+1). Thegns and Fyrd ignore Warband rule 1 while within 12” of the army general.</characteristic>
              </characteristics>
            </profile>
            <profile id="e008-00c1-6778-8acc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
