                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="bc66-93d9-37bb-1a91" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="9540-347e-0095-e270" type="lessThan"/>
                <condition field="selections" scope="bc66-93d9-37bb-1a91" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e097-81cb-f3c1-fc2d" type="atLeast"/>
                </conditions>
              </modifier>
