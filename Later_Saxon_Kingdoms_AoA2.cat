            <profile id="ed1e-18fc-92a1-f2ea" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A huscarl has a hand weapon, light armour and shield. Shieldwall. Stubborn. May have heavy armour (+1), thrusting spear (+2), two-handed axe (+3) and javelins (+1). May be Veteran (+1). If any huscarls are used, Thegns and Fyrd cost +2 points and are no longer Warband. Saxon Combined Units: Huscarl units can be split up to create Combined Units with Thegn or Fyrd. Huscarl form the front rank, or if combining Thegns and Fyrd the Thegns. Units of Huscarls and thegns that do not combine with Fyrd may be riding horses (+1 point) Saxon infantry often advanced aggressively and their shieldwalls were by no means passive. A Saxon unit that has formed Shieldwall may advance up to its normal move distance and retain the benefit of the Shieldwall. It may also do so when it charges, so long as it does not move further than its normal move distance while doing so.</characteristic>
              </characteristics>
            </profile>
            <profile id="aff0-60a4-16d4-36db" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="ac9d-254c-ee79-411a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b27f-d0e5-92bb-a0ca" type="atLeast"/>
                <condition field="selections" scope="ac9d-254c-ee79-411a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f204-f239-3c43-d862" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="ac9d-254c-ee79-411a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b27f-d0e5-92bb-a0ca" type="lessThan"/>
                <condition field="selections" scope="ac9d-254c-ee79-411a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f204-f239-3c43-d862" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="ac9d-254c-ee79-411a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b27f-d0e5-92bb-a0ca" type="atLeast"/>
                <condition field="selections" scope="ac9d-254c-ee79-411a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f204-f239-3c43-d862" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
