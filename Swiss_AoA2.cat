            </profile>
            <profile id="b2a2-a391-2067-284d" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Pikemen have hand weapon and pike. Stubborn. Medieval Phalanx. They may have light armour (+2) or heavy armour (+3). Veteran (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="147b-1468-adc4-c558" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="8e44-eb54-2437-4c85" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6912-213f-15b2-2ed8" type="atLeast"/>
