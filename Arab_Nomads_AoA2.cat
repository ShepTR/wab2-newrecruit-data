            <rule id="dce8-938c-9625-187e" name="Short bow" hidden="false">
              <description>&lt;characteristic name="Text" typeId="63ac-8f60-d28a-2232"&gt;Hand weapon, short bow and javelins. May be mounted on a camel with a bodyguard with hand weapon and short bow (+12 points).</description>
            </rule>
          </rules>
          <costs>
                <cost name="pts" typeId="points" value="12"/>
              </costs>
            </selectionEntry>
