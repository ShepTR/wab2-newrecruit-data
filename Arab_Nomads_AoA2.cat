          </constraints>
          <profiles>
            <profile id="bd5d-c826-a1a3-89ec" name="Chieftain" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">5</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">5</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">5</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">4</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">4</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">3</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">6</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">3</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">None</characteristic>
              </characteristics>
            </profile>
            <profile id="3a6a-a1dc-4f3a-b0b3" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, short bow and javelins. May be mounted on a camel with a bodyguard with hand weapon and short bow (+12 points). Army General. Camel Mounted. Camel Mounted:. When a character is camel mounted, the model has1more attack than the character alone and counts as two figures for unit strength purposes. If the character is equipped with a missile weapon, the model shoots like a normal camel archer model, but using his weapon skill; otherwise it has only one shot. The model may receive one wound without penalty, but when it receives a second wound, the camel dies and the character suffers one wound in “dismounting”. He can then continue on foot.</characteristic>
              </characteristics>
            </profile>
            <profile id="90f1-20c0-b1f8-40ae" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="602e-d108-15f1-9b5d" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
            <infoLink id="bb4a-3e37-2f43-b32b" name="Armies of Antiquity v2 Common Rules" hidden="false" targetId="a162-a096-ebb0-3296" type="rule"/>
            <infoLink id="2e20-48a8-cf92-3df0" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="03ef-d86a-84d0-2c3c" name="Short Bow" hidden="false" targetId="c963-937b-87a2-24f9" type="profile"/>
            <infoLink id="8124-0eba-7f59-e367" name="Javelin" hidden="false" targetId="10ef-3567-0d3f-d9e7" type="profile"/>
            <infoLink id="3b1c-eb9e-c1ef-82a6" name="Arab Nomads (AoA2) - List Notes" hidden="false" targetId="6b66-1f84-7365-9fc7" type="rule"/>
          </infoLinks>
