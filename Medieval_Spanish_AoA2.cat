                <condition field="selections" scope="4c16-b244-3046-d4db" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="98fa-ed4e-0b05-7502" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="e58f-549a-d6a0-19e3" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mounted Knights ride warhorses and have a hand weapon, partial plate armour, lance and shield. Shock Cavalry. First Charge. May have cloth barding (+3) or barding (+4). Every third unit may be upgraded to Military Order Knights (+4). Military Order Knights are Stubborn, Veteran and subject to Warband rules#1 and 3.</characteristic>
              </characteristics>
            </profile>
            <profile id="dc77-f6d9-5ea3-c4f2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="4c16-b244-3046-d4db" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5f38-887b-2e8a-b583" type="atLeast"/>
                <condition field="selections" scope="4c16-b244-3046-d4db" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="98fa-ed4e-0b05-7502" type="lessThan"/>
