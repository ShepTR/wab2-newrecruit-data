            <profile id="3eb0-52c5-e1c4-cc72" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mesnadas have hand weapon, light armour and buckler. May replace buckler with either thrusting spear and shield (+3), halberd (+2), composite bow (+2) or crossbow (+4). Light Infantry if equipped with composite bow or crossbow.</characteristic>
              </characteristics>
            </profile>
            <profile id="f733-9af1-f6cb-d76b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">5+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="9d44-919d-ab51-7c82" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="55da-ce76-2b17-581c" type="atLeast"/>
