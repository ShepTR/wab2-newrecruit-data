            </profile>
            <profile id="0768-daed-8524-6392" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour and large shield. May ride a horse (+11) or a camel (+8) in which case exchanges large shield for throwing spear and shield. Army General. Odenathus may alternatively have cataphract armour and kontos and ride a barded horse (+22) as a Cataphract.</characteristic>
              </characteristics>
            </profile>
            <profile id="04db-7a8f-4d06-7340" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="55b8-894b-05db-b9a7" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="9789-9449-d073-f978" type="atLeast"/>
                </conditions>
              </modifier>
