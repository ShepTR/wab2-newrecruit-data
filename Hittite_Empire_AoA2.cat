              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Vassal Kings: hand weapon, light armour, thrusting spear, bow, javelins and shield. Rides in a chariot (cost included). A Vassal King acts as Army General for all troops of his nationality, being Hurrian, Syrian, Phoenician or Lukka. They take a panic test upon his death, but do not test if the Hittite C-in-C dies.</characteristic>
              </characteristics>
            </profile>
            <profile id="59ca-5442-d6ae-016b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
