                <conditions>
                <condition field="selections" scope="8e76-aa87-d0e2-b2aa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="46b4-78d2-dc3f-be8d" type="lessThan"/>
