                <conditions>
                <condition field="selections" scope="1caf-14a7-c1f6-c6fe" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ffb0-730e-9770-287d" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="fd7a-1f81-c493-dc47" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and a bow. May have throwing spear (+1 pt), javelins (+1 pt) and a shield (+2 pts). Skirmishers, Nomad Cavalry. From the late 8th Century and onwards, Turkish light cavalrymen were an indispensable part of many Muslim armies. In Later Abbasid armies at least two units of Turcoman Cavalry must be taken if Turkish Ghulams are chosen (not enforced). (Byzantium p.84)</characteristic>
              </characteristics>
            </profile>
            <profile id="2a11-245a-f46c-4211" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="1caf-14a7-c1f6-c6fe" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ffb0-730e-9770-287d" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
