            <profile id="5247-a5da-a16b-e132" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour and bow. May have a throwing spear (+1 pt), and either buckler (+1 pt) or shield (+2 pts). Horses may have half-barding (+2 pts), or barding (+4 pts). Superior Persian Cavalry. Cavalry from the Khurasan region of Persia were instrumental in the rise of the Abbasid caliphate. (Byzantium p.84)</characteristic>
              </characteristics>
            </profile>
            <profile id="a744-49ce-3c79-c271" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="4+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="1948-a3d7-9a33-0dd6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d399-863f-6571-f798" type="atLeast"/>
