            <profile id="0202-12b2-9c4f-532a" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, Kontarion and shield. Armenians may have heavy armour (+1 pt). Superior Byzantine Cavalry. 0-1 units. Armenians were famous for their martial skills throughout Byzantium and the Middle East - they served in the Imperial Tagmata and the personal armies of the Muslim khalifas and amirs. (Byzantium p.82)</characteristic>
              </characteristics>
            </profile>
            <profile id="0e31-ef80-6ec6-6d95" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="ec1e-b939-ae5b-5b92" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="beb8-5c35-1247-7ce9" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="25be-0ff0-a1d8-4557" name="Superior Byzantine Cavalry" hidden="false" targetId="d81e-b4ce-ed5b-0f8a" type="rule"/>
            <infoLink id="dd7b-5e49-2308-7323" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
