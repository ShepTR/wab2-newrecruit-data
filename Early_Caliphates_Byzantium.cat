          <profiles>
            <profile id="188d-483a-233d-6244" name="Turcoman" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
