        <selectionEntry id="46d6-8e92-0cc0-86d3" name="City Militia Skirmisher" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d0b7-6ca1-c297-053f" type="min"/>
          </constraints>
          <profiles>
            <profile id="e28f-3c64-cf70-679b" name="City Militia Skirmisher" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">2</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">6+</characteristic>
              </characteristics>
            </profile>
            <profile id="7e49-20bc-92b6-1b4e" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, buckler &amp; sling or javelins. May exchange sling or javelins for short bow (+1 pt), bow (+2 pts), and exchange buckler for shield (free). May be Riding Camels (+1 pt). Solenarion Option: in Abbasid, Hamdanid and Fatimid armies, two units may replace sling or javelins with Solenarion (+3 pts). City Militia are Skirmishers. Arab Conquest: City Militia Skirmishers may only take short bows. Aghlabid City Militia skirmishers have Feigned Flight. Naffatun may be added (one per unit; two in Early Fatimid armies). (Byzantium p.83)</characteristic>
              </characteristics>
            </profile>
            <profile id="f345-4e3f-7b0b-7108" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="bbb5-408c-3dba-de8c" name="Skirmishers (Byzantium)" hidden="false" targetId="ce4b-42b1-6eb6-6e51" type="rule"/>
            <infoLink id="07ce-7cdc-ac6a-e6a0" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="1485-c1bc-a564-9554" name="Buckler" hidden="false" targetId="aa05-2e85-a1d8-8d69" type="profile">
