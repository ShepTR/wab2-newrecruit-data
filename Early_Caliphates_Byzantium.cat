            </profile>
            <profile id="0b03-27b1-eb0f-e707" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, Kontarion and shield. Superior Byzantine Cavalry. Combined Formation - up to half of any unit of Greek Heavy Cavalry may exchange Kontarion for bow (free) - archers are placed in the rear ranks (not enforced). Aghlabid armies use Greek Heavy Cavalry and Italo-Lombard converts as their Ghulams (the Italo-Lombard troops are documented only). (Byzantium p.82)</characteristic>
              </characteristics>
            </profile>
            <profile id="f3a8-6364-605d-4fa8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="30f6-fd2e-8706-1dde" name="Superior Byzantine Cavalry" hidden="false" targetId="d81e-b4ce-ed5b-0f8a" type="rule"/>
