            </profile>
            <profile id="a7f1-0ac7-7d9c-900f" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and javelins. May have throwing spear (+1 pt), and either shield (+1 pt), or large shield (+2 pts). May exchange javelins for short bow (free), or bow (+1 pt). Special Rule: cause fear in enemy cavalry. Camels were as poor in combat as they were excellent while on the march. (Byzantium p.83)</characteristic>
              </characteristics>
            </profile>
            <profile id="7302-f695-2112-5957" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="f880-578a-c8ee-dc7f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3b1e-b8e3-bc71-ea0c" type="atLeast"/>
