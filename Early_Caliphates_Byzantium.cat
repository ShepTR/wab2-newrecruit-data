              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="5+">
                <conditions>
                <condition field="selections" scope="1ba2-7cbf-18a8-97b5" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bdee-aa84-3c90-f763" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="e33b-b0d0-c04f-7692" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mixed weapons (counts as a hand weapon &amp; javelins) and shield. May have throwing spear instead of javelins (+1 pt). City Militia may have large shield instead of shield (+1 pt). Any unit may be Riding Camels (+1 pt). Combined Formation - in Umayyad, Abbasid, Aghlabid and Fatimid armies, up to half the models may exchange mixed weapons for bow (free) - archers are placed in the rear ranks and may take no further equipment. In Tulunid, Ikhshidid and Early Fatimid armies the 'Abid infantry use the City Militia profiles. Aghlabid City Militia may not use the Leadership value of the Army General. (Byzantium p.83)</characteristic>
              </characteristics>
            </profile>
            <profile id="2ae8-6e26-5819-23be" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="1ba2-7cbf-18a8-97b5" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bdee-aa84-3c90-f763" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
