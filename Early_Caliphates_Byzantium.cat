            </profile>
            <profile id="9417-fb24-8ab7-37f5" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, shield, light armour &amp; bow. May have heavy armour (+1 pt), and either thrusting spear (free) or Kontarion (+1 pt). Dismounted Ghulams Option: may dismount (-12 pts, Movement 4), and may be Riding Horses (+1 pt). Mounted Ghulams are Superior Turkish Cavalry. In Junior Ghulam regiments, only the officer leading the Ghulams swore allegiance to their employer. In Later Abbasid armies, if Turkish Ghulams are chosen, at least two units of Turcoman Cavalry must be taken as well (not enforced). (Byzantium p.82)</characteristic>
              </characteristics>
            </profile>
            <profile id="59ec-6a58-b7c5-a279" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="08a2-3bf9-6d54-c6fa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ca13-c9b6-9319-dc01" type="atLeast"/>
