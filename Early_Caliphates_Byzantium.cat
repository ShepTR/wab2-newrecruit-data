              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="3+">
                <conditions>
                <condition field="selections" scope="04ad-c066-143f-58ce" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4840-fded-2b0e-3ff6" type="atLeast"/>
                </conditions>
