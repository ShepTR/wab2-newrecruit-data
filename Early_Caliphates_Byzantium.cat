                <condition field="selections" scope="1948-a3d7-9a33-0dd6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="37b5-5228-764d-75d9" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="1948-a3d7-9a33-0dd6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d399-863f-6571-f798" type="lessThan"/>
