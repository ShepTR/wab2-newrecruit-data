                <conditions>
                <condition field="selections" scope="04ad-c066-143f-58ce" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4840-fded-2b0e-3ff6" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="3818-e8c9-7f00-3ab9" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hamdanid Heavy Cavalry cost 23 pts, have WS4 and count as Superior Arab Cavalry (Regular Heavy Cavalry otherwise: hand weapon, light armour and shield). Hamdanid Heavy Cavalry may have heavy armour (+1 pt) and Kontarion (+1 pt). Hamdanids used their cavalry much like the Byzantines they faced. Later Abbasid armies may also choose two units (shown in Cavalry here, the book lists them in Special Units). (Byzantium p.81)</characteristic>
              </characteristics>
            </profile>
            <profile id="0f2e-1cd5-c074-526a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="04ad-c066-143f-58ce" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4840-fded-2b0e-3ff6" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
