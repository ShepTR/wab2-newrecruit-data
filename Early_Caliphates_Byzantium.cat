            <profile id="f4a7-58d9-e54c-62f7" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, shield and bow. May have throwing or thrusting spear (+1 pt) and light armour (+3 pts). Light Cavalry. Parthian Shot. May only be used in Abbasid and Aghlabid armies. 0-2 units (Aghlabids: one unit). In the late 8th Century, a considerable Ephthalite force was employed by the Abbasids - not unlike the later Ghulams. (Byzantium p.83)</characteristic>
              </characteristics>
            </profile>
            <profile id="ceb2-3863-0bb8-c825" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="b041-2dad-a644-961d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b85f-265e-7b5d-59cd" type="atLeast"/>
