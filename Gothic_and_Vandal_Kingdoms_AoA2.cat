            <profile id="3a76-dc37-ba9e-f91b" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A Noble has a hand weapon, light armour, throwing or thrusting spear and shield. May ride a horse (+9) or warhorse (+16) and these may be barded (+4). If mounted he may have heavy armour (+1) and may exchange thrusting spear and shield for kontos and buckler (free). If on foot he may be Riding Horses (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="8127-4ffe-886d-69d7" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
