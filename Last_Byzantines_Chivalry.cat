            <profile id="337b-1d74-811d-40c8" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, thrusting spear, light armour, and shield. May have heavy armour (+1 pt), lance (+4 pts), and either half-barding (+4 pts) or plate barding (+6 pts). Mounted Kavallarioi with heavy armour are Eastern Shock Cavalry, except Kavallarioi with lances who may count their rank bonus up to a maximum of +1. Mounted Kavallarioi without heavy armour are Open Order. If Elite Pronoiarios or Guards are chosen, at least one unit of Regular Pronoiarios must be chosen as well. 0-1 unit (mounted or dismounted). (Armies of Chivalry p.55)</characteristic>
              </characteristics>
            </profile>
            <profile id="b5bf-35f4-41e7-6505" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="5baf-6b80-4239-81ae" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="479d-619f-97c9-5da4" type="atLeast"/>
