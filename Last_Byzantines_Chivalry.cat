            <profile id="2373-5e95-a273-effb" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">As Alans, use the Tartar Warrior profile in the Armies of Medieval Russia list: hand weapon and bow; thrusting spear (+2 pts), light armour (+2 pts) and shield (+2 pts). May be Open Order or Skirmishers. 0-2 units. Palaeologan armies (may be Permanent Mercenaries). (Armies of Chivalry p.55)</characteristic>
              </characteristics>
            </profile>
            <profile id="b246-aba5-38ba-934b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="b27d-93ea-1abb-0dc8" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bf71-90c6-f9e8-12ec" type="atLeast"/>
