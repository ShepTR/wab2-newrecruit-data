            </profile>
            <profile id="1ec5-4150-d84a-0048" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, shield and a crossbow. May have light armour (+1 pt). Mixed Order with Latinikoi Spearmen; Open Order when not in Mixed Order. May only be taken if Latinikoi Knights are taken as well. (Armies of Chivalry p.55)</characteristic>
              </characteristics>
            </profile>
            <profile id="4000-516f-692f-089e" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="7e0b-2986-70dd-5f1d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3dbe-728d-4248-a845" type="atLeast"/>
                </conditions>
