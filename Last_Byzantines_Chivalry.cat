            <profile id="c94b-3b5f-8f72-a3ca" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">To represent Balkan Cavalry, 0-3 units of Cumans, Serbians (see Kingdom of Hungary list) and/or Wallachians (see Moldavian/Wallachian list) may be chosen. The Serbian profile is used here (horse, lance and shield; light armour +3 pts). Trapezuntine, Morean and Epirote armies (may be Permanent Mercenaries). (Armies of Chivalry p.55)</characteristic>
              </characteristics>
            </profile>
            <profile id="0bbc-cd80-68b3-e8d2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="156a-60cf-d3ca-a71f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c602-1f14-153e-9c98" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
