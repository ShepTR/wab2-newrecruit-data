            <profile id="2a98-a634-6a94-8125" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Every other Elite Pronoiarios unit may fight on foot (-11 pts, reduce Movement to 4). Hand weapon, thrusting spear, light armour, and shield, and may have heavy armour (+1 pt). (Armies of Chivalry p.55)</characteristic>
              </characteristics>
            </profile>
            <profile id="ac05-10e9-cb3f-8afa" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="d977-d5c4-86f9-653a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="157f-2b15-ba09-aed5" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="cc94-a4e7-d930-55ce" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
