              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Knife, javelins, buckler. Light Cavalry, Feigned Flight, Parthian Shot. (Hannibal p.24)</characteristic>
              </characteristics>
            </profile>
            <profile id="3f11-6b5e-3dc2-ded6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">5+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="0adb-fcae-b203-d469" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5504-5bdb-55ee-8c85" type="atLeast"/>
