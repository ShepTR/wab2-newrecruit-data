              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword and large shield. Hate Romans: apply Hatred rules 2 and 3 (WAB rulebook p.52) when fighting Republican Roman armies. (Hannibal p.25)</characteristic>
              </characteristics>
            </profile>
            <profile id="c360-af82-91e5-6340" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="eef2-0ce6-1809-32b4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ba32-85bf-6665-7b33" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
