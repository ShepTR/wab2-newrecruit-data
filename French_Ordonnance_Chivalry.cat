            </profile>
            <profile id="81ba-a96e-f2f4-97c0" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, full plate armour, lance and warhorse. The warhorse may have cloth barding (+4 pts), or plate barding (+6 pts). First Charge. Combined Formation; when mounted may include Coustilliers. May be Veteran (+3 pts). Mounted Gendarmes gain up to a +1 Rank Bonus if supported by Coustilliers. Every second unit of Ordonnance Gendarmes may be upgraded to WS5 (+3 pts). For every Ordonnance Gendarme model there must be one Coustillier model and at least one Ordonnance Longbowman model (not enforced). (Armies of Chivalry p.58)</characteristic>
              </characteristics>
            </profile>
            <profile id="bf91-d7ca-fc3e-c78f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="248c-4024-7857-4894" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9fff-5f39-7628-197c" type="atLeast"/>
                <condition field="selections" scope="248c-4024-7857-4894" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4637-ce48-8c64-bbf0" type="lessThan"/>
