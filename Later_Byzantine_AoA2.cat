                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">4+</characteristic>
              </characteristics>
            </profile>
            <profile id="7d29-0fa7-9dd3-f89b" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Cavalry have hand weapon, light armour, thrusting spear and shield. Regulars are also Eastern Shock Cavalry. Cavalry units may use Combined Formation with up to half their models exchanging thrusting spear for composite bow (-1) and forming the rear ranks. Such models may not have heavy armour. Cavalry units may instead be designated as Light Cavalry (free). Such units may not use Combined Formation or take heavy armour. This option is available to every second unit, excluding guards and Turkopoloi.</characteristic>
              </characteristics>
            </profile>
            <profile id="e028-dcf2-969b-f052" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="0b0e-3058-63c7-113f" name="Eastern Shock Cavalry" hidden="false" targetId="b932-617b-b343-5f35" type="rule"/>
            <infoLink id="36ee-8bcf-831a-1287" name="Shock Cavalry" hidden="false" targetId="71de-f405-b88b-44fe" type="rule"/>
            <infoLink id="110d-a1b9-3ed5-c852" name="Combined Formations" hidden="false" targetId="e22b-5445-d10a-9d89" type="rule"/>
            <infoLink id="7205-faf4-f666-9aa6" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="4d3e-f0cf-c6e9-240a" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
