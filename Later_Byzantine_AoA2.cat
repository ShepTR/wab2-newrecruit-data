            <profile id="96de-fb78-c8ab-2432" name="Mounted crossbowmen" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">2</characteristic>
