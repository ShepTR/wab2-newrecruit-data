            <profile id="cb77-1ba4-f992-92ea" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Has horse, hand weapon and light armour. May ride a warhorse (+7).</characteristic>
