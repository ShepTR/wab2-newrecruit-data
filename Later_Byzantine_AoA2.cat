            <profile id="de63-b37d-d847-cd0d" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Has horse, hand weapon and light armour. May ride a warhorse (+7). The Standard Bearer may have heavy armour (+1), shield (+1), and half-barding (+2) or barding (+4). Other characters may have heavy armour (+1), composite bow (+4), thrusting spear (+3), lance (+6), and half-barding (+2) or barding (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="0235-2520-bbf5-97a4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
