            <profile id="5b5b-96e5-3275-39c2" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A Leader has a hand weapon, light armour, thrusting spear and large shield. May ride a horse (+8) or a warhorse (+15) in which case exchanges large shield for shield. If mounted may have half barding (+2).</characteristic>
              </characteristics>
            </profile>
