            <infoLink id="3e4a-ed0f-3ab0-7ca4" name="Republican Rome (AoA2) - List Notes" hidden="false" targetId="ff50-7f38-5785-8e26" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="109"/>
