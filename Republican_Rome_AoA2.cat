            </profile>
            <profile id="fc38-1952-dd24-251a" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Velites have hand weapon, javelins and shield. They may have throwing spears (+3), and are Skirmishers. They cannot be used with Leves, and begin to appear during the early part of the second Punic war. Both they and the Italian spearmen have a hand weapon, throwing spear and shield, and may have light armour (+2) and large shield (+1). They are Open Order.</characteristic>
              </characteristics>
            </profile>
            <profile id="6979-b6db-b1df-ed50" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="eb4b-f4d3-1ca2-ab84" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bbda-5773-f265-e0ac" type="atLeast"/>
                <condition field="selections" scope="eb4b-f4d3-1ca2-ab84" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3d3d-f2ff-080c-1ce0" type="lessThan"/>
