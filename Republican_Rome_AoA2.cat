                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">4+</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
              </modifier>
              </modifiers>
            </profile>
            <profile id="d40b-caf7-745d-9734" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A standard bearer has a hand weapon, light armour and large shield. May ride a 6” horse (+6, M6) in which case exchange large shield for shield. Army Standard Bearer.</characteristic>
              </characteristics>
            </profile>
            <profile id="2134-406a-1f23-d501" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="39cd-c5c4-bbfa-c6a9" name="Army Standard" hidden="false" targetId="41fc-5de5-0862-91b8" type="rule"/>
            <infoLink id="ed1f-77fb-a84c-ae8e" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="b8e1-f357-a14b-c1c7" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
