            </profile>
            <profile id="1e20-5617-1437-7c69" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Triarii have hand weapon, thrusting spear and large shield. They may have light armour (+2) and are Drilled and Stubborn. Legionary maniples may interpenetrate each other without penalty, except when charging. For clarity - a unit may advance or retire through a legionary unit so long as it does not charge. A unit can disengage and retire behind a fresh unit, for example. Both they and the Italian spearmen have a hand weapon, throwing spear and shield, and may have light armour (+2) and large shield (+1). They are Open Order.</characteristic>
              </characteristics>
            </profile>
            <profile id="585f-6eac-4e63-f4b3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="ad3a-b22b-08cd-1b3f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a318-859b-f3dd-6543" type="atLeast"/>
                <condition field="selections" scope="ad3a-b22b-08cd-1b3f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5b0d-b3e2-64d5-7670" type="lessThan"/>
