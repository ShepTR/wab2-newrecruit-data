              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armati have hand weapon, halberd and light armour. May have heavy armour (+1). May replace halberd with thrusting spear and shield (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="1bd1-4009-3b18-656c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
