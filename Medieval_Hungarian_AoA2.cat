              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Crossbowmen have hand weapon, light armour and crossbow. May have pavise (+2) and exchange crossbow for handgun (free). Open Order if equipped with pavise, Light Infantry if not.</characteristic>
              </characteristics>
            </profile>
            <profile id="0438-fed3-d788-cccb" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="4+ with Pavise +2 when shot at from the front only">
                <conditions>
                <condition field="selections" scope="3ec2-4589-cf16-482b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="450d-542c-7f57-47be" type="atLeast"/>
                </conditions>
              </modifier>
