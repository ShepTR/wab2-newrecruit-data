            <profile id="1b60-7720-4bf2-ffc9" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The general rides a horse and has a hand weapon, heavy armour and composite bow. Army General. May have cataphract armour (+1), thrusting spear (+3) and barding (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="c9b8-f09a-14a8-2285" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
