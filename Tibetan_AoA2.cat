              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Light horse have a hand weapon and composite bow. Light Cavalry. Expert Horsemen. Feigned Flight. May have throwing spear (+3) and shield (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="9e05-ed23-c08c-0142" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
