              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Slaves have hand weapon, javelins and buckler. Warband. Levy. Stealth. The total number of slave warriors may not outnumber the Illyrian warriors in the army. Illyrian units ignore panic tests caused by slave warriors.</characteristic>
              </characteristics>
            </profile>
            <profile id="8316-ea04-7f3d-2bc2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">6+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
