              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, thrusting spear, javelins and shield. Army General. Warband. Stealth. May ride a horse (+12), in which case has Ld8 and heavy armour, but is no longer Warband.</characteristic>
              </characteristics>
            </profile>
            <profile id="313c-b4f0-9dff-0d49" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="7d80-a09e-1f62-8903" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="286c-78d6-f8c8-c416" type="atLeast"/>
