            <profile id="1b8c-19cb-11d2-d8f9" name="Equipment and options (as printed in WAB2 army list)" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, thrusting spear and large shield. May change equipment to sword, javelins, light armour and shield (+1 pt). Subject to Warband psychology rules 1 &amp; 2. A unit of spearmen armed with thrusting spears may include a proportion of archers (one archer for every three spearmen, 25%). Any number of units of spearmen. (Chariot Wars p.45)</characteristic>
              </characteristics>
            </profile>
            <profile id="1394-1cdb-30e5-84a2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="a345-99a5-708f-2259" name="Warband Psychology (rules 1 &amp; 2)" hidden="false" targetId="2370-1c8e-57c4-1fdf" type="rule"/>
            <infoLink id="d6a1-7af1-cd5e-b12e" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
