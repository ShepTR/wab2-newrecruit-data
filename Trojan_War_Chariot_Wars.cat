              </modifier>
              </modifiers>
            </profile>
            <profile id="c0e0-827f-e681-62d7" name="Equipment and options (as printed in WAB2 army list)" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, thrusting spear and heavy armour. May change equipment to sword, javelins, light armour and shield. May ride in a chariot bought at an additional cost from this army list. Army General. Legendary Warrior: the General is the foremost hero in the army and benefits from the Legendary Warriors rule. 0-1 General (King or Lawageta). (Chariot Wars p.44)</characteristic>
              </characteristics>
            </profile>
            <profile id="8921-31e0-34eb-639c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="9fce-e4de-e12b-f6dc" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="6a01-4454-3e73-04ef" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
