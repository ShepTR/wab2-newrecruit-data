                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
              </characteristics>
            </profile>
            <profile id="1e40-6e18-2cbd-48d9" name="Equipment and options (as printed in WAB2 army list)" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and composite bow. Light Infantry. Archers may be mixed into a unit of spearmen armed with thrusting spears in a ratio of one archer for every three spearmen (25%) and count as part of the spearmen unit; placed randomly among the spearmen but shoot from the front of the unit; cannot be picked out as targets and all count as shielded against missiles and in hand-to-hand combat. If included within a unit of spearmen, the archers become subject to Warband psychology rules 1 &amp; 2. (Chariot Wars p.45)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="bcba-6993-8bff-9703" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="4f34-895e-be2f-d6d2" name="Bow" hidden="false" targetId="5d29-ba1e-8299-8085" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="4"/>
          </costs>
        </selectionEntry>
