              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelins and shield. May have light armour +3. Subject to Warband psychology rules 1 &amp; 2. (Chariot Wars p.46)</characteristic>
              </characteristics>
