            </profile>
            <profile id="30d5-4d77-01a8-9513" name="Equipment and options (as printed in WAB2 army list)" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The "poor bloody infantry" of a Roman army. Large shield, sword and throwing spear. May have light armour (+2), javelins and darts (+2), heavy throwing spear instead of throwing spear (+1). May be drilled (+1 pt). Can form shield wall. Archers would normally be deployed at the rear of the unit. One soldier in four may replace the throwing spear and shield with a bow (+1 pt) but may not take other weapon options except light armour (not modelled: all models of a unit are equipped alike). Skirmishers replace their equipment with shield, hand weapon, javelins and darts and may take no other options. One unit may skirmish. (Fall of the West p.46)</characteristic>
              </characteristics>
            </profile>
            <profile id="75c1-66e5-f197-1110" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="c599-15d0-e384-c910" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="56c2-f28c-6843-d8aa" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
