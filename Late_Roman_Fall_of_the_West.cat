              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="b09d-ebea-dd3b-39ce" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0b8d-2862-0b8e-0dfc" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="b5db-7ccc-1c69-ec81" name="Equipment and options (as printed in WAB2 army list)" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Originally the Emperor's personal force. Large shield, sword and throwing spear. May have light armour (+2), javelins and darts (+2), heavy throwing spear instead of throwing spear (+1). May be drilled (+1 pt). Can form shield wall. Archers would normally be deployed at the rear of the unit. One soldier in four may replace the throwing spear and shield with a bow (+1 pt) but may not take other weapon options except light armour (not modelled: all models of a unit are equipped alike). Skirmishers replace their equipment with shield, hand weapon, javelins and darts and may take no other options. Any unit may skirmish. Not found in Limitanei armies. (Fall of the West p.46)</characteristic>
              </characteristics>
            </profile>
            <profile id="7a01-752c-188c-c1f3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="b09d-ebea-dd3b-39ce" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0b8d-2862-0b8e-0dfc" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
