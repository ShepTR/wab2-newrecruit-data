            <profile id="f4ae-954a-cecb-612c" name="Equipment and options (as printed in WAB2 army list)" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Includes Cataphractii and Clibanarii. Heavy armour, sword, kontos. May have shield (+1) and barding (+4, -1 Movement). One unit may replace kontos with bow (+1). Drilled. 0-2 units. (Fall of the West p.47)</characteristic>
              </characteristics>
            </profile>
            <profile id="f885-7230-2673-c6e5" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
