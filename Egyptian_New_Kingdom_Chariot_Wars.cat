              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword and buckler. May have light armour +3 and javelins +2. Stubborn. 0-1 unit. (Chariot Wars p.16)</characteristic>
              </characteristics>
            </profile>
            <profile id="1556-9ea3-56ed-6afc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">6+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="9132-934f-76a5-e877" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8ddf-021d-8ba2-0da9" type="atLeast"/>
