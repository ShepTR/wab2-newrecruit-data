              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and light armour. Shield +2. Rides in a chariot bought at additional cost from this list. Army Standard. 0-1. (Chariot Wars p.14)</characteristic>
              </characteristics>
