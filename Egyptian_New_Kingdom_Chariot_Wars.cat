              <modifier type="set" field="5882-dd5a-bc28-4024" value="5+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="9132-934f-76a5-e877" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8ddf-021d-8ba2-0da9" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
