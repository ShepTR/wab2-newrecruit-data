            <profile id="3ba6-5798-dabe-add2" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">See the entry for Mounted Crusader Knights in the Teutonic Order list (approximated here: hand weapon, heavy armour, shield, warhorse; lance +4, partial plate free, cloth barding +4). Allies &amp; Mercenaries. Western Knights may only be taken in the armies of the Western Russian States. 0-1 unit. (Armies of Chivalry p.49)</characteristic>
              </characteristics>
            </profile>
            <profile id="e6d5-790e-e9a5-39ea" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="3922-325b-de44-2df9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4bd8-6871-a5a2-e449" type="lessThan"/>
