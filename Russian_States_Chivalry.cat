            <profile id="7b73-b4ae-7536-d2db" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and bow. May have a thrusting spear (+2 pts), light armour (+2 pts) and a shield (+2 pts). May be Open Order or Skirmishers. Nomad Cavalry. Tartar Warriors may only be taken in the armies of the Eastern Russian States. At least one unit of Tartar Warriors must be taken for every unit of Tartar Nobles in the army. (Armies of Chivalry p.49)</characteristic>
              </characteristics>
            </profile>
            <profile id="cc19-70a1-25b2-146c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="c6e6-c5b3-5f77-711c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d427-edc8-bcc0-89b3" type="atLeast"/>
