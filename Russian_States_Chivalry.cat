            </profile>
            <profile id="4442-9d8c-36b5-7059" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, thrusting spear, heavy armour, shield and warhorse. May have a bow (+3 pts) and cloth barding (+4 pts). First Charge. Eastern Shock Cavalry. At least one unit of Junior Druzhniks must be taken if the army includes a unit of Senior Druzhniks. 0-1 unit. (Eastern Russian States.) (Armies of Chivalry p.48)</characteristic>
              </characteristics>
            </profile>
            <profile id="85fd-82c1-0eb4-d621" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="2d4a-3553-fc0e-9ffa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="861c-0dc1-34b1-3dcd" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="9cdc-f791-f596-e802" name="First Charge (Chivalry)" hidden="false" targetId="bd4c-eca0-b780-4ba5" type="rule"/>
            <infoLink id="99d9-ffb0-d65f-67c0" name="Eastern Shock Cavalry" hidden="false" targetId="b932-617b-b343-5f35" type="rule"/>
