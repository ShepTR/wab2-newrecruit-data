            <profile id="f04a-3e4c-bfe0-269c" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon or farm implements. May have dagger axe (+3). Light Infantry. Peasants: may only declare a charge if they have a leader or character in the unit; fear all other enemy troops except other peasants until an enemy unit is broken in close combat. (The Art of War p.14)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="dd72-511b-1343-1040" name="Peasants (Art of War)" hidden="false" targetId="bbe3-9e62-098c-b1be" type="rule"/>
