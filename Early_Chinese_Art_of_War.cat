                <condition field="selections" scope="5368-ec52-3421-6049" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7954-1c39-fd47-d2a8" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
