                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">4+</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="d350-b577-ebce-9baf" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e5b2-59e3-b9bb-64cc" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="d350-b577-ebce-9baf" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e5b2-59e3-b9bb-64cc" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="ac7a-10b6-0330-5464" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Qurubuti have hand weapons, light armour, throwing spear and large shield. Stubborn. Kisir Sharruti: one third of each unit armed with hand weapons, light armour, thrusting spear and shield and two thirds armed with hand weapon, light armour and bow (-1 point). May upgrade shield to large shield (+1 point). Combined Formation. Sab Sharri: one third of each unit armed with hand weapons, thrusting spear and shield and two thirds armed with hand weapon and bow (-1 point). May upgrade shield to large shield (+1 point). Light Infantry. Combined Formation. Chaldeans: one third of each unit armed with hand weapons, thrusting spear and large shield and two thirds armed with hand weapon, thrusting spear and bow. Alternatively, the whole unit may be armed in either fashion. Combined Formation.</characteristic>
              </characteristics>
            </profile>
            <profile id="67fa-cd98-1441-0cbf" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="fbcb-8289-1986-6c3b" name="Stubborn" hidden="false" targetId="ce73-f053-8ef6-626c" type="rule"/>
            <infoLink id="5e9c-4ac7-ce75-5e71" name="Combined Formations" hidden="false" targetId="e22b-5445-d10a-9d89" type="rule"/>
            <infoLink id="b843-9519-ff10-70de" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="ce8a-d27a-1c75-47f0" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
            <infoLink id="5e92-5538-faa9-458f" name="Large Shield" hidden="false" targetId="8367-11b2-7778-977f" type="profile"/>
            <infoLink id="5ab2-efea-b280-9180" name="Throwing Spear" hidden="false" targetId="cc82-90f9-0ade-c0e7" type="profile"/>
