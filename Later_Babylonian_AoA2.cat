              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with Hand weapon and sling or short bow. May exchange sling or short bow for javelin and buckler (free). Skirmishers.</characteristic>
              </characteristics>
            </profile>
            <profile id="a630-d9eb-796a-07d6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="02d4-68f7-17fa-65e2" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2715-049b-edcc-9076" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
