            <profile id="62bf-589f-a25e-db9e" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A standard bearer has a hand weapon, light armour and shield. Army Standard Bearer. May ride in a chariot bought at additional cost from the list, or on a 6” movement horse (+7), and in either case may have heavy armour (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="1a5c-ac96-e9ac-c76c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
