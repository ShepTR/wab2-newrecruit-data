            </profile>
            <profile id="3080-e886-17b5-ec63" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hereditary infantry and guildsmen have hand weapon, halberd and longbow. Up to half the figures in a unit may replace longbow with throwing spear, javelins and shield (+1). May upgrade shield to large shield (+1). All the above may use Combined Formation.</characteristic>
              </characteristics>
            </profile>
            <profile id="ed53-b250-e962-b59a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="80cd-9569-93c4-753e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d38b-9a39-ba66-982f" type="atLeast"/>
