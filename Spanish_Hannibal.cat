            <profile id="3af5-634d-6b80-1a70" name="Equipment and options (as printed in WAB2 army list)" publicationId="fc9f-8438-629b-e92d" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword and shield. Javelins or throwing spear +2; if on foot heavy throwing spear +3; light armour +3. May ride a horse (free). May be Army General (+25 pts). Stubborn. (Hannibal p.71)</characteristic>
              </characteristics>
            </profile>
            <profile id="95ed-c044-c2e0-e81d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
