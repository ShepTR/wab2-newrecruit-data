              </characteristics>
            </profile>
            <profile id="899d-5cf6-e991-2ce6" name="Equipment and options (as printed in WAB2 army list)" publicationId="fc9f-8438-629b-e92d" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelins, buckler. Skirmishers, Feigned Flight. An Iberian army may not have more than one unit of Caetrati per two units of Scutarii (unless none are used) and no Caetrati unit may outnumber the smallest Scutarii unit. In Celtiberian armies no Caetrati unit may outnumber the smallest Celtiberian unit; in Lusitanian armies one Lusitanian unit per two Caetrati units. (Hannibal p.72)</characteristic>
              </characteristics>
            </profile>
            <profile id="8ebf-13af-2770-0ca9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="5992-7014-2427-b7b3" name="Feigned Flight" hidden="false" targetId="23ce-0721-aa10-1f4d" type="rule"/>
            <infoLink id="1ad1-51a1-1e87-adb2" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
