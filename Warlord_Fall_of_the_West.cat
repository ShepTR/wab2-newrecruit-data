            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1cd2-b927-d028-ccdb" type="min"/>
          </constraints>
          <profiles>
            <profile id="0865-ceca-9fe6-b3dc" name="Veteran" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="734f-99c3-9bf6-8717" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="dd0b-f728-2e79-7cd4" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="7d4d-51f9-e488-8054" name="Equipment and options (as printed in WAB2 army list)" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Years of successful battles; may have supplemented equipment with loot. Large shield, sword and throwing spear. May have light armour (+2), javelins and darts (+2), heavy throwing spear instead of throwing spear (+1). May be drilled (+1 pt). Can form shield wall. Archers would normally be deployed at the rear of the unit. One soldier in four may replace the throwing spear and shield with a bow (+1 pt) but may not take other weapon options except light armour (not modelled: all models of a unit are equipped alike). Skirmishers replace their equipment with shield, hand weapon, javelins and darts and may take no other options. Any unit may skirmish. (Fall of the West p.46)</characteristic>
              </characteristics>
            </profile>
            <profile id="a433-db76-d74e-54a4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="734f-99c3-9bf6-8717" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="dd0b-f728-2e79-7cd4" type="atLeast"/>
                </conditions>
              </modifier>
                <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                  <conditions>
                    <condition field="selections" scope="734f-99c3-9bf6-8717" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="78f2-a0e8-0f41-6319" type="atLeast"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
