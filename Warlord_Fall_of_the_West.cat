            <profile id="ea0c-6091-1361-6003" name="Equipment and options (as printed in WAB2 army list)" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Includes Huns and Alans. Sword and bow. May have shield (+1), throwing spear (+1) and lassoes (+1). Light Cavalry. Nomad cavalry. Normally restricted to Central and Eastern barbarian armies. (Fall of the West p.48)</characteristic>
              </characteristics>
            </profile>
            <profile id="ed7a-4e48-73e2-4cbc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="8b90-f595-c23b-4c9c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b6a9-11f0-af97-64f0" type="atLeast"/>
