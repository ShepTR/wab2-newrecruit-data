              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">5</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">2</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">2</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">6</characteristic>
              </characteristics>
            </profile>
            <profile id="1836-c86d-f6af-e56b" name="Equipment and options (as printed in WAB2 army list)" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons. No options. Any unit that includes a pagan priest hates all its enemies; a Catholic priest hates enemies who are pagans or Arian Christians; an Arian priest hates enemies who are pagans or Catholic Christians. If an army includes a priest his opponent must declare a religious alignment. Pagan or Roman Catholic priests may be attached to a Roman army; pagan or Arian Christian priests to a Barbarian army. 0-1. (Fall of the West p.45)</characteristic>
              </characteristics>
            </profile>
            <profile id="11a7-134c-f4a8-ce34" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="30e6-609c-09b1-c977" name="Priest (Fall of the West)" hidden="false" targetId="2e5c-aa07-52a2-c8ca" type="rule"/>
            <infoLink id="26a2-84e7-50cd-0857" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="8e3f-bbfe-392d-10b6" name="Warlord (Fall of the West) - List Notes" hidden="false" targetId="41e4-aa32-e7c0-f61a" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="75"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
