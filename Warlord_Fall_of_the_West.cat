            <profile id="6b49-5118-e352-f80c" name="Equipment and options (as printed in WAB2 army list)" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A barbarian chief's personal bodyguard. Light armour, shields and mixed weapons (swords, javelins, axes). May have heavy throwing spears (+3), heavy armour (+1, replaces light), bow (+3), kontos (+3), barding (+4, -1 Movement). Would normally be mounted (+10 pts, Movement 8). Must be led by the army general. (Fall of the West p.45)</characteristic>
              </characteristics>
            </profile>
            <profile id="00c9-fc36-4c84-ca6e" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="2287-164f-90f5-e993" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="2a88-16ec-3564-2b26" type="atLeast"/>
