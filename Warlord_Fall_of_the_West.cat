            <profile id="658a-3101-57e8-22c1" name="Equipment and options (as printed in WAB2 army list)" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelins and shield. Causes fear in enemy cavalry. Included for North African Moors. (Fall of the West p.48)</characteristic>
              </characteristics>
            </profile>
            <profile id="206a-e960-469a-8089" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="504a-93d5-e806-e88e" name="Camelry Fear (Fall of the West)" hidden="false" targetId="f514-6383-2718-838a" type="rule"/>
            <infoLink id="bb1a-1855-22cc-9d41" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="a7e9-a24a-c44f-1cc3" name="Javelin" hidden="false" targetId="10ef-3567-0d3f-d9e7" type="profile"/>
