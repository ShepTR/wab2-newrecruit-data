              </characteristics>
            </profile>
            <profile id="96ef-bf0a-5071-47b8" name="Equipment and options (as printed in WAB2 army list)" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Shields and mixed weapons (swords, javelins, axes). May replace mixed weapons with heavy throwing spear (eg angons or franciscas) +2. A warrior unit may be designated light infantry and may skirmish at no extra cost. Warband rules apply. If a character joins the unit or the army General is within 12" the unit may use either its own modified Ld or the character's/General's Ld; if the latter is used it is not modified by the unit's rank bonus. (Fall of the West p.48)</characteristic>
              </characteristics>
            </profile>
            <profile id="1bf1-d4c2-f2fa-02dd" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="fe12-217e-cd22-5078" name="Mixed Weapons (Fall of the West)" hidden="false" targetId="2a50-c575-d45e-dd54" type="rule"/>
