            <profile id="ea6a-af6d-17e5-7b89" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, thrusting spear, heavy armour and barding. May have bow (+3 pts), buckler (+1 pt). May count rank bonus of up to +1 even though cavalry. Designer's note: historically only an army that does not include any chariots, except those of the General or Army Standard Bearer, may have cataphracts. (Armies of Antiquity p.43)</characteristic>
              </characteristics>
            </profile>
            <profile id="90b9-1d95-878c-05e4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="3+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="0bde-c9aa-5f13-c51c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2444-e4c9-57bb-caf3" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="e2c1-391c-283c-69ce" name="Knights Rank Bonus" hidden="false" targetId="3f06-a726-c44a-7e59" type="rule"/>
