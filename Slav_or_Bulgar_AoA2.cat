              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A Voevodo has a hand weapon, light armour and buckler. May have shield (+1), throwing or thrusting spear (+2), javelins (+2) or composite bow (+4). May ride a horse (+9).</characteristic>
              </characteristics>
            </profile>
