          <profiles>
            <profile id="cbf0-8d32-f128-35a5" name="Bulgar Nobles" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">5+</characteristic>
              </characteristics>
            </profile>
            <profile id="1659-bf37-e62a-89d9" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Bulgar Nobles have a hand weapon, light armour, buckler and composite bow. Light Cavalry. Feigned Flight. Expert Horsemen. May have shield (+1), half barding (+2) and throwing or thrusting spear (+3). There must be at least one unit of horse archers if there are any Bulgar noble cavalry in the army. Bulgar elite and other horse archers have a hand weapon, buckler and composite bow. Nomad Cavalry. May have throwing or thrusting spear (+3). Slav Nobles may have light armour (+2). There must be at least one unit of Slav cavalry if any Slav Noble cavalry are taken. All Slav cavalry have a hand weapon, javelins and buckler. Skirmishers. Feigned Flight. May have shield (+1) and throwing spear (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="1b9c-e748-7ddb-786f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="d68d-46f6-07a7-45de" name="Feigned Flight" hidden="false" targetId="23ce-0721-aa10-1f4d" type="rule"/>
            <infoLink id="b9e6-57ad-244f-b1b1" name="Expert Horsemen" hidden="false" targetId="01f3-18f2-5b03-2aee" type="rule"/>
            <infoLink id="15bc-cbaf-4b54-f740" name="Nomad Cavalry" hidden="false" targetId="123d-07c6-8e8c-e8db" type="rule"/>
