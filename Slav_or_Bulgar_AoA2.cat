              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have Mixed Weapons and shield. Light Infantry, Warband. Every second unit of warriors may replace Mixed Weapons with hand weapon and throwing spear (+1) or composite bow (free).</characteristic>
              </characteristics>
            </profile>
            <profile id="10a6-11b1-e6ae-7cf4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
