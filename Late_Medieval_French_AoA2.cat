              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="c903-1827-b749-41c1" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e6ea-e651-4dd4-6d11" type="lessThan"/>
                </conditions>
