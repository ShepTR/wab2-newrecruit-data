              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="c903-1827-b749-41c1" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e6ea-e651-4dd4-6d11" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="4f84-d967-27d1-47a7" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Scots Guards have hand weapon, half and a hand sword (count as halberd), buckler, partial plate armour and longbow. Stubborn. Veteran. Riding Horses. Open Order. The unit may not exceed 12 models. Crossbowmen have hand weapon, light armor, crossbow. May take Pavise (+2).</characteristic>
              </characteristics>
            </profile>
            <profile id="b36d-9f2c-386f-2509" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">3+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="3+ with Pavise +2 when shot at from the front only; Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="c903-1827-b749-41c1" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e6ea-e651-4dd4-6d11" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="2a53-407e-ecfd-c15c" name="Stubborn" hidden="false" targetId="ce73-f053-8ef6-626c" type="rule"/>
            <infoLink id="9708-7bcb-8684-5dd1" name="Veteran" hidden="false" targetId="4c9b-509e-486d-f0af" type="rule"/>
            <infoLink id="33b8-f728-66f1-a733" name="Open Order" hidden="false" targetId="6b07-0a99-df48-7a76" type="rule"/>
            <infoLink id="8f38-5e90-ab32-1f96" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="4051-100c-83ec-90f3" name="Halberd" hidden="false" targetId="635a-1d79-5976-954c" type="profile"/>
