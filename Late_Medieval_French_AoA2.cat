            <profile id="24de-edfe-1555-7a51" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">You must have at least one Retainer and one Archer per Knight model. Mounted Knights have hand weapon, full plate armour and lance. They ride warhorses and may have barding (+4). Shock Cavalry. First Charge. Veteran. May be fielded as Feudal Horse (-2) and then have partial plate and Impetuous. May dismount (-27). If dismounted they have thrusting spear, riding horses, and may take two-handed weapon for (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="417d-1f24-1555-fbe8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="2+">
                <conditions>
                <condition field="selections" scope="f1ad-0175-755d-2120" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="eae5-46cc-14b9-93bd" type="atLeast"/>
                <condition field="selections" scope="f1ad-0175-755d-2120" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2977-4ba5-457e-8365" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="2+">
