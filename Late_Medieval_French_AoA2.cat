            </profile>
            <profile id="7d7f-a52a-3450-ef58" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">An artillery unit is made of one Cannon or Organ Gun and 3 crew. You may add up to 3 additional crew for +10 pts each. The crew have a hand weapon and may have light armour (+2). Please note the higher WS and Ld values of French crew to represent their training.</characteristic>
              </characteristics>
            </profile>
