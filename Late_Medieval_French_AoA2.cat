            <profile id="fc68-5506-8737-50b5" name="Retainer" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="995f-b6df-df7e-8724" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">You must have at least one Retainer and one Archer per Knight model. The number of Retainers may not exceed twice the number of Knights and the number of Archers may not exceed three times the number of Knights. Retainers have hand weapon, lance and partial plate armour. They ride horses. Retainers may form the rear rank(s) of Knight units. Such unit is a Combined Formation. May dismount for (-8). If dismounted they have thrusting spear and riding horses.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="5dd8-43c8-b7b1-3df7" name="Combined Formations" hidden="false" targetId="e22b-5445-d10a-9d89" type="rule"/>
            <infoLink id="3cb2-6b99-7335-42c2" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="28"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
