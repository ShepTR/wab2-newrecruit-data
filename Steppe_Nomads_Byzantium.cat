      <selectionEntries>
        <selectionEntry id="9cf5-d486-26fe-513c" name="Noble Commander" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="9c55-4217-0960-f7f9" type="min"/>
          </constraints>
          <profiles>
            <profile id="5b4f-8d81-3525-7ba6" name="Noble Commander" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">5</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">2</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">5</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">2</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
            </profile>
            <profile id="f6e7-2b1c-e22f-164a" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and bow. May choose from the equipment available to Noble Cavalry of the selected tribe (see the army composition notes). Noble Commanders must lead a unit of Nobles and may not leave voluntarily. (Early Khazar and Magyar armies may choose only an Army General and a War Banner Bearer.) (Byzantium p.59)</characteristic>
              </characteristics>
            </profile>
            <profile id="577f-2d2d-b5e0-975d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="9cf5-d486-26fe-513c" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="0050-55a5-1997-d1d1" type="atLeast"/>
