            <profile id="85fe-193e-e3df-0836" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and bow. Nobles also have light armour. May have javelins (+1 pt) and buckler (+1 pt). Alan Nobles may also have heavy armour (+2 pts), and either throwing spear (+1 pt) or kontos (+2 pts). Alan Tribesmen are Skirmishers and Nomad Cavalry. Alan Nobles with throwing spear or kontos are Superior Cavalry. 0-1 Nobles. (Byzantium p.60)</characteristic>
              </characteristics>
            </profile>
            <profile id="ae72-3e59-611e-dd79" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="b69c-988a-989e-1bdd" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5b2b-a01c-0b3d-dc83" type="atLeast"/>
