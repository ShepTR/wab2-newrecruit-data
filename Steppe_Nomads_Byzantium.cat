            <profile id="a99e-7c88-2717-1358" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and bow. May choose from the equipment available to Noble Cavalry of the selected tribe (see the army composition notes). Army General. 0-1 Army General (with the Khagan). (Byzantium p.59)</characteristic>
              </characteristics>
            </profile>
            <profile id="be40-cbc3-c055-53e1" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
