          <rules>
            <rule id="882d-8673-a539-291a" name="Great Khagan (Ld 10; armies over 2,000 pts; Avars, Later Khazars, Cumans)" hidden="false">
              <description>For the Army General in Avar, Later Khazar and Cuman armies exceeding 2,000 pts, the Khagan may be upgraded to Great Khagan (+25 pts, Leadership 10). Begs use the Lesser Khagan entry, Sultans the Khagan entry and Khans the Great Khagan entry (Cumans).</description>
            </rule>
          </rules>
          <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
            </selectionEntry>
