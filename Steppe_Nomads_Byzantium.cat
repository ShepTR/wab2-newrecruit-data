                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">6</characteristic>
              </characteristics>
            </profile>
            <profile id="8741-5d34-e2f8-94a6" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and bow. May have javelins (+1 pt) and buckler (+1 pt). Alan Tribesmen are Skirmishers and Nomad Cavalry. Alans, originating from just north of the Caucasus Mountains, served as allies and mercenaries in various armies from Antiquity to the Late Medieval period. (Byzantium p.60)</characteristic>
              </characteristics>
            </profile>
            <profile id="97e4-2384-92f4-6091" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="acfb-8015-8660-bc2f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bcb3-b751-f732-648f" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
