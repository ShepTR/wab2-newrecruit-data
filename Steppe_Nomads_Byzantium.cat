                <condition field="selections" scope="5d16-d924-4a7a-3e50" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a7da-89c6-bccf-d454" type="lessThan"/>
                <condition field="selections" scope="5d16-d924-4a7a-3e50" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="5cf8-68da-07de-214a" type="lessThan"/>
                <condition field="selections" scope="5d16-d924-4a7a-3e50" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="d046-229c-38b3-425b" type="lessThan"/>
                </conditions>
