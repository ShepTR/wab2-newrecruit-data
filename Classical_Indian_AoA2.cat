            <profile id="77e4-c079-c321-4901" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, composite bow, javelins and shield, and either throwing spear, thrusting spear or halberd. Army General. May ride in a chariot, or on an elephant, bought at additional cost from the list, or on a 6” movement horse (+7), and may in each case have heavy armour (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="7f4f-8651-4db0-acb3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="ff1f-e908-04d9-d7ab" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e51f-3aa0-e95f-701f" type="atLeast"/>
