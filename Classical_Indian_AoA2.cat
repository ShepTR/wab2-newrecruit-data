            </profile>
            <profile id="9061-9a3f-e1af-249f" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Guardsmen have hand weapon, halberd and javelins. They may replace javelins with throwing spears (+1) and may replace their halberds with two-handed swords (+1). They may have light armour (+2) and shield (+1) or large shield (+2). Guardsmen are Stubborn and may not be the only infantry unit in the army. All the above may use Combined Formation.</characteristic>
              </characteristics>
            </profile>
            <profile id="6ae4-bd64-56c1-fdaa" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="f1d4-2728-8c4e-5f7f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e2b0-ba8c-57b1-aa2b" type="atLeast"/>
