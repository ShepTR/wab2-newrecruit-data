              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, javelins and shield. Used to Elephants. May replace javelins with throwing or thrusting spear (+2). 0-1 unit may have light armour (+2).</characteristic>
              </characteristics>
            </profile>
            <profile id="2df8-7928-b76f-7352" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="790d-31be-e1e8-fdf2" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f3a4-b82c-5ef6-c1fe" type="atLeast"/>
                </conditions>
