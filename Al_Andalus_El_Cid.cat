            <profile id="aee4-bf05-935c-c9d7" name="Equipment and options (as printed in WAB2 army list)" publicationId="2127-dab1-0af6-7421" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Javelins and hand weapon. May have throwing spears (+2 pts). May have shields (+1 pt). Up to half the units of Andalusian Jinetes may exchange javelins for bow (+2 pts), in which case throwing spears may not be taken as well; bow-armed Jinetes are Expert Horsemen. Light Troops (Light Cavalry). Feigned Flight. Andalusian Horsemen. Later Taifas: may have light armour (+2 pts per model). (El Cid p.41)</characteristic>
              </characteristics>
            </profile>
            <profile id="3e7a-a5e5-ed9c-24d6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="49e5-25d5-d639-053a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8d95-5859-4709-bcb5" type="atLeast"/>
