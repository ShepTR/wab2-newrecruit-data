              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons, javelins. May have throwing spears (+2 pts). May have buckler (+1 pt). May exchange javelins for shortbow or sling at no extra cost. Skirmishers. (El Cid p.42)</characteristic>
              </characteristics>
            </profile>
            <profile id="45c9-2303-8ba1-b7a6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
