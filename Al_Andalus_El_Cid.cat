              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="9042-e4d8-cc8d-a2c6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d584-4bf5-4501-3e9e" type="atLeast"/>
                <condition field="selections" scope="9042-e4d8-cc8d-a2c6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2487-e686-6549-0b79" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="dc69-491d-9bcd-ae16" name="Equipment and options (as printed in WAB2 army list)" publicationId="2127-dab1-0af6-7421" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Thrusting spear, shield, javelins. May have light armour (+2 pts) and/or large shields (+1 pt). A single unit of Mercenary Spearmen in an army may be Stubborn (+3 pts per model). Combined Formation: may have up to 50% Mercenary Archers in the rear ranks of the unit; Mercenary Archers cannot be combined with Stubborn Mercenary Spearmen. Aliados y Mercenarios: may have a leader, standard bearer and musician as normal; roll a dice the first time each unit moves, charges or shoots (on a 1 it stays stationary); may not benefit from the Army General or Army Standard Bearer abilities (they may be led by any appropriate character). One Aliados y Mercenarios unit may be personally led by the Army General and is then exempt from these rules. (El Cid p.54)</characteristic>
              </characteristics>
            </profile>
            <profile id="8cb6-91cb-8b29-fab3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="9042-e4d8-cc8d-a2c6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d584-4bf5-4501-3e9e" type="atLeast"/>
                <condition field="selections" scope="9042-e4d8-cc8d-a2c6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2487-e686-6549-0b79" type="lessThan"/>
