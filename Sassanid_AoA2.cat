              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Infantry have Mixed Weapons and shield. Warband. May have throwing spear (+1). Every second unit may upgrade to large shield (+1) and have light armour (+2).</characteristic>
              </characteristics>
            </profile>
