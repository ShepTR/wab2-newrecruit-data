                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Daylami have hand weapon, javelins and shield. Open Order. Warband. Shieldwall. They may exchange javelins for throwing spear (+1) and shield for large shield (+1). They may have light armour (+2) and composite bow (+2) and may be Riding Camels (+1). They may also be Stubborn (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="9fda-86d5-d62d-edbc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="b316-1162-cbc5-2734" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c58f-43e2-ce1e-a2d7" type="atLeast"/>
