            </profile>
            <profile id="2fce-96e5-7d57-27d7" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">In early armies, has hand weapon, light armour, and kontos. Army General. May have heavy armour (+1) or cataphract armour (+2) and cloth barding (+3) or barding (+4). In late armies, has hand weapon, light armour, thrusting spear and shield. Army General. May have composite bow (+2), heavy armour (+1) and cloth barding (+3) or barding (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="d7a1-b088-a1cd-1052" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
