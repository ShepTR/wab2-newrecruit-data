              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Huns have hand weapon and composite bow. Nomad Cavalry. Skirmishers. May have throwing spear (+3) and shield (+1).</characteristic>
              </characteristics>
