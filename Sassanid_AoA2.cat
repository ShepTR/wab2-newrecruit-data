                <conditions>
                <condition field="selections" scope="ce9c-d340-8f3d-f23e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="cb17-988d-76cf-9c0b" type="atLeast"/>
                <condition field="selections" scope="ce9c-d340-8f3d-f23e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="cf11-5b01-1f8c-442c" type="lessThan"/>
