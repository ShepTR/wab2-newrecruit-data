              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Horse archers have hand weapon and composite bow. Light cavalry. Parthian Shot. Feigned Flight. Expert Horsemen. May have shield (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="47d1-1f3a-e168-da45" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="7f01-700a-b0a8-56ff" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e49d-f766-6d30-93c0" type="atLeast"/>
