              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Cavalry are armed with hand weapon, light armour and kontos. Eastern Shock Cavalry. May have heavy armour (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="a543-940a-d3c6-253c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="5332-4b38-d383-75ea" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c50b-8a4a-2aa0-c4d6" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
