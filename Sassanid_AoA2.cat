            <profile id="3d40-3799-9bf8-6523" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">An Army Standard Bearer has a hand weapon and light armour. Either may have heavy armour (+1) and cloth barding (+3) or barding (+4). An Army Standard bearer has light armour and shield. Either may have heavy armour (+1) and cloth barding (+3) or barding (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="fc88-8ce8-da54-d4b7" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="2239-d448-ba5b-2b5b" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="d44e-78de-d8f1-d768" type="atLeast"/>
