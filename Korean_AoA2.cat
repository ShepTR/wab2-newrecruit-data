            <profile id="d5d7-931f-8c10-5e08" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Spearmen and Levy Spearmen have a hand weapon, thrusting spear and shield. Different Weapons. May have a large shield (+1) and may exchange thrusting spear for halberd (free). May use a Combined Formation where up to half of the figures exchange thrusting spear for composite bow (free) and form the rear ranks. Alternatively, may use a Mixed Formation where up to half of the figures exchange thrusting spear for crossbow (+2). Levy Spearmen are Levy.</characteristic>
              </characteristics>
            </profile>
            <profile id="8f55-6a2f-c154-d465" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="226a-31cb-bd94-a6a7" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="db2d-13e2-49cf-a68e" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
