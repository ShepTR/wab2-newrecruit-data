            </profile>
            <profile id="5d11-345a-3421-084f" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Spearmen and Levy Spearmen have a hand weapon, thrusting spear and shield. Different Weapons. May have a large shield (+1) and may exchange thrusting spear for halberd (free). May use a Combined Formation where up to half of the figures exchange thrusting spear for composite bow (free) and form the rear ranks. Alternatively, may use a Mixed Formation where up to half of the figures exchange thrusting spear for crossbow (+2).</characteristic>
              </characteristics>
            </profile>
            <profile id="3fa3-7a51-ead1-e8c3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="d206-5790-a733-08d0" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f30e-17f7-4e06-b164" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
