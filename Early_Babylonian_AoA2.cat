            </profile>
            <profile id="b5ee-50af-4267-5e15" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Amorite Chief. hand weapon. May have bow (+4 points) or javelins (+3 points) and may have light armour (+2 points) and buckler (free). may only lead Amorites but counts as Army General for Amorite troops. They take a panic test upon his death, but not on that of the Babylonian C-in-C. Amorites Hand weapon and javelins. Light Infantry. Warband (Rule 2 does not apply) Kassite Chariots have Driver and one crewman armed with hand weapon and bow. Light Chariots. Elamites have hand weapon and bow. Light Infantry.</characteristic>
              </characteristics>
            </profile>
            <profile id="d421-c325-2adc-716d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="8a2d-0ca5-657b-0d82" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c084-95a0-1f80-5b26" type="atLeast"/>
