            <profile id="1512-df5e-a896-4760" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Amorite Chief. hand weapon. May have bow (+4 points) or javelins (+3 points) and may have light armour (+2 points) and buckler (free). may only lead Amorites but counts as Army General for Amorite troops. They take a panic test upon his death, but not on that of the Babylonian C-in-C. Amorites Hand weapon and javelins. Light Infantry. Warband (Rule 2 does not apply) Kassite Chariots have Driver and one crewman armed with hand weapon and bow. Light Chariots. Gutians have two-handed weapons and javelins. Light Infantry. Warband (rule 2 does not apply) Hattians Hand weapon and thrusting spear. May have large shields (+2 points) and may exchange thrusting spears for two-handed weapons (+1 point). Warband (rule 2 does not apply) Amorite Skirmishers Hand weapon and short bow, or javelins, or slings. Option: May have buckler (free) if armed with javelins. Skirmishers. Elamites Hand weapon and bow. Light Infantry.</characteristic>
              </characteristics>
            </profile>
            <profile id="f006-81f8-6d28-178b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="3e95-9f3a-01af-fae7" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fac2-36d4-fe17-8ef3" type="atLeast"/>
