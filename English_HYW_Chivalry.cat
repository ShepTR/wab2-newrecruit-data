            </profile>
            <profile id="7098-15fb-c8ac-2fb3" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and shield. May wear partial plate armour (+2 pts). Dismounted Knights may have a halberd (+3 pts), double-handed weapon (+3 pts) or a shortened lance that counts as a thrusting spear (+3 pts). Combined Formation; Knights may be combined with Men-at-Arms. The Herce applies. (Armies of Chivalry p.15)</characteristic>
              </characteristics>
            </profile>
            <profile id="7a14-6082-48af-522a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="a2bb-eb44-c3a2-a1be" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="874f-1527-f67b-c6db" type="atLeast"/>
