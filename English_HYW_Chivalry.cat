            <profile id="9022-a1aa-7d15-4927" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour and shield. May wear heavy armour (free). Mounted Men-at-Arms may have a lance (+4 pts) and horse (free) that can have cloth barding (+4 pts). Combined Formation; Men-at-Arms may be combined with Knights. (Armies of Chivalry p.15)</characteristic>
              </characteristics>
            </profile>
            <profile id="3888-ac1a-ba92-d882" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="ef36-62f4-b7a2-bccc" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7d30-0774-3013-5022" type="atLeast"/>
                <condition field="selections" scope="ef36-62f4-b7a2-bccc" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9ce1-dda7-863c-480c" type="lessThan"/>
                </conditions>
              </modifier>
