            <profile id="767d-132d-6632-052c" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Longbow and hand weapon. Stakes (+20 pts per unit). May have light armour (+2 pts). Open Order, Stakes. Not allowed in the Continental army; the Home army must have at least one unit of Poor Archers (not enforced). (Armies of Chivalry p.15)</characteristic>
              </characteristics>
            </profile>
            <profile id="e46c-3071-0bc6-eca9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="ffa1-33e5-7444-80c2" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bf2e-3a49-b939-7a19" type="atLeast"/>
