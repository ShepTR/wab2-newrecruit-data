            </profile>
            <profile id="3486-5894-ff71-623f" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour and shield. May wear heavy armour (+2 pts). Dismounted Men-at-Arms may have a halberd (+2 pts), double-handed weapon (+2 pts) or a shortened lance that counts as a thrusting spear (+2 pts). Combined Formation; Men-at-Arms may be combined with Knights. (Armies of Chivalry p.15)</characteristic>
              </characteristics>
            </profile>
            <profile id="a25f-acea-c410-8d0b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="be97-f65e-f31a-a5a5" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ba0f-2b85-25cb-a2d6" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
