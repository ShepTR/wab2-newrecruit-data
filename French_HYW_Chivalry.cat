            </profile>
            <profile id="45a7-6e13-f857-50e7" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour and shield. May upgrade to heavy armour (+2 pts). May have thrusting spear (+2 pts) or a lance (+4 pts) and must have a warhorse (free). Warhorse may have cloth barding (+4 pts). Combined Formation; may be combined with Knights. Mounted Esquires are subject to Impetuous and Arrogant Pride. (Armies of Chivalry p.33)</characteristic>
              </characteristics>
            </profile>
            <profile id="8edf-c3a6-0d60-5f3d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="929c-e30b-57a1-da03" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9b13-655d-81b9-0a84" type="atLeast"/>
                <condition field="selections" scope="929c-e30b-57a1-da03" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e852-fd41-8100-36d1" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="3+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="929c-e30b-57a1-da03" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9b13-655d-81b9-0a84" type="lessThan"/>
