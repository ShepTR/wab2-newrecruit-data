                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Thrusting spear, pavise and light armour. Combined Formation; Pavisiers (not Voulgiers) may be included in a unit of Crossbowmen in which the Pavisiers form the front rank and the Crossbowmen the subsequent ranks. Pavisiers and Voulgiers cannot be used in the same army (not enforced). (Armies of Chivalry p.33)</characteristic>
              </characteristics>
            </profile>
            <profile id="525f-fb53-5027-13f1" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">4+ with Pavise +2 when shot at from the front only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="a832-9971-e7b1-20d0" name="Combined Formation (Chivalry)" hidden="false" targetId="7acf-f489-43af-c5c6" type="rule"/>
            <infoLink id="1ef6-3c4c-fb1e-09ec" name="Thrusting Spear" hidden="false" targetId="5a59-1efb-14ef-017a" type="profile"/>
            <infoLink id="aab9-d889-3303-a30c" name="Pavise" hidden="false" targetId="f587-5eb5-fc55-6409" type="profile"/>
            <infoLink id="9c61-1e57-03fd-e02e" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="9"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
