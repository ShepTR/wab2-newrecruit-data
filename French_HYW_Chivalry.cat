            <profile id="234d-65a2-3b66-81eb" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and shield. May wear partial plate (mounted free, dismounted +2 pts) or full plate armour (mounted free, dismounted +4 pts). May have a lance (+4 pts) if mounted. Must have a warhorse (free) if mounted. The warhorse can have cloth barding (+4 pts). May have a halberd (+3 pts) or a double-handed weapon (+3 pts) if on foot (not tied to being dismounted). One Noble may be the Army Standard Bearer (+15 pts) and may only be armed with a hand weapon (not enforced). (Armies of Chivalry p.AoC)</characteristic>
              </characteristics>
            </profile>
            <profile id="31ac-4ccd-5cdc-b102" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="4132-d1bf-4bda-49dd" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="425f-9599-fe76-0da7" type="atLeast"/>
                <condition field="selections" scope="4132-d1bf-4bda-49dd" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="4f9c-5d1d-b233-7dab" type="lessThan"/>
