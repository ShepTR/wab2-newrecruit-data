                <characteristic name="W" typeId="ce59-af10-7f37-4238">2</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">-</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">-</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">-</characteristic>
              </characteristics>
            </profile>
            <profile id="8534-411f-8288-103f" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Each Caravan has a crew of three Defenders armed with hand weapons and bows. Mounted on a 4.7" (120mm) round base with pack animals and Defenders; carrying important trade goods out of all proportion to its size. Where table quarters normally count as Victory Points, they are not counted if a Caravan is used and the Caravan is worth 200 Victory Points; the opposing player can claim them with a unit in contact with the Caravan at the end of the game. The owner either gives it to the opposing player to defend as an objective in their deployment area (Raid) or deploys it in their own area as an objective (Aid). All the Defenders form a single unit that must remain with the wagons unless they break or flee, in which case they auto-break and are removed from play. 0-1. (The Art of War p.78)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
          </costs>
        </selectionEntry>
