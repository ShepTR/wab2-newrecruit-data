            <profile id="3707-3713-29f6-e919" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon, kontos, lamellar armour and bow. May have throwing spear instead of kontos, buckler (+1 pt), barding for the horse (+4 pts). Eastern Shock Cavalry. 0-2. (The Art of War p.75)</characteristic>
              </characteristics>
            </profile>
            <profile id="b190-0f47-3a6f-77f7" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="3+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="e796-81f0-847e-6ea9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="326f-adcd-efc8-c960" type="atLeast"/>
