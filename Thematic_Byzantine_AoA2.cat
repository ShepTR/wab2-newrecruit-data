            </profile>
            <profile id="f50f-fa17-0b73-e9f5" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Cavalry have hand weapon, light armour, thrusting spear and shield and are Eastern Shock Cavalry. They may have heavy armour (+1). and either half barding (+2) or barding (+4). May be Drilled (+2) and Tagmata and Elite Themata may be Veteran (+1). Units may use Combined Formation with up to half their models exchanging thrusting spear for composite bow (-1 for Themata, +1 for Tagmata and elite Themata) and forming the rear ranks. Such models may not have heavy armour or barding. Units may instead exchange thrusting spear for throwing spear (free) or javelins (-1, -2 for Themata) and become Light Cavalry (free). Such units may not use Combined Formation. They may opt to drop their light armour (-2) if they wish.</characteristic>
              </characteristics>
            </profile>
            <profile id="6262-1af5-eda9-8179" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="950d-2c4e-548e-d292" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9017-3c17-3dce-44b9" type="atLeast"/>
                <condition field="selections" scope="950d-2c4e-548e-d292" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1c11-ebcf-7dfb-546e" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="950d-2c4e-548e-d292" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9017-3c17-3dce-44b9" type="lessThan"/>
                <condition field="selections" scope="950d-2c4e-548e-d292" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1c11-ebcf-7dfb-546e" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="2+">
                <conditions>
                <condition field="selections" scope="950d-2c4e-548e-d292" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9017-3c17-3dce-44b9" type="atLeast"/>
                <condition field="selections" scope="950d-2c4e-548e-d292" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1c11-ebcf-7dfb-546e" type="atLeast"/>
                </conditions>
              </modifier>
