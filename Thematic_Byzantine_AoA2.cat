            <profile id="9437-2974-6795-251f" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have hand weapon, thrusting spear and shield. Shieldwall. They may have large shield (+1) and darts (+1). Regular units may have light armour (+2). All may use Combined Formation with up to half the unit’s figures exchanging thrusting spear and shield for composite bow (-1) and forming the rear ranks. Elite Themata may be drilled (+2).</characteristic>
              </characteristics>
            </profile>
            <profile id="a857-c739-1ffa-65ee" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="5486-9fe6-ab4c-40be" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c23a-3b86-efe4-3a2d" type="atLeast"/>
