                <condition field="selections" scope="b526-2a5e-6f1b-081d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6cf7-a991-634b-d324" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="2+">
                <conditions>
                <condition field="selections" scope="b526-2a5e-6f1b-081d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7efd-e36c-066b-530b" type="atLeast"/>
