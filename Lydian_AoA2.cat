            <profile id="bcbc-4120-a2f3-a3e0" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, thrusting spear and shield. Veteran. May have heavy armour (+1) and may upgrade shield to large shield (+1). May ride a horse (+8) in which case the shield is discarded.</characteristic>
              </characteristics>
            </profile>
