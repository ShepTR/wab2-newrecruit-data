                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
            </profile>
            <profile id="9eb1-36ae-d932-a84f" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Lancers have hand weapon, light armour and thrusting spear. Shock Cavalry. May take heavy armour (+1). Lydian cavalry were capable of fighting dismounted and so may dismount for (–11) points. If dismounted they are Stubborn and Riding Horses with M4 and normal rank bonus.</characteristic>
              </characteristics>
            </profile>
            <profile id="1c14-b78b-00f3-bd30" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="7ea2-d839-44ab-d744" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fab2-8148-04ce-9bf9" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
