            <profile id="c660-23ed-7f37-ea5c" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Chariots Driver and one crewman armed with hand weapon, light armour, javelins and shield. Light Chariots. Chariot Runners have Hand weapon and javelins. Light Infantry; Chariot Runners. May not be more units of chariot runners than there are of chariots.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8f34-7531-50b0-c3e3" name="Light Chariots" hidden="false" targetId="1a24-5fa1-b293-3a71" type="rule"/>
            <infoLink id="c1b0-0c59-8a19-93c4" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="bf48-c045-71ee-2242" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
