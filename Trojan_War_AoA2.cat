                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">5+</characteristic>
              </characteristics>
            </profile>
            <profile id="90fb-c176-b5f0-90c7" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Spearmen have hand weapon, thrusting spear, light armour and shield. One unit of spearmen may upgrade to WS4, Stubborn (+5 points each) as Myrmidons. They exchange thrusting spear for throwing spear and must be lead by a minor king on foot, who cannot leave the unit. Spearmen may exchange thrusting spear for javelins (- 1 point). Warband (rule 2 does not apply).</characteristic>
              </characteristics>
            </profile>
            <profile id="1cc0-0023-ebd8-7d9a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="e7f7-4efd-d46d-9db3" name="Stubborn" hidden="false" targetId="ce73-f053-8ef6-626c" type="rule"/>
            <infoLink id="9614-216e-4eff-eb63" name="Warband" hidden="false" targetId="e230-5072-4109-a786" type="rule"/>
            <infoLink id="d7a9-8815-f1ae-7390" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="12f7-dc5a-a23c-6a64" name="Thrusting Spear" hidden="false" targetId="5a59-1efb-14ef-017a" type="profile"/>
