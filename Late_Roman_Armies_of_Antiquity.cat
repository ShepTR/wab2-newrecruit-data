            </profile>
            <profile id="7c9a-8f24-b0b3-bbbe" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelins and buckler. May have throwing spear (+2 pts), shield (+1 pt) or large shield (+3 pts) instead of a buckler, kontos (+1 pt) or bow (+2 pts) instead of javelins. Light Cavalry. Guard troops. (Armies of Antiquity p.25)</characteristic>
              </characteristics>
            </profile>
            <profile id="fe4e-a467-76c0-8a29" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">5+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="7f72-96a7-5f57-d791" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c953-8ab1-5eff-8701" type="atLeast"/>
