            <profile id="89a2-d998-7d68-5082" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a sword. May have light armour (+3 pts), shield or buckler (+1 pt), large shield (+3 pts). May ride a warhorse (+4 pts) or a barded warhorse (+8 pts). 0-1. (Armies of Antiquity p.25)</characteristic>
              </characteristics>
            </profile>
            <profile id="cd1d-1097-b4a2-bb67" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
