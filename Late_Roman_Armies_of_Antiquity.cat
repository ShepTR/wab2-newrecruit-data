            <profile id="770d-4521-379f-2c71" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, throwing spear and shield. May have light armour (+2 pts), javelins (+1 pt), darts (+1 pt). May replace shield with large shield (+1 pt). May form a shield wall. (Armies of Antiquity p.25)</characteristic>
              </characteristics>
            </profile>
            <profile id="7f59-7b30-8360-2bac" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
