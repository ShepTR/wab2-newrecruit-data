            <profile id="76b8-1cb3-8fe0-f642" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, bow and light armour. May have buckler (+1 pt), and either throwing or thrusting spear (+1 pt). May take half-barding (+2 pts). Light Cavalry. Bulgar cavalrymen with light armour are Expert Horsemen and may use Feigned Flight. If Nobles are taken, at least one unit of Horse Archers must be taken also (Early Balkan Bulgars: at least two units of Horse Archers or Elite Horse Archers). 0-2 units. (Byzantium p.75)</characteristic>
              </characteristics>
            </profile>
            <profile id="0c3e-7e98-f43c-d986" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="5+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="193f-ff29-d21f-5e23" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3f5a-c915-2710-58b6" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="e6e7-0ee1-d933-c4e9" name="Expert Horsemen" hidden="false" targetId="01f3-18f2-5b03-2aee" type="rule"/>
            <infoLink id="8774-b102-8db1-1c36" name="Feigned Flight" hidden="false" targetId="23ce-0721-aa10-1f4d" type="rule"/>
