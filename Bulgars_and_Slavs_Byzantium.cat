                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="f963-eca1-96ad-ee53" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and bow. May have buckler (+1 pt), and either throwing or thrusting spear (+1 pt). Light Cavalry. Bulgar cavalrymen with light armour are Expert Horsemen and may use Feigned Flight. All other Bulgar cavalry are Nomad Cavalry. Originally, the nomadic Bulgars fought from horseback. As they settled and mixed with the Slav peoples, Bulgar cavalry became rarer. (Byzantium p.75)</characteristic>
              </characteristics>
            </profile>
            <profile id="2127-4196-d280-5f15" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="5+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="a924-5eb4-2a7f-4b51" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="426a-59cc-305e-b0e8" type="atLeast"/>
                <condition field="selections" scope="a924-5eb4-2a7f-4b51" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9b5c-cd9c-5d8f-1ea7" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="a924-5eb4-2a7f-4b51" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="426a-59cc-305e-b0e8" type="lessThan"/>
