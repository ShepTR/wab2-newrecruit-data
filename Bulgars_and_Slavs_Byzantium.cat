            </profile>
            <profile id="0420-0eff-7479-a00f" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and light armour. May have buckler (+1 pt), either javelins (+2 pts) or bow (+3 pts), and thrusting or throwing spear (+2 pts). May ride a horse (+8 pts), and may have half-barding (+2 pts). Army Standard Bearer Option: one Bagatur or Tarkan may be upgraded to Army Standard Bearer (+15 pts). Early Balkan Bulgar armies: if no other Army General is chosen, a Tarkan may be upgraded to Kavkan (+25 pts), who counts as Army General. All mounted Bulgar commanders are Expert Horsemen and may use Feigned Flight. Later Balkan Bulgar characters on foot may have a large shield (+2 pts). (Byzantium p.75)</characteristic>
              </characteristics>
            </profile>
            <profile id="cdfe-8c14-1ea8-cbcd" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="5+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="f859-3219-a90c-c88c" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="c1ea-7fae-aa22-9d68" type="atLeast"/>
                <condition field="selections" scope="f859-3219-a90c-c88c" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="d2ab-e5e9-51a4-c527" type="lessThan"/>
                <condition field="selections" scope="f859-3219-a90c-c88c" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e2af-6fe6-a51b-f618" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
