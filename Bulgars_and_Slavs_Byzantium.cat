            </profile>
            <profile id="ee5f-3323-ad69-9594" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and bow. May have buckler (+1 pt), and either throwing or thrusting spear (+1 pt). Light Cavalry. Bulgar cavalrymen with light armour are Expert Horsemen and may use Feigned Flight. All other Bulgar cavalry are Nomad Cavalry. (Byzantium p.75)</characteristic>
              </characteristics>
            </profile>
            <profile id="cc5d-6494-05af-1942" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="5+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="7b50-4f8f-390d-dbce" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b7b5-5b7c-69dc-982c" type="atLeast"/>
