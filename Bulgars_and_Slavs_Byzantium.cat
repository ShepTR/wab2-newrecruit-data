            </profile>
            <profile id="96cc-5faa-5759-20ad" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mixed weapons (count as hand weapon and javelins) and shield. Every other unit of Warriors may have throwing spear (+1 pt) or bow (+2 pts) instead of javelins. Two units of Slav Warriors may have either halberds (+2 pts), or double-handed weapons (+3 pts). Skirmisher Option: any Slav Warrior unit may be designated as Skirmishers (+1 pt); they have Feigned Flight. Light Infantry. Warband. Slav Warriors and Brigands have Stealth. Later Balkan Bulgars: Warriors are not subject to Warband Psychology Rule 2 and Rule 3. Any unit of Bulgar Foot Warriors may be upgraded to Later Warriors (+1 pt, Leadership 5); Later Warriors do not count as Light Infantry. Later Bulgar warriors with throwing spears may have light armour (+1 pt) and/or large shield (+1 pt). Warriors and Later Warriors may deploy behind a Palisade Fence (see the Balkan Ruse special rule). (Byzantium p.75)</characteristic>
              </characteristics>
            </profile>
            <profile id="1de9-fc29-f1a3-0526" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="e057-bf1a-f450-0059" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4a4c-7c06-d184-1ad0" type="atLeast"/>
