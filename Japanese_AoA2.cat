            <profile id="69e3-b48e-456a-275f" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Trained Monks may have light armour (+2). May exchange spear for halberd (free). In late armies, Units may exchange spear for pike (+1) representing troops armed with yari. These units are Close Order. Monk unit leaders cost 20 points instead of the usual 5. They allow their units to add +1 Combat Resolution bonus and to re-roll a failed Break Test.</characteristic>
              </characteristics>
            </profile>
            <profile id="df58-c787-96c1-0478" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="dfd5-7c76-b491-2b0c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="57a7-d1c8-6262-405c" type="atLeast"/>
