            <profile id="d30b-8ddf-81ce-4cf7" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, throwing spear, javelin, light armour and shield. May exchange throwing spear for thrusting spear (free). May be mounted on a horse (+8 pts). Warband. Army General. 0-1. Not available to Powys or Dumnonia. (Shieldwall p.52)</characteristic>
              </characteristics>
            </profile>
            <profile id="b37e-3875-a49f-9539" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
