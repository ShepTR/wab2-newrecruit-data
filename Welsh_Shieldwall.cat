            </profile>
            <profile id="697e-4b23-aa84-aaf2" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons. May have light armour (+3 pts). May have shield (+2 pts) or additional hand weapon (+3 pts). May have throwing spear (+2 pts), double-handed axe (+2 pts) and javelins (+1 pt). Light Infantry. Fury of the Norsemen. Different Weapons. Subject to Warband psychology rule 2. Dogs of War cannot be accompanied by characters and cannot benefit from the Army General and Standard Bearer rules. (Shieldwall p.78)</characteristic>
              </characteristics>
            </profile>
            <profile id="d816-d200-80d9-4611" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="4af6-68b1-034a-45f5" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6422-2e95-1ff4-801f" type="atLeast"/>
                <condition field="selections" scope="4af6-68b1-034a-45f5" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5b43-c16c-314d-eed5" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="4af6-68b1-034a-45f5" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6422-2e95-1ff4-801f" type="lessThan"/>
                <condition field="selections" scope="4af6-68b1-034a-45f5" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5b43-c16c-314d-eed5" type="atLeast"/>
                </conditions>
