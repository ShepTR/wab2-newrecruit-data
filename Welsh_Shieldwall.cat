            </profile>
            <profile id="a85d-f096-2313-90c3" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons, javelin and shield. May have light armour (+3 pts), throwing spear (+2 pts). All in a Teulu may be mounted on horses (+8 pts). Warband. Werod. Light Infantry. 0-1 unit. Gwynedd: the Teulu may exchange throwing spear for thrusting spears (free). Southern Kingdoms: the Teulu may have bows (+3 pts). (Shieldwall p.53)</characteristic>
              </characteristics>
            </profile>
            <profile id="988a-180c-01f2-8f2e" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="88c2-1773-84d4-db1f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e76e-059a-c877-44c5" type="atLeast"/>
                <condition field="selections" scope="88c2-1773-84d4-db1f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5d09-e13d-212a-2154" type="lessThan"/>
