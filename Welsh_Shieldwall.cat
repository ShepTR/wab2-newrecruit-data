            </profile>
            <profile id="a91f-8cd7-27ad-1a32" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons and shield. May have javelins (+1 pt) and/or throwing spears (+1 pt). Warband. Light Infantry. Gwynedd: may exchange throwing spear for thrusting spears (free). Powys: every other unit of Priodaur may exchange shield and spear for bow (free). Southern Kingdoms: Priodaur may exchange their spear and shields for bows (free); at least half of the units of Priodaur must be bow-armed (not enforced). (Shieldwall p.53)</characteristic>
              </characteristics>
            </profile>
            <profile id="0fd0-eca7-dab2-f372" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="None">
                <conditions>
                <condition field="selections" scope="4e79-c483-51b3-daf2" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ba19-9d6c-5970-9731" type="atLeast"/>
