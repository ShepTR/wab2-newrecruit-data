            </profile>
            <profile id="89de-82d3-e4f3-dd06" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, shield and throwing spear, mounted on a warhorse. May upgrade armour to heavy armour (+1 pt), javelins (+2 pts). May receive up to a +1 rank bonus when mounted. Any unit that chooses to flee or fire &amp; flee as a charge reaction rallies automatically at the end of its move and may reform facing in any direction; a charging enemy that encounters them does not destroy them. Despite their warhorses and armour the Devroet count as Light Cavalry. (The printed profile gives M4; M8 entered because the unit is mounted on warhorses.) Dogs of War cannot be accompanied by characters and cannot benefit from the Army General and Standard Bearer rules. (Shieldwall p.79)</characteristic>
              </characteristics>
            </profile>
            <profile id="f8cf-a7ad-df63-b1ed" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="a89a-70e4-e1c4-5397" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="264b-b9b3-9ca7-f43a" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
