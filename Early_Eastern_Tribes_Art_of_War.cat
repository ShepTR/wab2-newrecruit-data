            <profile id="a1e9-28b6-b6f8-6f1b" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Tribes of the East only: the Totem is a stone dolman (+15 pts) instead of a Totem Bearer. Functions like an Army Standard Bearer but cannot move or be destroyed; deployed outside the enemy deployment zone on a 50mm x 50mm square or round base. (The Art of War p.17)</characteristic>
              </characteristics>
            </profile>
            <profile id="e460-9425-927c-c5b4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="dcf8-f6c4-3c83-6650" name="Army Standard" hidden="false" targetId="41fc-5de5-0862-91b8" type="rule"/>
            <infoLink id="74d8-5657-646f-6adf" name="Totem (Art of War)" hidden="false" targetId="c6bf-b44f-c9da-06cb" type="rule"/>
