            </profile>
            <profile id="ca30-974e-b423-cb74" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon. May have a shield (+2 pts), axe (+2) or dagger axe (+2) and light armour (+3). Subject to the Psychology of the group they join. In the Tribes of the North may ride in a chariot (not enforced). (The Art of War p.16)</characteristic>
              </characteristics>
            </profile>
            <profile id="ce26-71d9-6a50-0d46" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="c195-33f0-63f6-06b9" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="182b-0b11-4b31-59ae" type="atLeast"/>
