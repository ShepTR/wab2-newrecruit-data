                <conditions>
                <condition field="selections" scope="8e4f-f1e5-0538-7e61" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="dd25-5429-6124-ffc2" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="e327-feda-ad77-78a0" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a short bow and improvised weapons. May have compound bow instead of short bow (+2 pts), light armour (+3). Skirmishers. Tribes of the South: poisoned arrows (+1 pt) cause an automatic wound if they roll a 6 to hit; armour saves are allowed. (The Art of War p.16)</characteristic>
              </characteristics>
            </profile>
            <profile id="1051-48fa-264d-e28a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="8e4f-f1e5-0538-7e61" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="dd25-5429-6124-ffc2" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="c971-2e7c-12b3-f406" name="Skirmishers (Art of War)" hidden="false" targetId="5c5e-9491-3100-c162" type="rule"/>
            <infoLink id="1d4d-634a-6001-85e7" name="Short Bow" hidden="false" targetId="c963-937b-87a2-24f9" type="profile"/>
