                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">6+</characteristic>
              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="5+">
                <conditions>
                <condition field="selections" scope="34eb-8e71-950a-2ff1" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7103-b360-2fd8-a6f4" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="1882-8975-9ab9-0628" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with shields and hand weapons. May have light armour (+3 pts), thrusting or throwing spears (+2 pts) and javelins (+2 pts). Warband. Tribal variants: East - thrusting spears and may be Stubborn (+3); South - skirmishers with throwing spears, no light armour; West - throwing spears, Light Infantry, not subject to the Warband rules; North - thrusting spears, may take dagger axes (+1). At least 33% of the army points. (The Art of War p.16)</characteristic>
              </characteristics>
            </profile>
            <profile id="8256-6fb7-9269-ec86" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="34eb-8e71-950a-2ff1" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7103-b360-2fd8-a6f4" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="c791-7095-cb63-8aa7" name="Warband" hidden="false" targetId="e230-5072-4109-a786" type="rule"/>
            <infoLink id="370c-44e7-1049-bf80" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="0c59-d4af-d191-7437" name="Shield" hidden="false" targetId="b513-5c2a-34df-6a1d" type="profile"/>
