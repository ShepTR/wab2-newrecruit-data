                <condition field="selections" scope="36f4-a4ed-7eb4-5daa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2f6a-a02f-92e5-b460" type="atLeast"/>
                <condition field="selections" scope="36f4-a4ed-7eb4-5daa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3d95-b8da-f03f-11ae" type="atLeast"/>
                </conditions>
              </modifier>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="36f4-a4ed-7eb4-5daa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2f6a-a02f-92e5-b460" type="atLeast"/>
                <condition field="selections" scope="36f4-a4ed-7eb4-5daa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3d95-b8da-f03f-11ae" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="a2f1-11f2-92e7-eb07" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, thrusting spear, shield. May have light armour (+3 pts), javelins (+2 pts) and darts (+1 pt). May replace shield with large shield (+1 pt). May form shield wall instead of moving; all enemy attacks from the front are -1 to hit. (Armies of Antiquity p.29)</characteristic>
              </characteristics>
            </profile>
            <profile id="1bf9-c111-c545-7e77" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="36f4-a4ed-7eb4-5daa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2f6a-a02f-92e5-b460" type="atLeast"/>
