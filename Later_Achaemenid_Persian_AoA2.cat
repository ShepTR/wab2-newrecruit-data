            </profile>
            <profile id="061d-9e67-6769-592a" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mounted characters may have heavy armour (+1). One Satrap may be upgraded to Army General (+50). Standard bearer has a hand weapon, light armour and shield. May ride a Warhorse (+15). In which case the shield is discarded. Army Standard Bearer.</characteristic>
              </characteristics>
            </profile>
            <profile id="ce77-ae76-7faa-5fb6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="f5ed-2168-5abc-0fd2" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="6ea3-62cf-3fc9-98a7" type="atLeast"/>
