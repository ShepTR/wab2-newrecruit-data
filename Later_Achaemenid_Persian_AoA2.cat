              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">5</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="7586-ea74-72bc-37e5" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Takabara have hand weapon, javelins and buckler. May upgrade to shield (+1). All are Levies and Light Infantry. Every second unit from this section may be Mardian Archers. These can fire two ranks at full effect if stationary, as an exception to the usual Massed Archery rule.</characteristic>
              </characteristics>
            </profile>
            <profile id="23bc-5409-ec13-e0cc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">6+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="c145-6fbd-d59b-930f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="65e1-64f9-57f7-d6fe" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="-">
                <conditions>
                <condition field="selections" scope="c145-6fbd-d59b-930f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="65e1-64f9-57f7-d6fe" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="40de-97ed-f79c-bad9" name="Levies" hidden="false" targetId="27b0-fb8f-0353-5958" type="rule"/>
            <infoLink id="1e85-11b1-8176-3fb6" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="1ba0-dd43-6fbe-d5d5" name="Javelin" hidden="false" targetId="10ef-3567-0d3f-d9e7" type="profile"/>
