                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="110e-e7ed-9d5a-f4fd" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Kardakes have hand weapon, thrusting spear and shield. May have light armour (+2). May upgrade shield to large shield (+1) if they are not light infantry. May replace thrusting spears with javelins or slings (-1), or composite bow (free). All troops without thrusting spears become Light Infantry except archers fielded in Combined Formation with spearmen. A Combined Formation must have a front rank entirely of spear armed troops. All units in this section are Combined Formation and may have Mixed Armour.</characteristic>
              </characteristics>
            </profile>
            <profile id="0275-7fec-67be-3459" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="a539-56c6-8e37-cc05" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a7a5-ddc1-7f5b-79da" type="atLeast"/>
                <condition field="selections" scope="a539-56c6-8e37-cc05" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="03b0-d7f3-b62d-a506" type="lessThan"/>
                </conditions>
