                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Driver has heavy armour and improvised weapon. Scythed chariots may be fielded in units of 1 model. Each model has a unit strength of 3. May not take leaders, standards or musicians. Scythed Chariot causing D6+2 S5 impact hits.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="b088-2c32-5b65-aa6a" name="Heavy Armour" hidden="false" targetId="16c5-d2b2-fa96-9cd2" type="profile"/>
