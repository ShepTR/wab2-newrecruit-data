              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Carians have hand weapon, thrusting spear and large shield and may have light armour (+2). Both are Warband (rules 5 and 6 only).</characteristic>
              </characteristics>
