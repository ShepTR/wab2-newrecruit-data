            </profile>
            <profile id="5e81-001b-5919-db1d" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, composite bow, javelins and throwing spear. May ride a horse (+9) or a Warhorse (+16), or ride in a four-horse light chariot with unarmed driver (+30). The Warhorse may have half barding (+2). Army General. If the Great King is used, then units all troops in the army within 12” gain +1 leadership rather than using the Great King’s leadership. Units in the army take a panic test if he flees off table, in the same way as they would if he were killed. He may only join Persian units.</characteristic>
              </characteristics>
            </profile>
            <profile id="a4d1-8f8e-f3c3-e7bc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
