                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
            </profile>
            <profile id="d823-497a-e2ef-3dae" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and thrusting spear. May have light armour (+2) or heavy armour (+3). May exchange thrusting spear for throwing spear (free). Nobles may have half barding (+2). 0-1 unit of Nobles may have short bows (+3). Every second unit may be Nobles. All are Levies, and Massed Cavalry.</characteristic>
              </characteristics>
            </profile>
            <profile id="01ef-ecd7-c6e6-8abb" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="0caa-0b0e-06e0-21e6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0612-0efa-9a0b-863e" type="atLeast"/>
                <condition field="selections" scope="0caa-0b0e-06e0-21e6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5688-900d-35a8-ee18" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="0caa-0b0e-06e0-21e6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0612-0efa-9a0b-863e" type="lessThan"/>
                <condition field="selections" scope="0caa-0b0e-06e0-21e6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5688-900d-35a8-ee18" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="0caa-0b0e-06e0-21e6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0612-0efa-9a0b-863e" type="atLeast"/>
                <condition field="selections" scope="0caa-0b0e-06e0-21e6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5688-900d-35a8-ee18" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
