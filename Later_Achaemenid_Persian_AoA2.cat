                <conditions>
                <condition field="selections" scope="a539-56c6-8e37-cc05" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a7a5-ddc1-7f5b-79da" type="atLeast"/>
