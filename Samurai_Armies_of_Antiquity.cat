              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a katana. May have Samurai armour (+4 pts), spear (+2 pts), additional hand weapon (+2 pts), horse (free, increases Movement to 8"). Army Standard Bearer, Honourable and stubborn. 0-1. (Armies of Antiquity p.45)</characteristic>
              </characteristics>
            </profile>
            <profile id="4c1b-6a4a-a22b-923c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="17f4-362a-f489-7bc4" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="8ca1-4fa2-9417-c849" type="atLeast"/>
                </conditions>
              </modifier>
