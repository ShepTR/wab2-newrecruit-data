              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="a364-d0c2-248d-314d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f327-74bc-09e8-de0e" type="atLeast"/>
