              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon. May have additional hand weapon (+1 pt), naginata (+2 pts), throwing stars (count as javelins, +1 pt), light armour (+2 pts). Skirmishers. Ninja scouts always set up last; they may deploy anywhere on the table outside the enemy's deployment zone and out of sight of the enemy. 0-1. (Armies of Antiquity p.45)</characteristic>
              </characteristics>
            </profile>
            <profile id="de23-4e1a-491a-3f02" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="509c-8043-9b1c-4ee6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b0e3-c844-aeb9-da01" type="atLeast"/>
                </conditions>
