                <conditions>
                <condition field="selections" scope="da94-3768-44fc-c729" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="02f2-ba97-23c9-05a2" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="3ba9-ff11-be36-f09b" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a katana. May have Samurai armour (+4 pts), longbow (+3 pts), naginata (+2 pts), spear (+2 pts), additional hand weapon (+2 pts), horse (free, increases Movement to 8"). Army General, Warrior of Legend, Honourable and stubborn. The army must have a General (not enforced). 0-1. (Armies of Antiquity p.45)</characteristic>
              </characteristics>
            </profile>
            <profile id="bd29-bc42-b69a-14c8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="da94-3768-44fc-c729" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="02f2-ba97-23c9-05a2" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
