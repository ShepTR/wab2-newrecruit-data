            <profile id="0fe2-67eb-0b03-eb90" name="General" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
