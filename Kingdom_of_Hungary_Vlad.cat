            <profile id="26fd-86be-3f11-bdef" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, thrusting spear, light armour, and shield. May upgrade to large shield (+1 pt). Militia may be in Mixed Order with Archers, Crossbowmen, or Handgunners. Before 1441, Hungarian foot consisted of Honvéd (militia) made up of jobbágy (free peasants). (Vlad the Impaler p.14)</characteristic>
              </characteristics>
            </profile>
            <profile id="69a7-d04a-00b4-08db" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="bb10-fe78-938e-2166" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f373-7f0b-5a9b-b9bd" type="atLeast"/>
