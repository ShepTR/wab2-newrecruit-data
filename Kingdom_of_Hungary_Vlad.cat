              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="3bef-02f4-eba6-babc" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="0e3f-4be2-b4c9-ae39" type="lessThan"/>
