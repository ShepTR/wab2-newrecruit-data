            <modifier type="increment" field="points" value="5">
              <repeats>
                <repeat field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c064-0740-6b6c-2416" repeats="1" roundUp="false"/>
              </repeats>
            </modifier>
          </modifiers>
          <!-- def-link -->
          <rules>
            <rule id="200d-2762-6324-7997" name="Royal Banderium (one unit; +5 pts per model; Stubborn, WS5; accompanies the Army General)" hidden="false">
              <description>One unit may be upgraded into Royal Banderium for +5 pts each - which counts as Stubborn and WS5; if taken, Royal Banderium must accompany the Army General. Royal Banderium represents a King's most loyal retainers or personal mercenaries, many of whom would have been inducted into Hungary's Order of Saint George.</description>
            </rule>
          </rules>
          <costs>
