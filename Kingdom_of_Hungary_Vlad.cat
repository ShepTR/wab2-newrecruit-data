                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="d1e3-6ab7-5f12-6ffb" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, bow and horse. Szekelers also have light armour, thrusting spear, and shield. Szekelers are Open Order, Expert Horseman, and have Feigned Flight and Parthian Shot. Native Romanian-speaking Vlachs, the semi-nomadic Szekelers constituted a military body that owed allegiance not to local Hungarian Ispans, but directly to the King himself. (Vlad the Impaler p.14)</characteristic>
              </characteristics>
            </profile>
            <profile id="3c9c-ebc9-efab-342b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="09ad-c728-ef82-fd47" name="Open Order" hidden="false" targetId="6b07-0a99-df48-7a76" type="rule"/>
            <infoLink id="b20e-3499-5011-737f" name="Expert Horsemen" hidden="false" targetId="01f3-18f2-5b03-2aee" type="rule"/>
