            <profile id="b0c1-a836-5b58-3173" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Improvised weapons. May have shields (+1 pt). Warband. 0-1 unit may be led by a Pap. While not normally warlike, Hungary's German peasants miraculously took up defence of their homeland at the urging of the charismatic friar Giovanni di Capistrano. (Vlad the Impaler p.15)</characteristic>
              </characteristics>
            </profile>
            <profile id="d039-3fc4-af04-1a23" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="a0b7-b493-daef-06f4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ab00-ce20-52f2-645a" type="atLeast"/>
