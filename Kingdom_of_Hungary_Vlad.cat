            <profile id="2f93-d7ac-9267-2997" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour, and shield. Must have a horse (free) or warhorse (+4 pts) if mounted. May have cloth (+4 pts) or plate barding (+6 pts). May have partial plate or full plate armour (free if mounted, partial plate is +4 pts if dismounted; full plate is +6 pts if dismounted). Army Standard Bearer. 0-1. (Vlad the Impaler p.13)</characteristic>
              </characteristics>
            </profile>
            <profile id="0804-04a3-112c-6663" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
