          <profiles>
            <profile id="a728-c6d2-5e0f-3cce" name="Tabor Wagon" publicationId="dab5-785d-be28-f228" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">-</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">-</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">-</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">-</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">6</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">3</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">-</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">-</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">-</characteristic>
              </characteristics>
            </profile>
            <profile id="8f48-5fb1-4696-5cab" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Each wagon has from 5-10 defenders armed with hand weapon, bow and light armour; the defenders of each wagon are a separate unit. May exchange bow for thrusting or throwing spear (free) or halberd (+1 pt), or for crossbow or handgun (+6 pts). Different Weapons. The Wagon Tabor is deployed as one unit and placed first; the wagons are up to 3" apart with the end wagons touching the owning player's table edge; it may not move after deployment. Each undefended wagon at the end of the game gives the opponent +15 Victory points. Period of the New Men and Crusader armies; may contain no more than one wagon per 1,000 points. (Vlad the Impaler p.15)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="0b6a-ea23-b64c-6620" name="Wagon Tabor (Chivalry)" hidden="false" targetId="b1b5-e018-17f8-3d3e" type="rule"/>
