            <profile id="bca8-232e-4018-28a7" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, bow and horse. Tartars may take thrusting spear (+2 pts), light armour (+2 pts), and shield (+2 pts). Nomad Cavalry. Skirmishers; if they take light armour, Tartars are Open Order. Tartar cavalry may not outnumber Szekelers. (Vlad the Impaler p.14)</characteristic>
              </characteristics>
            </profile>
            <profile id="2c05-9c14-ea74-f582" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="7503-ff42-c37f-194a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a0dc-0f23-99d7-b910" type="atLeast"/>
