        <selectionEntry id="8f0a-3078-eeae-5656" name="Royal Banderium (one unit; +5 pts per model; Stubborn, WS5; accompanies the Army General)" hidden="false" collective="false" import="true" type="upgrade">
<constraints>
<constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6247-bd48-75a5-7027" type="max"/>
