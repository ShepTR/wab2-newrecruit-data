            <profile id="05c9-4a6c-0ce1-51c7" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Dismounted - hand weapon, heavy armour, shield, and may take halberd or double-handed weapon (+2 pts). May take partial or full plate armour (partial plate is +2 pts if dismounted; full plate is +3 pts if dismounted). Dismounted Armigeri may upgrade to Stubborn (+3 pts). Allies and Mercenaries. (Vlad the Impaler p.15)</characteristic>
              </characteristics>
            </profile>
            <profile id="937c-7d66-05ff-35f1" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="04a1-4de6-dd57-bf33" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9400-755c-3c8d-0ff5" type="atLeast"/>
