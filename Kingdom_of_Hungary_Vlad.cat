            <profile id="330d-aa9f-8ca1-d112" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mounted - hand weapon, lance, heavy armour, shield and warhorse. May take cloth (+4 pts) or plate (+6 pts) barding. May take partial plate or full plate armour (free if mounted). First Charge. May have a +1 rank bonus if mounted. One unit may be upgraded into Royal Banderium for +5 pts each - which counts as Stubborn and WS5; if taken, Royal Banderium must accompany the Army General. Royal Banderium represents a King's most loyal retainers or personal mercenaries, many of whom would have been inducted into Hungary's Order of Saint George. (Vlad the Impaler p.14)</characteristic>
              </characteristics>
            </profile>
            <profile id="5a7f-19f9-7d29-a9b3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="a446-b620-8b1c-4191" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b6d0-cf47-78b5-67d2" type="atLeast"/>
