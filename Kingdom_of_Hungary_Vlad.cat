                <condition field="selections" scope="3bef-02f4-eba6-babc" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="c17e-9a9a-5221-bd8b" type="lessThan"/>
                <condition field="selections" scope="3bef-02f4-eba6-babc" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="8888-85a2-1119-6282" type="lessThan"/>
                </conditions>
