            <profile id="b820-69b0-3b6f-5aa1" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and shield. May wear partial plate armour (+2 pts). Lance and warhorse. First Charge. May count a Rank Bonus of up to +1 in combat. (The unit may add cloth barding +4 pts, not printed for this entry.) (Armies of Chivalry p.34)</characteristic>
              </characteristics>
            </profile>
            <profile id="e1b5-63ff-9012-1f66" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="09e2-1abc-49a0-6736" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7c3d-fe6a-dddc-3f5c" type="lessThan"/>
                <condition field="selections" scope="09e2-1abc-49a0-6736" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2bb6-1c5f-a1be-c851" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
