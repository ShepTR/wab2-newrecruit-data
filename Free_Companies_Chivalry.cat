            <profile id="5fb4-fb6b-3523-86e2" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and shield. May wear partial plate armour (+2 pts). Must have a horse (free) or warhorse (+4 pts) if mounted. Warhorse may have cloth barding (+4 pts). Army Standard Bearer. Stubborn if dismounted. 0-1. (Armies of Chivalry p.34)</characteristic>
              </characteristics>
            </profile>
            <profile id="54cd-5222-e5d2-0f55" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="5de0-1057-dd36-e65b" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="06bf-270f-e7b3-c42d" type="atLeast"/>
