            <profile id="1feb-524c-6ba2-8d7d" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and shield. May wear partial plate armour (+2 pts). May have thrusting spear (a cut-down lance, +1 pt), a halberd (+2 pts), or a double-handed weapon (+2 pts). Stubborn. (Armies of Chivalry p.34)</characteristic>
              </characteristics>
            </profile>
            <profile id="77e3-2d67-3169-7569" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="4823-a8ee-5ea5-5b33" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5b5c-198a-62a9-b3a3" type="atLeast"/>
