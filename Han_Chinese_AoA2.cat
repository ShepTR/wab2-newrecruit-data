                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="160d-b177-c703-0fdc" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Guards have hand weapon, light armour and shield and may have large shield(+1). They may exchange hand weapon and shield for two handed sword (+2). They are Drilled and Stubborn.</characteristic>
              </characteristics>
            </profile>
            <profile id="3156-c390-c10f-94fa" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="c584-5f9c-6ab2-1983" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8531-51d7-bf05-2f83" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="2cc8-dbd8-fa39-4316" name="Stubborn" hidden="false" targetId="ce73-f053-8ef6-626c" type="rule"/>
            <infoLink id="47ee-5f54-a70c-a4a4" name="Drilled" hidden="false" targetId="d6b3-51b2-64eb-2b91" type="rule"/>
