            <profile id="92eb-024f-d954-33b9" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Spearmen have hand weapon, thrusting spear and shield. They may have light armour (+2) and large shield (+1). Halberdiers and spearmen may use Combined Formation: up to 50% of each unit may be comprised of Missile Troops (below).</characteristic>
              </characteristics>
            </profile>
            <profile id="acda-7d92-47c3-6697" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
