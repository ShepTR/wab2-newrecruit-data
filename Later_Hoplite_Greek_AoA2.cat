              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have hand weapon, thrusting spear and large shield. May take light armour (+2). Phalanx. Mercenary Hoplites may upgrade to WS4, Trained Phalanx (+3) as Elites such as Spartans. Note Mercenary Hoplites are not subject to the Allies and Mercenaries rule.</characteristic>
              </characteristics>
            </profile>
            <profile id="ee33-2dad-4808-b321" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
