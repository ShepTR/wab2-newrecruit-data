            <profile id="49f0-9d50-8d9a-d004" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, thrusting spear and large shield. May ride a 7” movement horse (+9) in which case exchanges large shield for heavy armour. Army General. May be Veteran (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="4bec-60eb-143a-2712" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="3d8a-ab69-19b8-884e" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b591-73ba-3b70-9448" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
