              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Warriors have hand weapon and shield. Warriors may have light armour (+2 points) and thrusting spear (+ 2 points). Units may exchange shield for bow or halberd (+ 1 point) if they have not taken thrusting spears.</characteristic>
              </characteristics>
            </profile>
            <profile id="4dec-c228-284e-d284" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="065a-a3c2-7aea-6c89" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="03d8-29d2-35a7-487d" type="atLeast"/>
