            <profile id="b6f3-5cd9-2b0f-e559" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, large shield and thrusting spear. Phalanx. Tarentine Conscripts are Levies. Tarentine Conscripts may be upgraded to WS3 (+3) and then lose Levy. Then they may exchange large shield and thrusting spear for shield, pike and Macedonian Phalanx for (+1) point a model.</characteristic>
              </characteristics>
            </profile>
            <profile id="f406-58b2-abb9-d6d3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="b452-6e71-1efc-d4c6" name="Phalanx" hidden="false" targetId="8703-52e8-b888-e691" type="rule"/>
            <infoLink id="6295-8bc6-8ad8-a118" name="Levies" hidden="false" targetId="27b0-fb8f-0353-5958" type="rule"/>
