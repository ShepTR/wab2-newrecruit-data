            <profile id="d0dd-18aa-0aa8-d01d" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The unit must be led by a single Packmaster (Arrchogad) and may include up to six wolfhounds. The Arrchogad has hand weapon, javelins and a buckler; the hounds have their teeth. Warband rule 1. Skirmishers. Missile hits are randomly divided between the Arrchogad and the hounds; the hounds use his Leadership unless he is killed. 0-1 unit. (The Age of Arthur p.77)</characteristic>
              </characteristics>
            </profile>
            <profile id="5adc-0e12-b34e-ef8f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
