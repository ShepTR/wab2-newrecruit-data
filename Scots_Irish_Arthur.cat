            </profile>
            <profile id="21e6-5255-8088-4cee" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelins and buckler. May have light armour (+3), throwing spears (+4), sling (+3), horse (+8), or ride in a light chariot with driver (+10; Kingdoms of Ireland, or an Army General with Chieftain Chariot). If no Ri Tuath, one Curadh may be upgraded to Army General (+25); one Curadh may carry the Army Standard (+15). A maximum of one Curadh per unit. One Character Advantage (two if Army General). In a chariot: M8 WS5 BS5 S4 T4 W2 I5 A4 Ld8. (The Age of Arthur p.76)</characteristic>
              </characteristics>
            </profile>
            <profile id="c94b-5b6c-60cc-7366" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">6+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="457a-a084-9b09-f1eb" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="6bca-64a4-ad5e-d35c" type="atLeast"/>
