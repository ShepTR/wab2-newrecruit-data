                <conditions>
                <condition field="selections" scope="c2d4-2685-bb75-5fe1" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="c2b6-aa29-a96e-a43f" type="atLeast"/>
