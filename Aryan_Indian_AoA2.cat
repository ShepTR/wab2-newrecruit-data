            </profile>
            <profile id="abb2-7209-0300-44bb" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Driver and one crewman armed with hand weapon and bow. Option: May have light armour (+4 points) and shield (+2 points). Light Chariots. Expert Horseman. Used to Elephants. Also may shoot when charging or countercharging, at short range and after any shooting by their target. Cavalry Hand weapon and Javelins. Option: May have shield (+2 points). Used to Elephants</characteristic>
              </characteristics>
            </profile>
            <profile id="5cfc-77b9-5e35-1c4c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="b509-103d-9057-e4a7" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="74e4-353d-4804-3ce8" type="atLeast"/>
