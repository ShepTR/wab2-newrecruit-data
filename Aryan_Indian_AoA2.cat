                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">9</characteristic>
              </characteristics>
            </profile>
            <profile id="cee4-11c8-e421-4b0c" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, bow, javelins and shield. Rides in a chariot (cost included). A King who dismounts from his chariot during the game may exchange javelin and shield for two-handed club. Army General. Veteran. Expert Horseman. Used to Elephants</characteristic>
              </characteristics>
            </profile>
            <profile id="d804-f505-9d40-3088" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="d9d2-71d8-685c-64cb" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
