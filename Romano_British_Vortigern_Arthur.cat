            <profile id="ffd1-f605-492b-00fb" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, throwing or thrusting spear and shield. On foot: large shield (+2), javelins (+1), light armour (+2), heavy throwing spears (+2). May form Shieldwall. 0-1 unit of Commanipulares (foot or mounted). (The Age of Arthur p.27)</characteristic>
              </characteristics>
            </profile>
            <profile id="dcb3-1d5c-0500-b3f9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="06d7-1ee4-d751-cb37" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="74f7-65a1-f5e0-502b" type="atLeast"/>
