            <profile id="f041-cadd-21db-3275" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mixed weapons (count as a hand weapon and javelins) and shield. May exchange javelins for throwing spear (+1 pt). Every other unit of mounted Freemen may have light armour (+3 pts). Freemen combined with Warriors on foot may be Riding Horses (+1 pt). Light Infantry Option: every other Freemen infantry unit may be designated as Light Infantry (free). Every other Freemen Light Infantry unit may exchange javelins for short bow (+2 pts), or bow (+3 pts) - they may take no further equipment. Light Infantry Freemen cannot combine with Warriors. Light Cavalry Option: in all except Vandal armies, mounted Freemen units may be designated as light cavalry (free) and may take no further equipment. Combined Units - Freemen infantry and cavalry may combine with Warrior infantry and cavalry. Freemen troops on foot are subject to Warband Psychology Rule 1.  (Byzantium p.54)</characteristic>
              </characteristics>
            </profile>
            <profile id="6801-68bd-1b2b-ef6c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="555f-e846-3113-0947" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d604-cc55-c356-f250" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8a7e-d351-88e2-9495" name="Combined Units" hidden="false" targetId="627a-b7a0-2baa-599e" type="rule"/>
            <infoLink id="6988-701f-8980-c8c3" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="2b44-9e5a-9dc6-0b5d" name="Javelin" hidden="false" targetId="10ef-3567-0d3f-d9e7" type="profile">
