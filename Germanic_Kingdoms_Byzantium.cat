            <profile id="1e71-7f74-1141-cd15" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, throwing spear or thrusting spear, light armour and shield. May exchange light armour for heavy armour (+1 pt). Comitatus on foot may be Riding Horses (+1 pt), and may have thrusting spears instead of throwing spears (free). Oath of Allegiance. The Comitatus must be led by the Army General at all times. 0-1 unit (with the Mounted Comitatus). (Byzantium p.53)</characteristic>
              </characteristics>
            </profile>
            <profile id="260d-1b91-4843-b508" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="52f0-c1e7-7918-1177" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="035a-1021-64cc-6fd4" type="atLeast"/>
