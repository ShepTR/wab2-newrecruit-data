            <profile id="ca6b-c6e2-1580-4616" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mixed weapons (count as a hand weapon and javelins), and buckler. May exchange javelins for sling (free). Every other Unfree unit may exchange javelins for short bow (free). Levies. Skirmishers. Unfree models may not outnumber Warrior models. 0-2 units. (Byzantium p.54)</characteristic>
              </characteristics>
            </profile>
            <profile id="a1ad-a35e-0515-a36d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="91e7-140a-0cdd-1ac7" name="Levies (Byzantium)" hidden="false" targetId="7490-e7d5-847a-a64d" type="rule"/>
