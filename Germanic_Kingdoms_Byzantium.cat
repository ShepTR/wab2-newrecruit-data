            <profile id="ed41-7a43-070b-ceb7" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Italian Ostrogoth armies: two units of either Foederati Heavy Cavalry or Berber Light Cavalry may be chosen as allies (see the Early Byzantines list). Hand weapon, light armour, and either bow &amp; buckler or javelins &amp; shield. May exchange light armour for heavy armour (+1 pt). May have throwing or thrusting spear (+1 pt), or exchange for kontos &amp; buckler (free). Mounted Heavy Cavalry are Superior Byzantine Cavalry. (Byzantium p.38)</characteristic>
              </characteristics>
            </profile>
            <profile id="5a37-f63c-13ab-2678" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">4+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="fbf8-4711-0985-ac47" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4add-2ab8-894c-324b" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="3+ with Buckler +1 in hand-to-hand only">
