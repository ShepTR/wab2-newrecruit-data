            </profile>
            <profile id="eba8-9ca3-9cd4-8f17" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, throwing spear or thrusting spear, light armour and shield. May exchange light armour for heavy armour (+1 pt). Mounted Comitatus may either have javelins (+2 pts), or exchange spear &amp; shield for kontos (+1 pt), and take bucklers (+1 pt). Oath of Allegiance. Superior Germanic Cavalry. The Comitatus must be led by the Army General at all times. 0-1 unit (with the Comitatus on foot). Gepid or Lombard Comitatus and Warrior Cavalrymen must either take kontos or Kontarion (+1 pt) instead of spear. Vandal Comitatus and Warrior Cavalry may not take javelins. Ostrogothic Comitatus may take barding (+4 pts). Merovingian Franks: the Comitatus on foot may take heavy throwing spears (+2 pts). (Byzantium p.53)</characteristic>
              </characteristics>
            </profile>
            <profile id="841a-701c-d1d7-c3d0" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="0df5-8a2f-40a3-17f5" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="17c1-3c11-1e5b-fb16" type="atLeast"/>
