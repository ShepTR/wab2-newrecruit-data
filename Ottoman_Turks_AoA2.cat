                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">None</characteristic>
              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="6+">
                <conditions>
                <condition field="selections" scope="0e7e-b656-07ab-11ad" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4cd6-3de5-a804-3ad6" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="09e0-0445-1af9-0f14" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Infantry have a hand weapon. Warband rules 5 &amp; 6. May have shield (+1) and thrusting spear (+2) or halberd (+2). May have javelins (+1) or composite bow (+2). In later armies, 0-1 bow-armed unit may upgrade to handgun (+2) but may not then have shield. Units armed with missile weapons are Light Infantry. Other units may have Tethered Camels (+1) and may take Stakes (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="76ee-ca3a-298e-6235" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="0e7e-b656-07ab-11ad" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4cd6-3de5-a804-3ad6" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="c887-e6cc-727d-210d" name="Warband" hidden="false" targetId="e230-5072-4109-a786" type="rule"/>
