                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Serbian Knights have a hand weapon, heavy armour, lance, shield and warhorse. Shock Cavalry. First Charge. May have partial or full plate armour (free) and either cloth barding (+3) or barding (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="9516-94ac-b02a-d3e8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="2+">
                <conditions>
                <condition field="selections" scope="95af-2367-f4ea-5f7b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="db03-66cf-4dfa-ee74" type="lessThan"/>
