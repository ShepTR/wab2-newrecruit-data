                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="3+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="bab1-6682-72f2-d255" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e929-2d1b-1e30-ee32" type="lessThan"/>
