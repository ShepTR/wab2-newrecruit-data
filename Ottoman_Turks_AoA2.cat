                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">10</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">None</characteristic>
              </characteristics>
            </profile>
            <profile id="ffe5-85c8-cea6-63e3" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The Army General has a hand weapon, light armour, composite bow and shield. Army General. May have a thrusting spear (+2) or halberd (+2). May have heavy armour (+1). May ride a horse (+9) and this may have cloth barding (+3). Late army: The General may have partial plate armour (+2) and his horse may have plate barding (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="db03-a5a5-1598-55cd" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="bdd3-93e5-6573-cbcc" name="Armies of Antiquity v2 Common Rules" hidden="false" targetId="a162-a096-ebb0-3296" type="rule"/>
