            <profile id="4857-d1f5-7937-bbe9" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Guard Cavalry have a hand weapon, light armour, composite bow, thrusting spear and shield. Drilled. Eastern Shock Cavalry. May have heavy armour (+1) and cloth barding (+3) or barding (+4). May be Stubborn (+3) and Veteran (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="c11a-1683-1e11-74ef" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="bab1-6682-72f2-d255" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e929-2d1b-1e30-ee32" type="atLeast"/>
