            <profile id="5a22-29a7-5177-60ae" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All Skirmishers have hand weapon, sling and buckler. Skirmishers. May replace sling with javelins (free) or composite bow (+1). May upgrade buckler to shield (+1). Kurds may have throwing spear (+3) and light armour (+2).</characteristic>
              </characteristics>
            </profile>
            <profile id="9cba-25a3-f463-b0cb" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="c130-3e8d-3864-2821" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a1d7-12a7-ff2d-0f68" type="lessThan"/>
