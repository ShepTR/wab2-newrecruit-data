            </profile>
            <profile id="b98e-5d98-25d0-0487" name="Equipment and options (as printed in WAB2 army list)" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sarmatians, Alans and Huns. Heavy armour, sword, kontos. May have shield (+2) and barding (+4, -1 Movement). May replace kontos with bow and throwing spear (+2); Noble Steppe cavalry armed with bow and throwing spear are Nomad cavalry; those armed with a kontos fight in a dense formation (maximum rank bonus +2) and lose half their movement if they wheel more than 1". 0-2 units. Central and Eastern barbarian armies only. (Fall of the West p.48)</characteristic>
              </characteristics>
            </profile>
            <profile id="1b97-178b-96b3-a3f6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="3134-98a5-be7a-c543" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7cdb-866c-32b8-323b" type="atLeast"/>
