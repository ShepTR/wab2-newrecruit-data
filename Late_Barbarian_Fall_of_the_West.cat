            </profile>
            <profile id="8ded-9307-21ff-cd8a" name="Equipment and options (as printed in WAB2 army list)" publicationId="37b4-aae5-6830-d590" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons. No options. Any unit that includes a pagan priest hates all its enemies; a Catholic priest hates enemies who are pagans or Arian Christians; an Arian priest hates enemies who are pagans or Catholic Christians. If an army includes a priest his opponent must declare a religious alignment. Pagan or Roman Catholic priests may be attached to a Roman army; pagan or Arian Christian priests to a Barbarian army. 0-1. (Fall of the West p.45)</characteristic>
              </characteristics>
            </profile>
            <profile id="9317-0192-bcb6-2e5d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
