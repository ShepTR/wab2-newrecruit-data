            <profile id="c582-561d-949c-6a71" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The Captain has a hand weapon, heavy armour and shield. He may ride a horse (+9). If dismounted, he may replace the shield with a double handed weapon (+2) and he may have partial plate armour (free).</characteristic>
              </characteristics>
            </profile>
