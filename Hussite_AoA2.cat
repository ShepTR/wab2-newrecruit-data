              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Crossbowmen have a hand weapon and light crossbow. Skirmishers. They may have light armour (+2).</characteristic>
              </characteristics>
            </profile>
            <profile id="7c0a-d5e6-5a50-0f66" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="94d1-f252-a0ac-026f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="944f-ed88-3019-56c5" type="atLeast"/>
                </conditions>
              </modifier>
