              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Improvised weapon and javelins. May have buckler (free). Every second unit may exchange javelins for short bow or sling (free); such units may not be larger than the smallest javelin-armed unit.</characteristic>
              </characteristics>
            </profile>
            <profile id="3789-632b-46c4-440d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="6+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="e5d5-21be-e525-66b3" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4f38-6b51-cf11-46cb" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
