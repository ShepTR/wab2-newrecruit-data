              </infoLinks>
          <rules>
            <rule id="e14a-953a-3ccb-89a5" name="Army General (+25 pts; if no other Army General)" hidden="false">
              <description>Army General - if no other Army General is taken, a Libationer may be made Army General for +25 pts.</description>
            </rule>
          </rules>
          <costs>
