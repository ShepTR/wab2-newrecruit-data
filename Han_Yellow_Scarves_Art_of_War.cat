              </modifiers>
            </profile>
            <profile id="d1d1-7b2a-72b0-d5d6" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon. May have exotic weapons (+2 pts, count as additional hand weapons) or spear tipped halberd (+2). May have horse (free, M8). One speciality: Strongman (S5, W2; +15), Swift as the Wind (M6; +5) or Skilled Archer (compound bow; +2). Warrior of Legend. Independent Character: although a hero may accompany and lead a unit, his Leadership cannot be used by the unit; he cannot use the Army General or Sacred Banner Bearer for Leadership tests. Dodge Save: disdaining armour they receive a 5+ special dodge save not modified by Strength. 0-1. (The Art of War p.113)</characteristic>
              </characteristics>
            </profile>
            <profile id="7674-ea65-baaf-bffc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="cf97-12dc-699a-c933" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="0c4e-6e59-60d7-2e68" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
