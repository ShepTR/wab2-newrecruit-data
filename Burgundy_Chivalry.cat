            </profile>
            <profile id="04a8-d1ca-2c20-64dc" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and full plate armour. May have a halberd (+4 pts) or a double-handed weapon (+4 pts) if dismounted. May have a lance (+4 pts) and must have a horse (free) or warhorse (+4 pts) if mounted. The warhorse may have plate barding (+6 pts). Army General. Stubborn if dismounted. 0-1. (Armies of Chivalry p.60)</characteristic>
              </characteristics>
            </profile>
            <profile id="2041-b3f2-0378-8bb6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="2+">
                <conditions>
                <condition field="selections" scope="3c07-7899-b49c-7e5a" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="db58-4b6a-50a4-3574" type="atLeast"/>
