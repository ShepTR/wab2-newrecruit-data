                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Halberd and heavy armour. May wear partial plate armour (+2 pts). Veteran. May be in Mixed Order with Archers/Ordonnance Longbowmen, Crossbowmen, or Handgunners. 0-1 unit. (Armies of Chivalry p.61)</characteristic>
              </characteristics>
            </profile>
            <profile id="c88c-d472-381c-a582" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="356c-9c51-5468-77d3" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9437-32f8-f720-2739" type="atLeast"/>
