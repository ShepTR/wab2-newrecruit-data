                <conditions>
                <condition field="selections" scope="f9fa-d663-28f8-bd0f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ddb0-7b39-a6cd-dff1" type="atLeast"/>
