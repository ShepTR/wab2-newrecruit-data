            <profile id="f37e-b7fa-9dc6-331f" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Has a hand weapon, light armour and shield. Army General. May have javelins (+2), throwing or thrusting spear (+3), or lance (+6). May have heavy armour (+1), and may be mounted on a warhorse (+7).</characteristic>
              </characteristics>
            </profile>
            <profile id="bbb2-1369-157c-4e30" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
