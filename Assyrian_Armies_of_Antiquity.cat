                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="6f08-7bba-3491-7058" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword and light armour. Archers armed with bow and shield bearers armed with large shields. A unit includes equal numbers of both types. Shield bearers may swap shields for pavises (+1 pt). Models in a unit can have different weapon combinations. Archers in the second rank may shoot at full effect as long as the unit does not move. If shield bearers swap shields for pavises use the rules for Spara from the Achaemenid Persians list. (Armies of Antiquity p.11)</characteristic>
              </characteristics>
            </profile>
            <profile id="ef8b-3a3d-cc0c-2ad6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="7bdb-4617-406d-1cdf" name="Heavy Slingers" hidden="false" targetId="eb7b-7b63-2ee3-f972" type="rule"/>
            <infoLink id="dff7-2d78-5da2-dd6e" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="69af-0b32-4183-320d" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="9"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
