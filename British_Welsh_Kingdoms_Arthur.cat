            </profile>
            <profile id="524b-7dc0-d844-d39b" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelins and shield. May have light armour (+3), throwing spears (+4), horse (+8). One Tiern may be upgraded to Army Standard Bearer (+15); if no Rex, one Tiern may be upgraded to Army General (+25). One Character Advantage, two if Army General (Dumnonia: one, two if Army General). (The Age of Arthur p.39)</characteristic>
              </characteristics>
            </profile>
            <profile id="4cc5-f747-fa27-6441" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="de75-76ab-e300-0ca8" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a234-6264-9641-6f32" type="atLeast"/>
                <condition field="selections" scope="de75-76ab-e300-0ca8" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="c0f2-4c00-2e75-cefb" type="lessThan"/>
