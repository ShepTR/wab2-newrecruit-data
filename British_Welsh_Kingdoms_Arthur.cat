                <conditions>
                <condition field="selections" scope="d8bc-12be-dc5c-f076" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a114-6a1a-3149-5111" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="2efe-522a-ac4a-2569" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, throwing spear, javelins and shield. May have light armour (+3). On foot they are Light Infantry (but in the British Kingdoms composition they lose that status and fight as ordinary heavy infantry with up to a +3 rank bonus). Warband rules 1 and 2. Run for the Woods in the Welsh and Dumnonian compositions. Welsh Kingdoms in the West: thrusting spears may be taken at no cost. 0-1 Teulu unit (foot or mounted). (The Age of Arthur p.40)</characteristic>
              </characteristics>
            </profile>
            <profile id="6ae3-45d3-1e2a-0add" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="d8bc-12be-dc5c-f076" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a114-6a1a-3149-5111" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="78b0-cba7-a93c-cffe" name="Warband Psychology (rules 1 &amp; 2)" hidden="false" targetId="2370-1c8e-57c4-1fdf" type="rule"/>
