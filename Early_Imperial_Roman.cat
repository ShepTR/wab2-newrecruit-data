            <infoLink id="993c-82e5-d730-fe02" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
            <infoLink id="25d1-904b-ea07-f491" name="Large Shield" hidden="false" targetId="8367-11b2-7778-977f" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="17"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
