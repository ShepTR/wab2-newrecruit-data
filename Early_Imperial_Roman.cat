        <selectionEntry id="3a1e-5039-4254-ee0c" name="Raw" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3884-e23e-19a4-5577" type="min"/>
          </constraints>
          <profiles>
            <profile id="68ef-f2eb-4e49-f01c" name="Raw" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
              </modifier>
              </modifiers>
            </profile>
            <profile id="7a43-32af-2e02-f4f2" name="Equipment and options (as printed in AoA2)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, large shield and heavy throwing spear. Seasoned Legionaries are Drilled.

Elite Legionaries are Drilled and Stubborn. Seasoned and Elite Legionaries may be Veteran (+1). Legionary units are led by a Centurion who costs 10 points rather than the usual 5-point leader cost. The Centurion increases the Ld of the unit by 1. He counts as a normal leader in every other respect.

Warriors have hand weapon, throwing spear, shield, warband, and may have light armour (+2)

Light Infantry have hand weapons, javelins, shield, light infantry, warband, and may have throwing spear (+3).

Skirmishers have hand weapons, javelins, buckler, skirmish, warband, and may exchange javelins for sling (-1) or bow (free).</characteristic>
              </characteristics>
            </profile>
            <profile id="dbce-da3f-9302-6f8e" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="cccd-98e0-8091-0183" name="Heavy Throwing Spear" hidden="false" targetId="26ae-ef02-1f24-a490" type="profile"/>
            <infoLink id="9ca3-70d6-c099-3a55" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
