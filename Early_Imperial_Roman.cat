                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="730a-35c2-12ea-c01e" name="Equipment and options (as printed in AoA2)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Auxiliaries and light cohorts have a hand weapon, throwing spear or thrusting spear and shield. May have light armour (+2) and may be Drilled (+2) and Veteran (+1). One unit of auxiliaries may be upgraded to Elite (Ld 8, +1). Light Cohorts are Light Infantry.

Archers have a hand weapon, composite bow and buckler. Light Infantry. May have light armour (+2) and be Drilled (+2) and Veteran (+1). One unit may be upgraded to Elite (Ld8, +1).</characteristic>
              </characteristics>
            </profile>
            <profile id="9099-2cfd-9330-4e3c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">5+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="5208-cae6-9f88-ae45" name="Drilled" hidden="false" targetId="d6b3-51b2-64eb-2b91" type="rule"/>
            <infoLink id="23e3-929d-2b5b-e93d" name="Veteran" hidden="false" targetId="4c9b-509e-486d-f0af" type="rule"/>
            <infoLink id="eebd-f0de-cf4f-2388" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="f7a9-6cec-7111-4336" name="Bow" hidden="false" targetId="5d29-ba1e-8299-8085" type="profile"/>
            <infoLink id="6212-40f4-9600-28ff" name="Buckler" hidden="false" targetId="aa05-2e85-a1d8-8d69" type="profile"/>
            <infoLink id="d282-dc81-9a90-df6a" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
