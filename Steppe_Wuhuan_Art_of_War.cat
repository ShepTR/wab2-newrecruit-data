            <profile id="0f57-0c6b-1a61-4278" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a sword, bow and light armour. May have lamellar armour (+2 pts, replaces light armour), dagger axe or kontos (+2 pts) and shield (+2 pts). Eastern Shock Cavalry. 0-2. (The Art of War p.77)</characteristic>
              </characteristics>
            </profile>
            <profile id="51f3-8b2e-877a-b428" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="f445-b8fe-0bb8-9d40" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9b9f-e86e-4151-4f13" type="atLeast"/>
