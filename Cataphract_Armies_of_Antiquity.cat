            <profile id="0b1d-235a-96ca-ddc0" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon. May have light armour (+3 pts), heavy armour (+4 pts). May ride a warhorse (+4 pts), which may have barding (+4 pts). 0-1. (Armies of Antiquity p.27)</characteristic>
              </characteristics>
            </profile>
            <profile id="5639-b4fa-cdb7-2a9d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="22df-5d3b-ab64-403a" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="6b00-35f9-b73b-d44a" type="atLeast"/>
