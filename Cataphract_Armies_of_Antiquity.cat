            </profile>
            <profile id="82af-2ac5-478c-85a3" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, kontos and light armour on a barded horse. May have additional hand weapons (+2 pts), javelin/darts (+2 pts), short bow (+2 pts), buckler (+1 pt), shield (+2 pts) and heavy armour (+1 pt). Cataphracts count rank bonus up to +3 and may not march. (Armies of Antiquity p.27)</characteristic>
              </characteristics>
            </profile>
            <profile id="668f-2fe0-5d90-0dfe" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
