              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, thrusting spear and shield. May have large shield (+1 pt). Militia cause fear in all enemy troops apart from skirmishers. (Armies of Antiquity p.27)</characteristic>
              </characteristics>
            </profile>
            <profile id="ba8a-4f12-2db4-a9b8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="8717-054d-0dfc-6d5b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4101-89f1-0455-dd65" type="atLeast"/>
                </conditions>
