            <profile id="3a3b-e682-547c-be96" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Improvised weapon and javelins. May have buckler (free) and may exchange javelins for sling (free). There may not be more sling units than javelin units, and no sling unit may be larger than the smallest javelin unit in the army.</characteristic>
              </characteristics>
            </profile>
            <profile id="0c4d-9226-c1ab-3152" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="6+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="993a-835d-731d-4207" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b923-08af-0e56-82f8" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
