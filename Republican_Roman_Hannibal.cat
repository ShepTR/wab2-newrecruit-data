              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Knife, javelins, buckler. Light Cavalry, Feigned Flight, Parthian Shot. May not outnumber any other unit of cavalry. (Hannibal p.60)</characteristic>
              </characteristics>
