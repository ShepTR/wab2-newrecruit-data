            <profile id="0794-c4d5-028c-85af" name="Equipment and options (as printed in WAB2 army list)" publicationId="fc9f-8438-629b-e92d" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword. Light armour +3, shield +2 or (on foot) large shield +3. May ride a horse (free). Army General, Drilled, Stubborn. The second Consul may only be taken if the army exceeds 2,000 points and acts as a second Army General. (Hannibal p.57)</characteristic>
              </characteristics>
            </profile>
            <profile id="d11e-a957-99e6-05ce" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
