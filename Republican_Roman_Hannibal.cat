            <profile id="5958-cb93-1478-a269" name="Equipment and options (as printed in WAB2 army list)" publicationId="fc9f-8438-629b-e92d" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword. Light armour +3, shield +2 or (on foot) large shield +3. May ride a horse (free). Army Standard Bearer, Drilled, Stubborn. (Hannibal p.56)</characteristic>
              </characteristics>
            </profile>
            <profile id="ce00-b97b-fac8-35f6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
