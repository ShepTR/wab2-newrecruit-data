                <conditions>
                <condition field="selections" scope="fdec-083c-6532-50aa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e387-d28b-74ce-f74e" type="lessThan"/>
                <condition field="selections" scope="fdec-083c-6532-50aa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4edd-43ac-ce87-97d7" type="atLeast"/>
