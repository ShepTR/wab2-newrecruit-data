                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b0a5-d097-9a24-5dd7" type="max"/>
                <constraint field="selections" scope="parent" value="0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c316-956f-0371-87ed" type="min"/>
              </constraints>
              <!-- def-link -->
              <!-- sw-rule-Xyston -->
              <infoLinks>
                <infoLink id="45cc-fb5b-da6d-4d46" name="Xyston" hidden="false" targetId="e00d-b9ca-4675-4334" type="rule"/>
              </infoLinks>
          <rules>
            <rule id="9f08-9648-bf4c-cacd" name="Xyston" hidden="false">
              <description>May ride a warhorse +4 pts; mounted may have javelins +2 pts, thrusting spear +2 pts or xyston +3 pts.</description>
            </rule>
          </rules>
          <costs>
                <cost name="pts" typeId="points" value="3"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <costs>
            <cost name="pts" typeId="points" value="165"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
