              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="fdec-083c-6532-50aa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e387-d28b-74ce-f74e" type="atLeast"/>
