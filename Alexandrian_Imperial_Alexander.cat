              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelin, and pelta (buckler). 0-1 unit of Agrianians may replace javelins with slings +1 pt. Skirmishers. One Agrianian unit may be chosen for each two other skirmisher units. (Alexander the Great p.22)</characteristic>
              </characteristics>
            </profile>
            <profile id="fee8-209f-fa52-9a8c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
