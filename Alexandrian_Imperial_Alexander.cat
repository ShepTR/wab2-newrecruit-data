            <profile id="5de1-3962-016c-ccca" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword and xyston. Persian Companions may have light armour +3 pts, or heavy armour +4 pts. Xyston. May fight in Wedge formation. 0-1 unit. (Alexander the Great p.25)</characteristic>
              </characteristics>
            </profile>
            <profile id="aedd-f8d1-decb-0194" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="fdec-083c-6532-50aa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e387-d28b-74ce-f74e" type="atLeast"/>
                <condition field="selections" scope="fdec-083c-6532-50aa" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4edd-43ac-ce87-97d7" type="lessThan"/>
