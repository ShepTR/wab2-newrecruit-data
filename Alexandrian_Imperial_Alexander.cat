            <profile id="5656-7dea-6652-bed5" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword and xyston. Any unit may have light armour +2 pts, or heavy armour +3 pts. Companions may substitute javelins and shields for xyston on special commando operations (not built). Wedge formation.  (Alexander the Great p.21)</characteristic>
              </characteristics>
            </profile>
            <profile id="5b10-407d-d136-3e48" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="50d2-fd2a-80be-87d3" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f4bc-6997-b9cc-69d1" type="atLeast"/>
