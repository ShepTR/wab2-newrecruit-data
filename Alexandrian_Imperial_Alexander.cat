            <profile id="3281-da09-a1a5-b50b" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword. On foot may have thrusting spear (free; entered at +2 pts as it is +2 mounted), javelins +2 pts, or pike +3 pts; shield +2 pts, or large shield +3 pts. Light armour +3 pts, or heavy armour +4 pts. May ride a warhorse +4 pts; mounted may have javelins +2 pts, thrusting spear +2 pts or xyston +3 pts. Army General. Drilled. 0-1 Army General. (Alexander the Great p.20)</characteristic>
              </characteristics>
            </profile>
            <profile id="2856-2aba-f59d-f2b8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
