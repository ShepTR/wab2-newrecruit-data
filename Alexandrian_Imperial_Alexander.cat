              <!-- def-link -->
          <rules>
            <rule id="6ba1-ce89-9a11-7051" name="Pike" hidden="false">
              <description>The officer on foot may have thrusting spear (free; entered at +2 pts), javelins +2 pts, or pike +3 pts, shield +2 pts or large shield +3 pts.</description>
