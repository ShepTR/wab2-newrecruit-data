            </profile>
            <profile id="4985-e1f4-5abb-56c1" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelins and shield. May have light armour +2 pts. Drilled. Light Infantry. Mixed Armour. 0-1 unit may be upgraded to the Agema or Royal Hypaspists for +3 pts per model, and is Stubborn. One Hypaspist unit may be chosen for each two Pezhetairoi, Epigonoi or Experimental Phalanx units in the army. Optional equipment: Hypaspists may replace their equipment with sword, pike &amp; shield, or thrusting spear &amp; large shield; they then become a Drilled Macedonian phalanx and not Light Infantry, and their Movement is reduced to 4". All Hypaspists in the army must have the same equipment and options (the Movement change and the large shield are not applied automatically). (Alexander the Great p.21)</characteristic>
              </characteristics>
            </profile>
            <profile id="146b-e1b3-54dd-48c6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="917b-83da-f703-73e2" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e667-aeba-4408-87a3" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
