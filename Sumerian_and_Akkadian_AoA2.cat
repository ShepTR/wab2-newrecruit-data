              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Royal Guard have hand weapon, two-handed weapon and light armour. Royal Guard: may throw sticks (javelins) (+1 point). Nim have hand weapon and javelins. Skirmishers. Chariot Runners.</characteristic>
              </characteristics>
            </profile>
            <profile id="de03-02cc-1a00-a9f2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="da3e-04a0-628d-27f1" name="Skirmishers (Art of War)" hidden="false" targetId="5c5e-9491-3100-c162" type="rule"/>
            <infoLink id="c425-2a26-b14c-e109" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="0099-04dd-328b-892b" name="Double-handed Weapon" hidden="false" targetId="bebe-c4da-722c-c475" type="profile"/>
            <infoLink id="20bf-f870-1da5-a7b8" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
          </infoLinks>
