            <profile id="ab7c-32ee-3b7c-624c" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Nobles have hand weapon and javelins. Expert Horsemen. Levy. Shock Cavalry. May have light armour (+2) and short bow (+2) or replace javelins with short bow (free). May have half barding (+2) and thrusting spear (+3) in the Xerxes period only.</characteristic>
              </characteristics>
            </profile>
            <profile id="df60-35d3-10a6-3dbd" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="da1e-2061-3ea5-a25d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f255-a2c1-dbe9-ecc5" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
