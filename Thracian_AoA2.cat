              </characteristics>
            </profile>
            <profile id="4343-5c90-b85f-84fd" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Getae have hand weapon, javelins, composite bows and shields. Light Cavalry. Stealth. Feigned Flight. Parthian Shot. May have throwing spears (+3) and light armour (+2). All Cavalry may be upgraded to Warband for (+1) point a model.</characteristic>
              </characteristics>
            </profile>
            <profile id="ffd9-b61e-f379-0205" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="568b-1b0d-041f-0654" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="eaee-9042-0132-f74f" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="d2f2-2691-a431-0b23" name="Stealth" hidden="false" targetId="3c5c-8535-997a-4c57" type="rule"/>
            <infoLink id="7031-b0de-c1e6-1cdd" name="Feigned Flight" hidden="false" targetId="23ce-0721-aa10-1f4d" type="rule"/>
