              </modifiers>
            </profile>
            <profile id="64ee-ef01-0c4a-9e4c" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, throwing or thrusting spear and shield. On foot: large shield (+2), javelins (+1), light armour (+2), heavy throwing spears (+2). May form Shieldwall. 0-1 unit of Commanipulares (foot or mounted). (The Age of Arthur p.27)</characteristic>
              </characteristics>
            </profile>
            <profile id="4b8b-e2c2-fd68-b70e" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="55ad-4f26-eda9-2ead" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8aca-ddbb-b812-080a" type="atLeast"/>
                <condition field="selections" scope="55ad-4f26-eda9-2ead" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a4e1-9a3b-bc27-55ff" type="lessThan"/>
