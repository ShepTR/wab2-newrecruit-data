              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="55ad-4f26-eda9-2ead" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8aca-ddbb-b812-080a" type="lessThan"/>
                <condition field="selections" scope="55ad-4f26-eda9-2ead" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a4e1-9a3b-bc27-55ff" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
