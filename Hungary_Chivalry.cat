                <characteristic name="A" typeId="ee87-e286-4768-82be">2</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">6</characteristic>
              </characteristics>
            </profile>
            <profile id="3db0-4f8d-8a4d-83ed" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon. May have a double-handed weapon (+4 pts). Warband. The Religious Personality must lead one unit of Crusading Peasants. The Religious Personality and his unit are subject to frenzy. Frenzy is lost either by the Religious Personality's death, or by the unit being broken in combat. Any other Crusading Peasant units within 12" of the Religious Personality may use his Leadership. 0-1. (Armies of Chivalry p.50)</characteristic>
              </characteristics>
            </profile>
            <profile id="4c82-7370-24c3-40fb" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="4a91-b2e1-fdca-12b5" name="Warband" hidden="false" targetId="e230-5072-4109-a786" type="rule"/>
            <infoLink id="7383-0806-f871-5324" name="Frenzy (Religious Personality)" hidden="false" targetId="2a62-c9cc-2d6a-188a" type="rule"/>
