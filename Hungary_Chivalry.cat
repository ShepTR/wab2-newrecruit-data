            <profile id="1e52-dee7-9a1a-5a06" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, partial plate armour and shield. May wear full plate armour (free if mounted, +2 pts if dismounted). Must have a horse (free) or warhorse (+4 pts) if mounted. The warhorse may have cloth (+4 pts) or plate (+6 pts) barding. Army Standard Bearer. Stubborn if with the Royal Banderium. 0-1. (Armies of Chivalry p.50)</characteristic>
              </characteristics>
            </profile>
            <profile id="74c0-7ebf-94d6-4daf" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
