              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Horse, hand weapon and bow. May have a buckler (+2 pts). Skirmishers and Nomad Cavalry. (Armies of Chivalry p.51)</characteristic>
              </characteristics>
