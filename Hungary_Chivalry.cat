            </profile>
            <profile id="0737-adde-89a7-79ab" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and shield. May wear partial plate (+2 pts) or full plate armour (+4 pts). May have a halberd (+2 pts) or a double-handed weapon (+2 pts). One unit may be upgraded to WS5 and Stubborn as Royal Banderium (+6 pts). (Armies of Chivalry p.50)</characteristic>
              </characteristics>
            </profile>
            <profile id="684b-9c2f-3734-59c8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="d2cf-f78c-d61a-48f9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fd29-b44c-fdc8-f0e9" type="atLeast"/>
                <condition field="selections" scope="d2cf-f78c-d61a-48f9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d6f3-aae6-28ef-e25e" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="d2cf-f78c-d61a-48f9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fd29-b44c-fdc8-f0e9" type="lessThan"/>
                <condition field="selections" scope="d2cf-f78c-d61a-48f9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d6f3-aae6-28ef-e25e" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
