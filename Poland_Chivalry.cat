            </profile>
            <profile id="c84e-75ab-cc36-7d61" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, handgun and light armour. May upgrade to heavy armour (+2 pts) or partial plate armour (+3 pts). Skirmishers. For every Handgunner model, at least two Militia models must be taken (not enforced). (Armies of Chivalry p.45)</characteristic>
              </characteristics>
            </profile>
            <profile id="db8b-32c1-75ba-7342" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="10a1-b22c-ef15-ccbc" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a39d-0273-0406-8675" type="atLeast"/>
