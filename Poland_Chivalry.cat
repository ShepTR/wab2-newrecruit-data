        <selectionEntry id="4302-6fce-4993-5ff9" name="War Wagon" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="a999-5f6f-0ec1-5f49" type="min"/>
          </constraints>
          <profiles>
            <profile id="9f98-865d-0874-fb11" name="War Wagon" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">6</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">-</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">-</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">-</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">6</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">4</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">-</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">-</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">-</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">-</characteristic>
              </characteristics>
            </profile>
            <profile id="7d60-1aad-1468-b140" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The cost of the war wagon includes six crewmen: three armed with halberds and three with crossbow or handgun, all with light armour. A team of 2-4 horses. War wagons may be single models (no Leader, Standard Bearer or Musician) or grouped in units of at least three models. One wagon per unit may include a tarasnices (palisade gun) for +20 pts (not built). Up to one war wagon for every 1,500 army points. (Armies of Chivalry p.45)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
