          <profiles>
            <profile id="470d-56ae-542c-de05" name="Tabor Wagon" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">-</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">-</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">-</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">-</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">6</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">3</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">-</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">-</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">-</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">-</characteristic>
              </characteristics>
            </profile>
            <profile id="74dc-67c7-df43-19f2" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Each wagon has from 5-10 defenders armed with hand weapon, bow and light armour; the defenders of each wagon are a separate unit. May exchange bow for thrusting or throwing spear (free) or halberd (+1 pt), or for crossbow or handgun (+6 pts). Different Weapons. The Wagon Tabor is deployed as one unit and placed first; the wagons are up to 3" apart with the end wagons touching the owning player's table edge; it may not move after deployment. Each undefended wagon at the end of the game gives the opponent +15 Victory points. Polish Wagon Tabors may be placed in groups of 2-4 wagons at a right angle to, and with one wagon contacting, the owning player's baseline; they cannot be deployed outside the deployment area. Up to one Wagon for every 500 army points. (Armies of Chivalry p.45)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="26ea-6dce-5381-fb8a" name="Wagon Tabor (Chivalry)" hidden="false" targetId="b1b5-e018-17f8-3d3e" type="rule"/>
