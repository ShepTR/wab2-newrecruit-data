              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Spanish cavalry have hand weapon, throwing spear and shield. May have light armour (+2) and javelins (+1). May exchange throwing spear for thrusting spear (free). Light Cavalry if Unarmoured. Armoured Spanish cavalry may upgrade to WS4, BS4 heavy cavalry (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="056c-a77c-c630-d69c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="9859-899e-d76e-06b7" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="551e-b5e0-7cf8-262b" type="atLeast"/>
