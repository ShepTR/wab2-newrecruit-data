              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Numidian cavalry have improvised weapon, javelins and buckler. They are Light Cavalry with Feigned Flight and Parthian Shot. There must be at least one Numidian cavalry unit in the army.</characteristic>
              </characteristics>
            </profile>
            <profile id="d33b-9594-c7f1-b7c3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">5+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="288e-dc2e-c79b-1037" name="Feigned Flight" hidden="false" targetId="23ce-0721-aa10-1f4d" type="rule"/>
            <infoLink id="b048-0e07-0685-2585" name="Parthian Shot" hidden="false" targetId="78a9-d49d-4efd-85c1" type="rule"/>
