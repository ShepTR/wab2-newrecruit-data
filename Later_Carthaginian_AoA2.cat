            <profile id="ed4c-1d21-4482-ccbe" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Standard bearer has hand weapon, light armour and large shield. May ride a horse (+8) in which case exchanges large shield for shield. May be Veteran (+1). Army Standard Bearer.</characteristic>
              </characteristics>
            </profile>
            <profile id="701f-ff71-b898-dff0" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
