              <infoLinks>
                <infoLink id="36b5-654d-b563-9dec" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
              </infoLinks>
          <rules>
            <rule id="39d4-e1da-08b2-91b9" name="Army General (if no other Army General)" hidden="false">
              <description>If no other Army General is taken, a single Infante may be made Army General for +25 pts (in Asturias &amp; the Early Christian Kingdoms the Army General may only be an Infante).</description>
            </rule>
          </rules>
