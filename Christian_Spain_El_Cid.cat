            <profile id="c042-aad2-3df2-33a7" name="Equipment and options (as printed in WAB2 army list)" publicationId="2127-dab1-0af6-7421" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Javelins, hand weapon. May have throwing spears (+2 pts). May have a shield (+1 pt). Light Troops (Light Cavalry). Feigned Flight. Reconquista: may have light armour (+2 pts per model). (El Cid p.13)</characteristic>
              </characteristics>
            </profile>
            <profile id="e28e-0ffc-8188-c9c1" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="37f2-7c0e-3899-35b1" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bfe4-c65b-255a-5e1a" type="atLeast"/>
