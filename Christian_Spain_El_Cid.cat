            </profile>
            <profile id="004a-6896-2847-8d74" name="Equipment and options (as printed in WAB2 army list)" publicationId="2127-dab1-0af6-7421" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Javelins and hand weapon. May have throwing spears (+2 pts); may have shield (+1 pt). May exchange javelins for bow (+3 pts); bow-armed Mercenary Jinetes are Expert Horsemen. Light Cavalry. Feigned Flight. Aliados y Mercenarios: may have a leader, standard bearer and musician as normal; roll a dice the first time each unit moves, charges or shoots (on a 1 it stays stationary); may not benefit from the Army General or Army Standard Bearer abilities (they may be led by any appropriate character). One Aliados y Mercenarios unit may be personally led by the Army General and is then exempt from these rules. (El Cid p.55)</characteristic>
              </characteristics>
            </profile>
            <profile id="a465-5a97-d4dc-10f2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="b3b0-d5ad-49a8-ea3c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7a43-e035-f6bc-2de6" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
