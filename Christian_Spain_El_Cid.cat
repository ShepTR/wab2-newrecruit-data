            <profile id="4bf1-2ca9-ef8e-9f68" name="Equipment and options (as printed in WAB2 army list)" publicationId="2127-dab1-0af6-7421" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Horse, thrusting or throwing spear, light armour, sword, shield. May ride a warhorse (+4 pts). May exchange light armour for heavy armour (+1 pt). Ferocious Charge. May count a Rank Bonus of up to +1 in combat. Not available in Asturias. Reconquista: may exchange thrusting spears for lances (+4 pts per model) and have horse barding (+2 pts per model). (El Cid p.13)</characteristic>
              </characteristics>
            </profile>
            <profile id="3f5a-ec0a-cbfe-f7e2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="f86f-a03b-e484-b304" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d45b-edfe-6197-7088" type="lessThan"/>
