                <conditions>
                <condition field="selections" scope="42d0-3b04-611f-86cb" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="18ef-1bcf-2a1a-0c99" type="atLeast"/>
