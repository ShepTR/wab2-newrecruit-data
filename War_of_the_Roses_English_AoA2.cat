              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Border Infantry have hand weapon, thrusting spear and shield. Every second unit may be mounted on horses (+10), M increased to 8).</characteristic>
              </characteristics>
            </profile>
            <profile id="820d-3f52-5f7e-eefb" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
