              </modifiers>
            </profile>
            <profile id="84d8-1107-6fe6-7c26" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A hand weapon, and some sort of hellish musical instrument. May ride a horse (+8 pts). The Mehterhane characters must be placed in the same unit as the Army General; the unit is immune to panic and for every Mehterhane model in the unit 1" is added to the Army General's Leadership radius, up to a maximum of +3". 0-3. (Armies of Chivalry p.52)</characteristic>
              </characteristics>
            </profile>
            <profile id="fcb1-2b68-db75-0c37" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="bc71-ab9e-1bde-22be" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="fc55-7fdc-6c7c-9ec2" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
