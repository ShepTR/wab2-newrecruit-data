            </profile>
            <profile id="385e-6768-2a6a-ae78" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, shield, bow and thrusting spear. May have light armour (+2 pts). Every other unit of Sipahis may have heavy armour (+3 pts) and may be Drilled (+1 pt). Open Order. With heavy armour they are Eastern Shock Cavalry; otherwise subject to Eastern Shock Cavalry rule 1. Ghazi armies: 0-2 Sipahi units, which may not take heavy armour; Conquest armies: at least one unit of Sipahis must be chosen. (Armies of Chivalry p.53)</characteristic>
              </characteristics>
            </profile>
            <profile id="0c1b-a02d-13fe-d9c8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="5ba5-a430-b486-b857" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bfc0-be2a-aa17-99eb" type="atLeast"/>
                <condition field="selections" scope="5ba5-a430-b486-b857" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2c0b-50d8-6540-ed7f" type="lessThan"/>
                </conditions>
              </modifier>
