            <profile id="814b-1f33-ff60-d572" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon. May have shield (+2 pts), light armour (+3 pts), heavy armour (+4 pts), thrusting spear (+2 pts) and bow (+3 pts). May ride a horse (+8 pts) and take half-barding (+4 pts) or cloth barding (+4 pts). One Beylerbegh without spear may be upgraded to Army Standard Bearer (+15 pts). (Armies of Chivalry p.52)</characteristic>
              </characteristics>
            </profile>
            <profile id="f16c-4483-1d0a-c062" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
