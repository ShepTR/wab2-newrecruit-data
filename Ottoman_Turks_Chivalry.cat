            <profile id="e08f-8721-c241-5351" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, lance, heavy armour, shield, and warhorse. May have partial plate or full plate armour instead of heavy armour (+1 pt), and cloth barding (+4 pts). First Charge. Vlastelas must always pursue enemy units that they have defeated in close combat. 0-2 units. (Armies of Chivalry p.53)</characteristic>
              </characteristics>
            </profile>
            <profile id="2acd-7abb-9b4a-3bac" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="7c0d-90ef-0e8c-064b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="51b2-7028-9ffb-fdf2" type="lessThan"/>
