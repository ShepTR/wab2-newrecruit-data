        <selectionEntry id="aba0-1c49-e976-6d62" name="Janissary" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="abcb-bf30-0589-62e5" type="min"/>
          </constraints>
          <profiles>
            <profile id="7241-8aef-ef7f-be61" name="Janissary" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">5</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">6+</characteristic>
              </characteristics>
            </profile>
            <profile id="9c7d-193a-dd56-43ab" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, shield, and either bow or halberd. May be Drilled (+1 pt). Halberdiers may have bows (+2 pts). In 0-2 units, models without halberds may exchange bow for either crossbow (+2 pts), or handgun (+2 pts). Janissary Halberdiers may combine in Mixed Order with Janissaries solely armed with missile weapons. May have Stakes (+30 pts per unit), or Camels (+10 pts per unit), or defend an Ottoman Wagon Tabor. One unit may be Solak Janissaries (+3 pts), who are Stubborn; the Solaks must be led by the Army General and must be the smallest Janissary unit in the army. Open Order (count Rank Bonus up to +2 in open ground). Janissaries may re-roll their first failed Panic test. Can only be chosen if an Army General has been chosen as well. Conquest armies only. (Armies of Chivalry p.53)</characteristic>
              </characteristics>
            </profile>
            <profile id="d394-bd84-0ec3-719a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8009-9de3-0b60-fd59" name="Open Order" hidden="false" targetId="6b07-0a99-df48-7a76" type="rule"/>
            <infoLink id="f8f5-72d5-d339-3a46" name="Mixed Order (Chivalry)" hidden="false" targetId="5112-f682-7dc3-3910" type="rule"/>
            <infoLink id="2c0f-a128-bfa6-9e50" name="Camels" hidden="false" targetId="61e0-6659-ac78-a422" type="rule"/>
