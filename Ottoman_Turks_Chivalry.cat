                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">-</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">-</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">-</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">-</characteristic>
              </characteristics>
            </profile>
            <profile id="0b4f-69f8-0c4a-ed0a" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Each wagon has from 5-10 defenders armed with hand weapon, bow and light armour; the defenders of each wagon are a separate unit. May exchange bow for thrusting or throwing spear (free) or halberd (+1 pt), or for crossbow or handgun (+6 pts). Different Weapons. The Wagon Tabor is deployed as one unit and placed first; the wagons are up to 3" apart with the end wagons touching the owning player's table edge; it may not move after deployment. Each undefended wagon at the end of the game gives the opponent +15 Victory points. Ottoman Wagon Tabor: in Conquest Ottoman armies the Janissaries replace the regular wagon defenders; the Army General, the Army Standard Bearer and all the Janissaries must deploy inside; the wagons are paid for out of the Janissary allowance. (Armies of Chivalry p.53)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="f7c5-ad0b-6e82-458a" name="Wagon Tabor (Chivalry)" hidden="false" targetId="b1b5-e018-17f8-3d3e" type="rule"/>
