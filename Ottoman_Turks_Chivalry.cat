                <conditions>
                <condition field="selections" scope="bc71-ab9e-1bde-22be" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="fc55-7fdc-6c7c-9ec2" type="atLeast"/>
