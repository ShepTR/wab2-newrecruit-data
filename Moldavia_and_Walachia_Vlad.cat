            <profile id="9b22-e804-72d7-b0fb" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour, shield and horse. May upgrade to lance (+2 pts). May have partial plate or full plate armour (free if mounted). First Charge and may count a Rank Bonus of +1 in close combat. If taken, must be accompanied by the Voievod who may not join another unit during the game. Only if the army is led by a Voievod. 0-1 unit (Garda Domneasca, mounted or dismounted). (Vlad the Impaler p.29)</characteristic>
              </characteristics>
            </profile>
            <profile id="e6c5-7edd-cc01-52d6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="2bab-567c-4a16-040e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5a63-80b4-b31d-0d78" type="atLeast"/>
