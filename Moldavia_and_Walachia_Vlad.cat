                <conditions>
                <condition field="selections" scope="1e3e-4912-c99a-e483" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7b7f-c500-c590-ecff" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="d37d-3ece-6f6a-9005" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, composite bow, shield and horse. May have thrusting spear (+2 pts). May wear light armour (+2 pts). Skirmishers. If light armour is taken, they become Open Order. Moldavian Calarasi are Expert Horsemen and cost 18 pts. (Vlad the Impaler p.29)</characteristic>
              </characteristics>
            </profile>
            <profile id="be86-d686-6c5a-2844" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="1e3e-4912-c99a-e483" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7b7f-c500-c590-ecff" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
