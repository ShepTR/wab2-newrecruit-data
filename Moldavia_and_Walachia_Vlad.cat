            <profile id="f711-9e80-a962-c543" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and shield. May be mounted on a horse (free) or a warhorse (+4 pts). May wear partial plate or full plate armour (free if mounted; partial plate is +4 pts if dismounted; full plate is +6 pts if dismounted). Army Standard Bearer. Eastern Shock Cavalry if mounted. 0-1. (Vlad the Impaler p.28)</characteristic>
              </characteristics>
            </profile>
            <profile id="7134-7afb-4fd4-3962" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
