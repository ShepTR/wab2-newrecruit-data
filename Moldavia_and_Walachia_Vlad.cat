            </profile>
            <profile id="4009-f738-64c5-07e8" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon. May have thrusting spear (+2 pts) or double-handed weapon (+2 pts). May have shield (+1 pt). May wear light armour (+2 pts). If Skirmishers, may take scythe (+3 pts). Different Weapons. Either Skirmishers or Open Order, in which case they may count a Rank Bonus of +2 in close combat. 1+ unit per 1,000 pts (Great Host). Pedestrasi formed the bulk of the Great Host: landowning peasants and commoners called upon by Voievods in time of need. (Vlad the Impaler p.30)</characteristic>
              </characteristics>
            </profile>
            <profile id="f133-2ace-baa3-6f8b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="9df4-4de1-1854-61d4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9881-80ae-a931-5dfd" type="atLeast"/>
                <condition field="selections" scope="9df4-4de1-1854-61d4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="dbae-5a8e-90c3-cf01" type="lessThan"/>
