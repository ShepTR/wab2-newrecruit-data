            </profile>
            <profile id="cd45-38e5-a08c-4d47" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon. May have thrusting spear (+2 pts), or double-handed weapon (+2 pts). May have shield (+1 pt). May wear light armour (+2 pts). Different Weapons. Open Order. May count Rank Bonus of +2 in close combat. Hatred against Ottoman Akinci and Tartar units. 1+ unit per 1,000 pts (Moldavia only; not in Small Host). (Vlad the Impaler p.30)</characteristic>
              </characteristics>
            </profile>
            <profile id="bcc7-2c3a-4a32-ead2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="15ee-93f0-bcca-90f3" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="519b-9e28-b665-8f40" type="atLeast"/>
