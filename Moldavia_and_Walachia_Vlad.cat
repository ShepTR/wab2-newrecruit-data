            <profile id="fbb7-f64b-5a37-d3d6" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, thrusting spear, heavy mace, shield and horse. May wear heavy or partial plate armour (+2 pts). Eastern Shock Cavalry. Heavy Mace. 0-1 unit. Viteji were wealthy land-owners directly responsible to the Voievod. (Vlad the Impaler p.28)</characteristic>
              </characteristics>
            </profile>
            <profile id="7890-38ea-96ac-bd72" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="9e77-6be2-e32e-639b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="28f3-ac01-3cfa-91a0" type="atLeast"/>
