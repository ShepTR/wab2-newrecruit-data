            <profile id="d3e7-4aa1-c365-8904" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and shield. May have thrusting spear (+1 pt) or halberd (+2 pts). May have partial plate or full plate armour (+2 pts if dismounted). Stubborn. If taken, must be accompanied by the Voievod who may not join another unit during the game. Only if the army is led by a Voievod. 0-1 unit (Garda Domneasca, mounted or dismounted). The Voievod's bodyguard, all professional warriors handsomely paid - most were foreigners, usually Germans or Bohemians. (Vlad the Impaler p.29)</characteristic>
              </characteristics>
            </profile>
            <profile id="7375-8ee2-2017-bb59" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="a249-6bfb-40e6-c1c4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9705-b34b-c25c-c45d" type="atLeast"/>
