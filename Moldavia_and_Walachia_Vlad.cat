            <profile id="c970-8599-5f2d-bad9" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon. May have double-handed weapon (+2 pts). May wear light armour (+2 pts). Hidden Ambush Force. Open Order. May count Rank Bonus of +2 in close combat. If taken as allies or mercenaries in other armies, they lose their Hidden Ambush Force abilities. 0-2 units (the limit is lifted if Stefan the Great is the General). (Vlad the Impaler p.30)</characteristic>
              </characteristics>
            </profile>
            <profile id="d3e9-88c9-2ee9-accf" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
