            </profile>
            <profile id="efb5-e0b4-e3aa-a0ec" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, shield. May wear heavy armour (+2 pts). May have thrusting spear (+2 pts). Dismounted Boyars may have double-handed weapon (+2 pts). Dismounted Boyars are Mounted Infantry and may be Stubborn (+3 pts). All regiments of Boieri in the same army must be either mounted or dismounted. 1+ unit. (Vlad the Impaler p.29)</characteristic>
              </characteristics>
            </profile>
            <profile id="29da-1c77-7cbb-51ba" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="fa4f-975c-7946-e33a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="46ba-d8cb-8cd3-2c5e" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
