            <profile id="b57e-d721-d967-59fc" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A Captain rides a horse and has a hand weapon, heavy armour and shield. May have composite bow (+4) and thrusting spear (+3). May have partial plate armour (+1), half barding (+2) or cloth barding (+3), and may upgrade to warhorse (+7). Alternatively, may dismount with two handed weapon (-6). After 1440 Serbian and Albanian Captains may have full plate armour (+2), barding (+4) and lance (+6).</characteristic>
              </characteristics>
            </profile>
            <profile id="a9eb-1dc6-9db2-be47" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="8085-be85-81d9-82f8" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="4d94-4546-9bfb-ee75" type="atLeast"/>
