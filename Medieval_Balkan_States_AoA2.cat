            <profile id="a5a6-156a-3624-a287" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Nobles ride horses and have a hand weapon, heavy armour and shield. Eastern Shock Cavalry. They may have composite bow (+4), thrusting spear (+3) and half barding (+2) or cloth barding (+3). One unit may be Stubborn (+3). Serbian nobles may have lance (+11) and if so have First Charge. After 1440 Serbian nobles may have barding (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="ad64-8dee-52f1-a7ce" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="ca55-e6b4-022b-87b7" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5d79-bdc8-b7a1-0ea0" type="atLeast"/>
