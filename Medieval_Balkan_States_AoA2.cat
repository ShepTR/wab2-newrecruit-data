            <profile id="37e0-4b9d-666f-aa4d" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Horse Archers have a hand weapon and composite bow. Skirmishers. Nomad Cavalry. May have shield (+1) and thrusting spear (+3). Serbian and Moldavian horse archers are WS3 and have a thrusting spear (3); they are Expert Horsemen rather than Nomad Cavalry. They may have light armour (+2) and become Open Order.</characteristic>
              </characteristics>
            </profile>
            <profile id="811d-2599-a90d-ab58" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
