            </profile>
            <profile id="19eb-7854-6ce5-d61d" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Stradiots ride horses and have a hand weapon, thrusting spear and shield. Skirmishers. Feigned Flight. Parthian Shot. May have composite bow or light crossbow (+2), and light armour (free) in which case become Open Order and lose Parthian Shot. If Open Order, may have lance (+6) or javelins (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="0e47-f430-5aa3-29b2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="e74c-ca83-2b3c-c237" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d58b-e893-20e3-1ac1" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="78e2-8f25-de76-a20a" name="Skirmishers (Art of War)" hidden="false" targetId="5c5e-9491-3100-c162" type="rule"/>
            <infoLink id="9b17-3c78-e5df-e5e5" name="Feigned Flight" hidden="false" targetId="23ce-0721-aa10-1f4d" type="rule"/>
