            </profile>
            <profile id="02f7-837e-e5b1-8f14" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Tartars have a hand weapon and composite bow. Skirmishers. Nomad Cavalry. May take shield (+1) and thrusting spear (+3). May also have light armour (-2), in which case become Open Order with Feigned Flight and Expert Horseman.</characteristic>
              </characteristics>
            </profile>
            <profile id="7884-85cf-c306-880a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="eb98-007e-3eb5-2659" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="478c-761b-a317-dac9" type="atLeast"/>
