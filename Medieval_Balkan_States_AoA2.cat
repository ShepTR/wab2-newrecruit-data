            </profile>
            <profile id="3b18-9957-f642-ff1d" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Peasants have a hand weapon and shield. Open Order. May have light armour (+2), javelins (+1) and thrusting spear (+2). Both must be Skirmishers. In Bulgar armies, Spearmen and Archers, and Peasants and Skirmishers, may form Combined Formations with up to 50% missile troops.</characteristic>
              </characteristics>
            </profile>
            <profile id="042f-65f6-ac2b-f362" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="5274-cf7a-d1e3-e3eb" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="86fe-5ac0-44f0-5263" type="atLeast"/>
                </conditions>
