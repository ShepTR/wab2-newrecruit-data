              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
                <conditions>
                <condition field="selections" scope="1e54-a9f3-41a7-96ee" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="72cf-07c5-3890-f88b" type="atLeast"/>
                </conditions>
