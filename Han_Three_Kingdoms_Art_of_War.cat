              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Special character. Armed with a Noble Sword (+1 Strength on all hits), lamellar armour and horse (free, M8). Army General. Military Strategist. Quality: Master Strategist - he can hold two Ruses instead of one per 1,000 pts. 0-1. (The Art of War p.119)</characteristic>
              </characteristics>
            </profile>
            <profile id="04d8-70f8-f89e-b5d7" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="68ad-3489-432b-d0ab" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
