            </profile>
            <profile id="e628-b4d5-bcbe-fed1" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Special character. Armed with a pair of double-edged swords (counts as additional hand weapon), lamellar armour and horse (free, M8). Army General. Heroic Combat. Warrior of Legend. Military Strategist. Sworn Brotherhood - First Brother. Quality: Steadfast. 0-1. (The Art of War p.118)</characteristic>
              </characteristics>
            </profile>
            <profile id="35ee-625e-7e1c-1c37" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="39a5-f4aa-36a3-690f" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
