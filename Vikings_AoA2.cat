              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Skirmishers have a hand weapon, javelins and buckler. Skirmishers. May exchange javelins for sling (free) or composite bow (+2).</characteristic>
              </characteristics>
