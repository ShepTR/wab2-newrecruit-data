              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A hirdman has a hand weapon, light armour and shield. Shieldwall. Fearsome. Different Weapons. May have throwing or thrusting spear (+2) or two-handed axe (+3). May be Veteran (+1). May count as Riding Horses (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="ef0e-322e-8816-c06b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="a036-3ccb-4f6c-73c2" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="569d-11da-e278-aacb" type="atLeast"/>
