              <!-- def-link -->
          <rules>
            <rule id="8050-337c-7967-5b82" name="Pike" hidden="false">
              <description>On foot may have thrusting spear (free; entered at +2 pts as it is +2 mounted), javelins +2 pts, or pike +3 pts; shield +2 pts, or large shield +3 pts.</description>
            </rule>
          </rules>
