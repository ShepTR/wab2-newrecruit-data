            </profile>
            <profile id="6d3a-4e44-f455-cf07" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword and xyston. Any unit may have light armour +2 pts, or heavy armour +3 pts. Companions may substitute javelins and shields for xyston on special commando operations (not built). Wedge formation. One unit may be upgraded to the Agema (Royal squadron) for +3 pts per model, and is Stubborn. (Alexander the Great p.21)</characteristic>
              </characteristics>
            </profile>
            <profile id="a345-0596-6dd4-6eb3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="3146-fe6b-6bf1-067d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e062-a7c7-cd31-ce41" type="atLeast"/>
