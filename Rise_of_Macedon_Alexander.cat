              </infoLinks>
          <rules>
            <rule id="7723-bf6b-f8c8-de1b" name="Xyston" hidden="false">
              <description>May ride a warhorse +4 pts; mounted may have javelins +2 pts, thrusting spear +2 pts or xyston +3 pts.</description>
