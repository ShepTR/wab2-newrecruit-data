              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelin, and pelta (buckler). 0-1 unit of Agrianians may replace javelins with slings +1 pt. Skirmishers. One Agrianian unit may be chosen for each two other skirmisher units. (Alexander the Great p.22)</characteristic>
              </characteristics>
            </profile>
            <profile id="9a13-60ef-dff3-7f34" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
