            </profile>
            <profile id="82cf-09fe-d4ee-d4d6" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword and thrusting spears. May add javelins +2 pts. Any unit may have light armour +2 pts, or heavy armour +3 pts. Drilled. Wedge. One unit may be upgraded to the Pharsalian squadron for +3 pts per model, and is Stubborn. One unit of Thessalian Cavalry is allowed for each Companion Cavalry unit in the army. (Alexander the Great p.21)</characteristic>
              </characteristics>
            </profile>
            <profile id="550b-be8c-c63b-5b81" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="6df9-aeb0-4614-a959" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="72b2-1d18-d0d0-dae3" type="atLeast"/>
                <condition field="selections" scope="6df9-aeb0-4614-a959" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b6e0-dc4a-80ff-803d" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
