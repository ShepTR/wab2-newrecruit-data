              <!-- def-link -->
              <!-- sw-rule-Xyston -->
              <infoLinks>
                <infoLink id="135b-f6c5-d677-1d0b" name="Xyston" hidden="false" targetId="e00d-b9ca-4675-4334" type="rule"/>
              </infoLinks>
          <rules>
            <rule id="1aac-cf48-fdfb-2862" name="Xyston" hidden="false">
              <description>May ride a warhorse +4 pts; mounted may have javelins +2 pts, thrusting spear +2 pts or xyston +3 pts.</description>
            </rule>
          </rules>
          <costs>
                <cost name="pts" typeId="points" value="3"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
