            <profile id="b7dc-226c-f89e-ee7f" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, thrusting spear and heavy armour. May ride in a two-horse light chariot (bought at an additional cost from the list). May change equipment to sword, javelins, light armour and shield. Army General. Warriors of Legend. The army must have a General. (Armies of Antiquity p.9)</characteristic>
              </characteristics>
            </profile>
            <profile id="1b40-66a9-a019-25a5" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="18bf-3043-4870-95e8" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="2eda-90b0-8fb0-f2a2" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
