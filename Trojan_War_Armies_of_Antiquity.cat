                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="4b13-1a83-9e5e-ef86" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, thrusting spear and a large shield. May change equipment to sword, javelins, light armour and shield (+1 pt). Subject to Warband psychology. Archers may be mixed into a spearmen unit armed with thrusting spears, one archer for every three spearmen (see the rule; not modelled). (Armies of Antiquity p.9)</characteristic>
              </characteristics>
            </profile>
            <profile id="57fd-da88-5e42-455d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="067e-90a4-adfe-a51f" name="Warband" hidden="false" targetId="e230-5072-4109-a786" type="rule"/>
            <infoLink id="2310-cc5a-ca76-db5e" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="d58f-25de-7969-4023" name="Thrusting Spear" hidden="false" targetId="5a59-1efb-14ef-017a" type="profile"/>
