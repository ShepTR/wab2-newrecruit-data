            <profile id="95b2-352a-05af-9ade" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A standard bearer has a hand weapon, light armour and shield. May have heavy armour (+1) and ride a horse (+9). Army Standard Bearer.</characteristic>
              </characteristics>
            </profile>
            <profile id="d299-49ba-50cb-da3f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
