            <profile id="eb55-7824-1e68-c02a" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Steppe Archers have hand weapon and composite bow. They may have light armour (+2), throwing spear (+3) and shield (+1). Light Cavalry. Nomad Cavalry. Unreliable.</characteristic>
              </characteristics>
