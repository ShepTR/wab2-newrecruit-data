            <profile id="f8c1-057f-595c-20af" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A Berserker has a hand weapon and shield. May have light armour (+2), throwing spear (+2), javelins (+1) or two-handed axe (+3). Enemy models in base-to-base contact with a Berserker must fight against him. Up to three Berserkers may be included in a unit of Varjazi.</characteristic>
              </characteristics>
            </profile>
