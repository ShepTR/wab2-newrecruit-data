              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, bow, and horse. May take shield (+2 pts); Vlachs may take thrusting spears (+2 pts). Skirmishers. Nomad Cavalry. Must take 1+ unit for every 1,000 pts. (Vlad the Impaler p.76)</characteristic>
              </characteristics>
            </profile>
            <profile id="691a-04ef-93e0-1e5a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="8b13-eb57-9b74-ca82" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="59b6-0848-beb9-9e4a" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
