              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, bow, and horse. May have shield (+2 pts), light armour (+2 pts), and thrusting spear (+2 pts). Skirmishers. If light armour is taken, become Open Order. Nomad Cavalry. Allies and Mercenaries. (Vlad the Impaler p.76)</characteristic>
              </characteristics>
            </profile>
            <profile id="51b1-ba76-d585-0e11" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="484e-dd4e-d0fd-6eb4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8d6b-5526-474b-67ed" type="atLeast"/>
