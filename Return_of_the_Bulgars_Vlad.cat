                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, shield and bow. May take light armour (+2 pts). Open Order. May be in Mixed Order with Greek Kontaritoi but they then lose Open Order. Every other unit may be armed with crossbows (+2 pts). (Vlad the Impaler p.76)</characteristic>
              </characteristics>
            </profile>
            <profile id="bac8-1b53-ab30-a72f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="8e76-4d9b-c962-d0b3" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bf4b-524f-dbb0-9844" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
