              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Equipment: Hand weapon, light armour, camel and Naccara (kettledrum). Camels. Each Naccara within 2” of the Khan increases his Ld range by 1”. Heavy Cavalry</characteristic>
              </characteristics>
            </profile>
            <profile id="759f-2807-a1af-51ca" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
