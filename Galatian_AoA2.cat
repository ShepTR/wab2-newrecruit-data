            <profile id="02e6-638a-f1d4-c14a" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, thrusting or throwing spear, javelins and shield. Warband. Army General. May ride a horse (+11) or in a chariot from the relevant section of the list (+58) in which case he is Ld8 but no longer Warband.</characteristic>
              </characteristics>
            </profile>
            <profile id="8299-9d9a-4b81-b8d1" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="af3e-6d65-5063-28f4" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="5f92-9265-3394-b02b" type="atLeast"/>
