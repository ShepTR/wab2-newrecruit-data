          <profiles>
            <profile id="365a-90d5-958f-9738" name="Dismounted Stipendarius" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">5+</characteristic>
              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="4+">
                <conditions>
                <condition field="selections" scope="e1f6-56e4-0bd7-070f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a6d2-9fcc-3af3-4b20" type="atLeast"/>
                </conditions>
              </modifier>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="e1f6-56e4-0bd7-070f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a6d2-9fcc-3af3-4b20" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="f7ad-7481-6fc7-3f68" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, shield and either throwing spear or thrusting spear. May upgrade armour to heavy armour (+1 pt), have javelins (+1 pt). Roll a dice the first time each unit wishes to move, charge or shoot: on a 1 it stays stationary and may not shoot (it may defend itself); on a 2-6 it may act as the player wishes. (The printed dismounted profile row has one value fewer than the header; Toughness 3 assumed.) Dogs of War cannot be accompanied by characters and cannot benefit from the Army General and Standard Bearer rules. (Shieldwall p.78)</characteristic>
              </characteristics>
            </profile>
