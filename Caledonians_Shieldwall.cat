                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="fc56-c0cd-86c5-87c4" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword. May be armed with light armour (+3 pts), shield (+2 pts). Warband. Hatred. Any unit the Priest is with gains Hatred. 0-1. (Shieldwall p.30)</characteristic>
              </characteristics>
            </profile>
            <profile id="8764-fd8e-b67c-4a5a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="cde2-2018-a884-b408" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="62af-62c0-9425-0c3c" type="atLeast"/>
