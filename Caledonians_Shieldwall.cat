            </profile>
            <profile id="c267-c692-7a00-ce28" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, thrusting spear, light armour and shield. May have javelins (+2 pts) and may have double-handed axe (+2 pts). May be mounted on a horse (+8 pts). Army General. Warband. 0-1. Not available to the Picts or Strathclyde. (Shieldwall p.29)</characteristic>
              </characteristics>
            </profile>
            <profile id="a05b-c020-9d6a-e7d6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="7d8c-a287-e1d9-3252" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="88b5-302e-db05-a27d" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
