              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Camelry have a hand weapon and javelins. Cause Fear in enemy cavalry. May have a throwing spear (+3) and shield (+1).</characteristic>
              </characteristics>
