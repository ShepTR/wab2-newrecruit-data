        <selectionEntry id="48a3-da9d-5ee5-29c0" name="Elite Themata Psilos" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="118b-eea3-8410-e608" type="min"/>
          </constraints>
          <profiles>
            <profile id="adc5-eee4-8630-8dbd" name="Elite Themata Psilos" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="11d2-25c8-ee2b-f419" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, javelins or sling &amp; buckler. Every other unit of Psiloi may replace javelins or sling with bow (+1 pt). Psiloi armed with javelins may exchange their buckler with a shield (free). Solenarion Option: Elite Themata or Themata Psiloi with bows may have Solenarion (+1 pt). Special Rules: Skirmishers. Irregular troops count as Levies. Macedonian Dynasty: for each Kontaratoi unit in the army, one unit of Psiloi (Elite Themata or Themata only) of up to ten models may be upgraded to Menaulatoi (+2 pts, +1 Leadership, count as Light Infantry; deploy within 5" of a Kontaratoi unit; hand weapon, light armour, a menaulion spear (thrusting spear; counts as heavy throwing spears when an unengaged unit is charged by cavalry) and a shield; no further equipment). 0-2 units. (Byzantium p.69)</characteristic>
              </characteristics>
            </profile>
            <profile id="5796-c332-a03a-136c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
