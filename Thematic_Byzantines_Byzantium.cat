          <rules>
            <rule id="81bd-e057-2831-b53f" name="Army General (+25 pts; if no Domestikos; Themata army)" hidden="false">
              <description>Strategos as Army General: if no Domestikos has been chosen, a Strategos may be upgraded to Army General (+25 pts).</description>
