                <condition field="selections" scope="c70a-6e26-ba41-9357" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="3eab-a111-6e26-6408" type="lessThan"/>
                <condition field="selections" scope="c70a-6e26-ba41-9357" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e3e1-5aba-da10-37bf" type="lessThan"/>
