        <selectionEntry id="4f09-51de-823b-2733" name="Irregular Psilos" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d2d0-4a5f-c731-0e7c" type="min"/>
          </constraints>
          <profiles>
            <profile id="4c10-3c90-3e58-9cc1" name="Irregular Psilos" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">2</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">2</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">2</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
              </characteristics>
            </profile>
            <profile id="441a-c55d-fd38-350a" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, javelins or sling &amp; buckler. Every other unit of Psiloi may replace javelins or sling with bow (+1 pt). Psiloi armed with javelins may exchange their buckler with a shield (free). Solenarion Option: Elite Themata or Themata Psiloi with bows may have Solenarion (+1 pt). Special Rules: Skirmishers. Irregular troops count as Levies. Macedonian Dynasty: for each Kontaratoi unit in the army, one unit of Psiloi (Elite Themata or Themata only) of up to ten models may be upgraded to Menaulatoi (+2 pts, +1 Leadership, count as Light Infantry; deploy within 5" of a Kontaratoi unit; hand weapon, light armour, a menaulion spear (thrusting spear; counts as heavy throwing spears when an unengaged unit is charged by cavalry) and a shield; no further equipment).  (Byzantium p.69)</characteristic>
              </characteristics>
            </profile>
            <profile id="86c4-6a01-5057-1ecc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
