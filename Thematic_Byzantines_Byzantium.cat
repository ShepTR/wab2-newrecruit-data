        <selectionEntry id="6561-cd8f-29e8-147a" name="Tagmata Light Kavallarios" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="974f-19e6-4600-09c3" type="min"/>
          </constraints>
          <profiles>
            <profile id="ac53-841f-16ea-984c" name="Tagmata Light Kavallarios" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
            </profile>
            <profile id="9c29-2ebf-819a-2169" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, javelins and shield. May exchange javelins for either throwing spear (+1 pt), or Kontarion (+2 pts). May have light armour (+3 pts). Light Cavalry. Elite Themata Kavallarioi may be Drilled (+1 pt). Combined Formation: any model may exchange javelins &amp; shield for short bow &amp; buckler (free) - archers are placed in the rear ranks when formed. Macedonian Dynasty: one unit of Light Kavallarioi may be upgraded to Prokousatores (+1 pt; no more than 25% of the models may take bows instead of spears; Feigned Flight). Isaurian &amp; Phrygian: Themata and Elite Themata units may be Akritai Border Cavalry (+1 pt, Feigned Flight).  (Byzantium p.69)</characteristic>
              </characteristics>
            </profile>
            <profile id="6af3-f7e2-7318-db8d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="29ba-3da3-3748-184f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7419-0404-6782-0672" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="629d-155c-8600-1904" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="5cbc-0825-2fe4-f0f6" name="Javelin" hidden="false" targetId="10ef-3567-0d3f-d9e7" type="profile">
