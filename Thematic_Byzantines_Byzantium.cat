          <profiles>
            <profile id="b2c1-9f18-d83e-4b43" name="Tagmata Kavallarios" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
                <conditions>
                <condition field="selections" scope="9f6f-5d71-004d-797e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8e91-800a-8d9a-9113" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="e037-891a-35d1-4293" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, shield and Kontarion. May have heavy armour (+1 pt). Defensores &amp; Cursores: for every two units of the same type and with the same equipment, the smallest unit may be designated as Cursores (free), who count as Light Cavalry. Superior Byzantine Cavalry. Combined Formation - up to half of any unit of Kavallarioi may be Hippo-toxotai, who are placed in the rear ranks. May be Drilled (+1 pt). Isaurian &amp; Phrygian armies: any unit of Themata or Elite Themata Kavallarioi, and any character leading them, may be upgraded to Akritai Border Cavalry (+1 pt; no Hippo-toxotai; Feigned Flight).  (Byzantium p.69)</characteristic>
              </characteristics>
            </profile>
            <profile id="1a3a-f988-b14f-f859" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="9f6f-5d71-004d-797e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8e91-800a-8d9a-9113" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
