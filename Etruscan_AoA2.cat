              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Spearmen have hand weapon, thrusting spear and large shield. Phalanx. May have light armour (+2). May alternatively be fielded in Open Order, in which case they have M5 but lose the Phalanx rule (-1 point) and cannot have light armour.</characteristic>
              </characteristics>
            </profile>
            <profile id="e200-0495-8d15-1ad5" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
