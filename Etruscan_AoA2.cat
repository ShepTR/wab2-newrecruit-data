              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hoplites have hand weapon, light armour, thrusting spear and large shield. Phalanx. Every third unit may replace thrusting spear with heavy throwing spear (free, lose the Phalanx rule).</characteristic>
              </characteristics>
            </profile>
            <profile id="4010-cf24-44d6-3cb7" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
