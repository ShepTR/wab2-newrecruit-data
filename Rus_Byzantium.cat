                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="5+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="eca1-444f-4984-c455" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8679-097e-e186-ebca" type="lessThan"/>
                <condition field="selections" scope="eca1-444f-4984-c455" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e291-888b-85a4-1bba" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="eca1-444f-4984-c455" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8679-097e-e186-ebca" type="atLeast"/>
