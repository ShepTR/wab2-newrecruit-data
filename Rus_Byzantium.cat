                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">2</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
            </profile>
            <profile id="b18f-3602-c2da-7298" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and a shield. May have light armour (+2 pts), throwing or thrusting spear (+2 pts), javelins (+1 pt), double-handed axe (+2 pts), Dane Axe (+2 pts) or an additional hand weapon (+2 pts). Riding a horse if with mounted infantry (+1 pt). Special Rule: may only be included in units of Varjazi (up to three per unit; not enforced). Rus Berserkers cannot apply their leadership value to, or leave, the unit they are with. They do not count towards the number of characters in a wedge. In close combat, enemy models in base contact with a Berserker must fight against them. Any excess wounds are carried over to the Varjazi unless the combat was a challenge. The Berserker cult gradually disappeared as the Rus converted to Christianity. (Byzantium p.88)</characteristic>
              </characteristics>
            </profile>
            <profile id="d0c3-1098-aab6-fd67" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="3fdb-fce6-b91a-0650" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a1e4-745f-4191-c608" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
