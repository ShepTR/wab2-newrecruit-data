              </modifiers>
            </profile>
            <profile id="1a07-a1b7-1adf-0bbb" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour and a shield. May have thrusting spear (+2 pts) and either javelins (+1 pt) or a bow (+2 pts). Malaia Druzhina may also have heavy armour (+1 pt). All Druzhina cavalry are treated as Superior Byzantine Cavalry. Malaia Druzhina are Drilled and Fearsome and worth an extra 100 VPs if destroyed, similar to an Army Standard Bearer. Great Rus and Mongol Invasion: Malaia Druzhina may have warhorses (+3 pts per model). 0-1 units. Not available to Early Pagan Rus (use the Varjazi). (Byzantium p.88)</characteristic>
              </characteristics>
            </profile>
            <profile id="7af9-d803-897a-91dc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="8505-b5db-a093-a4bc" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1491-a444-31a1-48e9" type="atLeast"/>
                <condition field="selections" scope="8505-b5db-a093-a4bc" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5260-ea04-a6b2-4e76" type="lessThan"/>
