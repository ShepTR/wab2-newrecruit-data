            <profile id="6dac-26a9-f928-9587" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and shield. May have light armour (+2 pts). May have a thrusting spear (+1 pt) and javelins (+1 pt) or bow (+2 pts). Special Rules: Shieldwall. Combined Formation: up to 50% Archers allowed - placed in the rear ranks. At least as many Militia models as Rus skirmisher models must be bought (not enforced). (Byzantium p.89)</characteristic>
              </characteristics>
            </profile>
            <profile id="21d5-2cfc-ec0f-032c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="1623-50f0-65a9-3f29" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="68c1-ae4f-54cd-4481" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
