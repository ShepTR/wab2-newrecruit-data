                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
              </characteristics>
            </profile>
            <profile id="88d8-1318-7e75-a3af" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mixed weaponry (counts as a hand weapon and javelins) and a shield. May have either a bow (+2 pts) or thrusting spears (+1 pt). Southern Voi Variant: any Voi unit may be designated as Southern Voi (free), who count as Light Infantry. Special Rules: Warband. Levies. Combined Formation: up to 50% Archers allowed - placed in the rear ranks. At least as many Voi as Slavic skirmishers must be chosen (not enforced). Not available to Mongol Invasion armies. (Byzantium p.89)</characteristic>
              </characteristics>
            </profile>
