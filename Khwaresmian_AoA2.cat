            <profile id="f431-909a-aa49-664c" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All ride a horse and have a hand weapon, light armour and shield. The Standard Bearer may have heavy armour (+1) and cloth barding (+3). Army Standard Bearer.</characteristic>
