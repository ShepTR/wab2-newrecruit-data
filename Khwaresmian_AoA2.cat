            </profile>
            <profile id="3165-635a-f40b-908c" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have a hand weapon, light armour, composite bow and shield. Eastern Shock Cavalry. Khwaresmian cavalry may have heavy armour (+1), thrusting spear (+3) and cloth barding (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="20c8-5433-2212-ab50" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="a20a-0aab-6b32-cd2c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8e70-7848-efcf-28e2" type="atLeast"/>
