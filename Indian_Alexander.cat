            <profile id="adc7-4237-9ef7-766a" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Broadsword, and longbow. Up to half of the models in a unit may replace longbows with shields, throwing spears, and javelins (not enforced). May replace shield with large shield +1 pt. Combined Formations. Mauryan: Hereditary infantry are raised to WS 3 and Initiative 3, and cost 10 pts. (Alexander the Great p.109)</characteristic>
              </characteristics>
            </profile>
            <profile id="8f6d-72ab-6ef0-7317" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              </modifiers>
            </profile>
          </profiles>
