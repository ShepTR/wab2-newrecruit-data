                <conditions>
                <condition field="selections" scope="e5f6-ed8e-6d67-8372" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5afc-ae1d-4e51-c8ad" type="atLeast"/>
                </conditions>
              </modifier>
