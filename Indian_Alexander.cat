            </profile>
            <profile id="f0bf-d656-dbe5-873a" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with dagger, and javelins. May have bucklers +1 pt. May substitute slings for javelins (free), short bows +1 pt, or bows +2 pts. Skirmishers. Warband Psychology. One Forest or Wild tribe unit may be taken for every elephant and/or chariot escort unit. (Alexander the Great p.110)</characteristic>
              </characteristics>
            </profile>
            <profile id="2b8a-b132-3a29-2b0e" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
