              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelins, and shield. 0-1 unit may have light armour +3 pts. May replace javelins with throwing spear or thrusting spear +2 pts. Used to elephants. (Alexander the Great p.109)</characteristic>
              </characteristics>
            </profile>
            <profile id="7dd5-244f-19ed-3cd1" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="9003-8f20-fa61-6ab3" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9f8f-c074-c05e-d20b" type="atLeast"/>
                </conditions>
