            <profile id="c152-9a0d-9e76-1c53" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Broadsword. May have longbow +3 pts, or may have shields, throwing spears, or javelins +3 pts. May replace shield with large shield +1 pt. Broadswords may be replaced with double-handed weapons +2 pts. May have light armour +2 pts. Combined Formations. One unit of Mercenaries may be taken for every two Hereditary and/or Guildsmen units in the army. Mercenary units may not be the largest unit of infantry in the army. (Alexander the Great p.109)</characteristic>
              </characteristics>
            </profile>
            <profile id="a0d2-0540-75fc-6807" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="a582-a836-307a-74b5" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a273-5a3d-b738-d6c2" type="atLeast"/>
