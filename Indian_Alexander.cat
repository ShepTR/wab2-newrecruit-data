            <profile id="1d35-c9d9-603d-666c" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, and javelins. May add throwing spears +3 pts. May have shields +2 pts. Light Cavalry. Parthian shot. Warband Psychology. Mountain Indian list only. (Alexander the Great p.113)</characteristic>
              </characteristics>
            </profile>
            <profile id="ab37-9591-b3d4-fc18" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="a94c-be86-2313-ed62" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="620a-4917-08ea-9fb6" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
