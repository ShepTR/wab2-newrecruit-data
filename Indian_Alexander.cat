        <selectionEntry id="deea-ae74-ce2d-69ed" name="War Wagon" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d451-77fe-6976-f2c0" type="min"/>
          </constraints>
          <profiles>
            <profile id="7c03-eed2-7ace-035e" name="War Wagon" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">5</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">-</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">-</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">5</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">4</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">3</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">1</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">2</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">-</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">None</characteristic>
              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="6+">
                <conditions>
                <condition field="selections" scope="1b7a-1a5f-797b-6e1e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f0b6-4084-4616-774f" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="76d5-1efa-ca2d-a132" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Warrior crewmen are armed with broadsword, javelins, longbow or shield. The warriors may replace longbows with bows +3 pts each. Shield bearers are armed with broadswords, javelins, and shield. Any crew may have light armour +4 pts. War Wagons: pulled by two or more oxen, and crewed by one unarmed driver, two shield bearers, and two warriors. War Wagons are treated as Heavy chariots, however they do not cause fear in infantry. Their lumbering gait will not allow double moves or inflict impact hits when they charge. The wagon may engage elephants and the crew do not fear elephants. The wagon's attacks represent the oxen: front only, hits only on 6s. Crewmen attack separately; models fighting from inside a wagon gain a 5+ save. War Wagons are not allowed in armies that include elephants, or large chariots. Each wagon is counted as a single model. Crews may not have standards, musicians or leaders. Not allowed in the Classical or Mountain lists. (Alexander the Great p.111)</characteristic>
              </characteristics>
            </profile>
            <profile id="98cf-2aee-c662-73de" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="1b7a-1a5f-797b-6e1e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f0b6-4084-4616-774f" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="7219-40f2-fd22-7874" name="War Wagons" hidden="false" targetId="a935-01a1-127e-bb6b" type="rule"/>
            <infoLink id="6ff1-2f9a-acf9-05d2" name="Shield" hidden="true" targetId="b513-5c2a-34df-6a1d" type="profile">
              <modifiers>
                <!-- profile-swap -->
