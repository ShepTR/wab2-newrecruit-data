            <profile id="2edf-e2f8-e35b-5b00" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Broadsword, and longbow. Up to half of the models in a unit may replace longbows with shields, throwing spears, and javelins (not enforced). May replace shield with large shield +1 pt. Guildsmen are Levies. Combined Formations. Mauryan: 0-1 infantry unit may be Guildsmen. (Alexander the Great p.109)</characteristic>
              </characteristics>
            </profile>
            <profile id="ea03-bc70-83d3-2007" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="c7af-cd62-5533-4444" name="Levies" hidden="false" targetId="27b0-fb8f-0353-5958" type="rule"/>
