          <profiles>
            <profile id="cab4-9dc0-e006-bfee" name="Rathamasaula" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">-</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">-</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">-</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">4</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">4</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">3</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">-</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">-</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">-</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">-</characteristic>
              </characteristics>
            </profile>
            <profile id="0c60-f094-5af5-376f" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Man-pushed anti-elephant war cart. The four warrior crewmen are armed with broadswords. The crewmen may have light armour +4 pts each. When it charges it causes no impact hits against normal troops, however against elephants the cart inflicts D3 wounds with no saves allowed. It charges up to 8" depending on remaining crewmen, cannot march move. The crews may not fight when it charges. If charged the crew defend from behind the Rathamasaula and are -1 to hit. A war machine. Classical and Mauryan lists (included more for fun than anything else). (Alexander the Great p.111)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="ede2-5cb8-8342-c058" name="Rathamasaula" hidden="false" targetId="110a-952b-20cc-42bb" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="76"/>
          </costs>
