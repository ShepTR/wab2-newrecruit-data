              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Steppe Archers have hand weapon and composite bow. Light Cavalry. Nomad Cavalry. Unreliable. They may have light armour (+2), throwing spear (+3) and shield (+1).</characteristic>
              </characteristics>
