            </profile>
            <profile id="3d28-7720-c90f-aac8" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have a hand weapon, light armour, shield and throwing or thrusting spear. Shock Cavalry. Feigned Flight. Senior Druzhina may have heavy armour (+1). In Post-Mongol Conquest armies, they may have a composite bow (+6) and become Eastern Shock Cavalry.</characteristic>
              </characteristics>
            </profile>
            <profile id="ca17-64a0-a1b7-151d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="d149-6c07-4ef0-d3ab" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="abba-c363-d79f-31cc" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
