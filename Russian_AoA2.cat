                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">6</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">6+</characteristic>
              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="5+">
                <conditions>
                <condition field="selections" scope="e984-e50f-114d-f9f1" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5531-4681-ebb9-ae8b" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="f52c-a4c7-e06b-ebfb" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Polk have hand weapon, thrusting spear and shield. Shieldwall. May have light armour (+2). May exchange thrusting spear and shield for composite bow (-2) or a double handed weapon (-1) but become Open Order and lose Shieldwall. In Polk and Smerd units, you may mix within the same unit models with spears and models with bows as long as the bowmen do not outnumber the spearmen. The whole unit counts as a Combined Formation and the bowmen remain close order.</characteristic>
              </characteristics>
            </profile>
            <profile id="ebcc-e607-e726-5740" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="e984-e50f-114d-f9f1" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5531-4681-ebb9-ae8b" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
