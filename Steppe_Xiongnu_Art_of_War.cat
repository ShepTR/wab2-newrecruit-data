            <profile id="5dd9-3d04-3e74-a029" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon and bow. May have javelin or throwing spear (+1 pt), buckler (+1 pt) or shield (+2 pts). Light Cavalry. Steppe Nomad Cavalry. At least 2 units required (not enforced). (The Art of War p.71)</characteristic>
              </characteristics>
            </profile>
            <profile id="b1e4-90eb-246d-43a2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="5+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="f972-39cf-81b0-325c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3280-b407-d3f2-e7ef" type="atLeast"/>
