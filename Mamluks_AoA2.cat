              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Tribal Infantry have a hand weapon, javelins and shield. Warband. May have light armour (+2) and thrusting spear (+2).</characteristic>
              </characteristics>
            </profile>
            <profile id="d179-bfcd-7271-060b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="c632-0267-9a74-7bea" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="59f3-e9bb-b098-227f" type="atLeast"/>
