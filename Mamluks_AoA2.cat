            <profile id="987b-f0b1-4144-f3eb" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The General has a hand weapon, light armour, composite bow and shield. Army General. May have a thrusting spear (+3), heavy armour (+1) and cloth (+3) or lamellar (plate) barding (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="1b21-7e53-0dca-05dd" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="84d6-f21f-9997-171f" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="79c7-7a64-f2f2-8693" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
