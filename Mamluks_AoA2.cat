            </profile>
            <profile id="3834-dd45-2a64-4628" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Syrians have a hand weapon and shield. Feigned Flight. May have light armour (+2), javelins (+1) or composite bow (+2), and thrusting spear (+2) or throwing spear (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="9bf8-6b6b-281e-c796" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="af4b-aab0-c4f0-4917" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5d77-2aef-40ba-9834" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
