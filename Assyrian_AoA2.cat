        <selectionEntry id="51c8-bb07-5f02-5560" name="Cavalry (L)" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="bd19-2094-d042-216a" type="min"/>
          </constraints>
          <profiles>
            <profile id="e486-6341-f7bc-1214" name="Cavalry (L)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">6+</characteristic>
              </characteristics>
            </profile>
            <profile id="ed30-eaac-8b13-75de" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Cavalry may only be used by a later army – they have hand weapon and light armour. Half each unit has thrusting spear, the other half bow (-1 point). Combined Formation. Cause Fear. One unit may be upgraded to Royal Guard armed with both thrusting spear and bow, and riding cloth barded horses (+8 points). The Royal Guard is Stubborn.</characteristic>
              </characteristics>
            </profile>
            <profile id="bf27-12f6-1317-de2d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="1362-280c-9756-99aa" name="Combined Formations" hidden="false" targetId="e22b-5445-d10a-9d89" type="rule"/>
            <infoLink id="c2ea-6908-384c-b69b" name="Stubborn" hidden="false" targetId="ce73-f053-8ef6-626c" type="rule"/>
            <infoLink id="2624-c874-6d05-3b39" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
