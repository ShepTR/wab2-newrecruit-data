            <profile id="f65a-9ff4-ae65-9dcd" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Qurubuti have hand weapons, light armour, throwing spear and large shield. Stubborn. Causes Fear. Asharittu and Kisir Sharruti: one third of each unit armed with hand weapons, light armour, thrusting spear and shield and two thirds armed with hand weapon, light armour and bow (-1 point). Combined Formation. Causes Fear.</characteristic>
              </characteristics>
            </profile>
            <profile id="8a06-a99b-f683-ef88" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
