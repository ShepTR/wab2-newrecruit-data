              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Abbasiya have a hand weapon, shield and bow. May have light armour (+2) and thrusting spear (+3). Light Cavalry. Parthian Shot. May not be used by Umayyad armies.</characteristic>
              </characteristics>
            </profile>
            <profile id="de93-19fe-2e96-97b9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
