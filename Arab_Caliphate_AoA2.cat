              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Tribal cavalry have a hand weapon, javelins and shield. Light Cavalry. Feigned Flight. May exchange javelins for short bow (free) or thrusting spear (+2).</characteristic>
              </characteristics>
            </profile>
            <profile id="ea47-8686-4c4a-2563" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
