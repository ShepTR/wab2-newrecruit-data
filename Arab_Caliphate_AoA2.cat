            <profile id="e692-63c1-b25f-171a" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have hand weapon, light armour, composite bow and shield. May have thrusting spear (+3) and be Riding Horses or Riding Camels (+1). May ride a horse (+14), which may have half-barding (+2) or barding (+4). If mounted may have heavy armour (+1) and are Eastern Shock Cavalry. Senior Ghulams must be led by the army general at all times.</characteristic>
              </characteristics>
            </profile>
            <profile id="96d2-a719-79d0-dd10" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="db3a-a47b-2b2f-baa0" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ca00-d9e3-b87f-fae7" type="lessThan"/>
