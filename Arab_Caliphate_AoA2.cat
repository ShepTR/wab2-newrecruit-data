            <profile id="c458-aeb8-4f3f-ffc7" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The General has a hand weapon and light armour. Army General. May ride a horse (+9) or warhorse (+16), or be Riding Horses or Riding Camels (+1). May have heavy armour (+1), shield (+1), or composite bow (+4). Mounted Generals may have half-barding (+2) or barding (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="282c-cfd9-b00d-5ab9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
