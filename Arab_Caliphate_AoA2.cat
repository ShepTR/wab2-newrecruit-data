                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">6+</characteristic>
              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="5+">
                <conditions>
                <condition field="selections" scope="9b2f-3592-d646-1a9c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0156-eecc-7dfd-5bf0" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="e41b-4cc6-d2a6-f176" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Have a hand weapon, throwing or thrusting spear and shield. Shieldwall. Warband. May have light armour (+2) and be Riding Camels (+1). May be Stubborn (+3). Troops without armour may be designated Light Infantry (+3, if armed with throwing spear +4). May instead be fielded as Light Infantry with composite bow instead of spear (+3). May not then take light armour.</characteristic>
              </characteristics>
            </profile>
            <profile id="2afd-fcc3-61a3-e6a9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="9b2f-3592-d646-1a9c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0156-eecc-7dfd-5bf0" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="3c15-e4fb-f93b-bb33" name="Warband" hidden="false" targetId="e230-5072-4109-a786" type="rule"/>
            <infoLink id="8a4d-c65f-3d81-2677" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
