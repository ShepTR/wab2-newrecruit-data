                </conditions>
              </modifier>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="4e77-004a-7eb4-e1cb" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bc62-c534-6225-6362" type="lessThan"/>
