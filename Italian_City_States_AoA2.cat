              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="4e77-004a-7eb4-e1cb" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bc62-c534-6225-6362" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="71e9-c55f-70b2-6db2" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Provisionati have light armour, thrusting spear and large shield. May replace thrusting spear and shield with either halberd (-1), or in late armies, pikes (+1). May have heavy armour (+1). In a Papal State and Naples armies, one unit equipped with thrusting spear may be upgraded to Guard (+8). Guards have WS4, Ld8 and are Stubborn. Medieval Phalanx if equipped with pikes.</characteristic>
              </characteristics>
            </profile>
            <profile id="65b5-b31f-b1ef-3147" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="4e77-004a-7eb4-e1cb" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="bc62-c534-6225-6362" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
