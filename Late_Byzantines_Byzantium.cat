          <profiles>
            <profile id="a54a-0c18-42d1-195a" name="Guard Light Infantryman" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">6+</characteristic>
              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="5+">
                <conditions>
                <condition field="selections" scope="d828-aecd-650f-82e3" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6c3d-4d0e-b99d-d2a8" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="e3db-f5b2-992b-d085" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and shield. May have either throwing spear (+1 pt), javelins (+1 pt) or sling (+1 pt). Guards may also have light armour (+2 pts). Light Infantry. 0-2 units. Light infantrymen had a much better chance than spearmen against heavily armoured cavalry, especially if fighting in broken ground and wooded areas. (Byzantium p.93)</characteristic>
              </characteristics>
            </profile>
            <profile id="0103-5515-a3b9-290b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="d828-aecd-650f-82e3" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6c3d-4d0e-b99d-d2a8" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="55d1-1fc9-60a1-6a0a" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="b863-e05c-583d-cca7" name="Shield" hidden="false" targetId="b513-5c2a-34df-6a1d" type="profile"/>
