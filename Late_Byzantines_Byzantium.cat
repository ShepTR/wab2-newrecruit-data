                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">6+</characteristic>
              </characteristics>
            </profile>
            <profile id="4b53-d315-b4c0-2340" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, javelins or sling &amp; buckler. May exchange sling or javelins for bow (+1 pt). Skirmishers. Irregular Psiloi are Levies. (Byzantium p.94)</characteristic>
              </characteristics>
            </profile>
            <profile id="f68d-bcfd-2b36-b3fb" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="540f-b4c2-c0b5-e18b" name="Skirmishers (Byzantium)" hidden="false" targetId="ce4b-42b1-6eb6-6e51" type="rule"/>
