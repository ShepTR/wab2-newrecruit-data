            </profile>
            <profile id="5afe-543d-54cf-a4b4" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and bow. May have throwing spear (+1 pt), javelins (+1 pt), and either buckler (+1 pt) or shield (+2 pts). Light Cavalry. Nomad Cavalry. Macedonian Successors: up to two units of Skythikoi may be chosen. While Skythikoi were mercenaries drawn from the nomadic tribes living in and around the empire, Turkopoloi were sons of Turks - ie, Christianised Turks. (Byzantium p.93)</characteristic>
              </characteristics>
            </profile>
            <profile id="fd05-bf26-5df6-41aa" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="6+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="2e37-e725-7613-c851" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="83eb-ab29-9b59-4eb3" type="atLeast"/>
