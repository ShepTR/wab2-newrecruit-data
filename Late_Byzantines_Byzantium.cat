              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mixed weapons (count as hand weapon and javelins) and shield. May have throwing spear (+1 pt). Warband Psychology Rule 1 and 2. Light Infantry. 0-2 units. Komnenian armies only (Allies &amp; Mercenaries). (Byzantium p.95)</characteristic>
              </characteristics>
            </profile>
            <profile id="b6ce-8015-366f-61b0" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
