              <modifier type="set" field="7349-090e-ca0b-09ce" value="5+">
                <conditions>
                <condition field="selections" scope="9433-195c-cb37-dc7c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6bba-20cf-8419-5b5b" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="d8b2-3672-1bd3-2776" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, shield and thrusting spear. May have light armour (+2 pts). Two units may exchange shield and spear for either bow (free) or crossbow (+4 pts). Special Rules: Combined Formation - Latinikoi infantry with spears may combine with up to 30% Archers or Crossbowmen. Unless they are combined with Spearmen, Latinikoi Archers and Crossbowmen are Light Infantry. Latinikoi Infantry may only be taken if at least one unit of Latinikoi Knights has been chosen as well (not enforced). 0-2 units. (Byzantium p.94)</characteristic>
              </characteristics>
            </profile>
            <profile id="73f1-a026-a0e5-c950" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="9433-195c-cb37-dc7c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6bba-20cf-8419-5b5b" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8edd-d4af-e3b1-3f31" name="Combined Formation (Byzantium)" hidden="false" targetId="2280-7c4f-4408-0d5e" type="rule"/>
            <infoLink id="6876-5689-1bc0-acbf" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
