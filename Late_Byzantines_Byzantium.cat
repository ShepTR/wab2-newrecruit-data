              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="4+">
                <conditions>
                <condition field="selections" scope="8bab-b232-424a-6367" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="13c0-200f-6655-3b92" type="atLeast"/>
                </conditions>
              </modifier>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
                <conditions>
                <condition field="selections" scope="8bab-b232-424a-6367" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="13c0-200f-6655-3b92" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="7020-6475-8d07-1a99" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, Kontarion, light armour and shield. Guard Kavallarioi may have heavy armour (+1 pt). Combined Formation - up to half the models may exchange spear for bow (free), but may take no further equipment if they do so - archers are placed in the rear ranks. Guards and Regular Kavallarioi are Superior Byzantine Cavalry. Komnenian armies: Guard Kavallarioi may exchange Kontarion for lance (+2 pts); such units imitate western knights - they cannot combine with archers, no longer count as Superior Byzantine Cavalry, but may count their rank bonus up to +1. 0-2 units. In Komnenian armies, for every unit of Kavallarioi Guards a unit of Regular or Irregular Kavallarioi must be taken as well (not enforced). (Byzantium p.93)</characteristic>
              </characteristics>
            </profile>
            <profile id="24ea-65b6-c45d-6aff" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="8bab-b232-424a-6367" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="13c0-200f-6655-3b92" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="bdcb-2895-8cdc-49e2" name="Superior Byzantine Cavalry" hidden="false" targetId="d81e-b4ce-ed5b-0f8a" type="rule"/>
            <infoLink id="85d4-ce60-dbcc-0e5c" name="Combined Formation (Byzantium)" hidden="false" targetId="2280-7c4f-4408-0d5e" type="rule"/>
