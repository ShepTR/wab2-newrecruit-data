                <conditions>
                <condition field="selections" scope="03b7-f28d-cd41-f094" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="382d-8660-133b-aafc" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="5722-f743-5b09-da5c" name="Equipment and options (as printed in WAB2 army list)" publicationId="eb14-e889-c793-0fc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with mixed weapons and shield. May take throwing spear (+2 pts) and replace shields with large shields (+2 pts). May be Stubborn (+3 pts). Warband. Looting. Hate Romans. Stealth. These represent slaves from German and Gallic stock, fighting in their traditional way. (Spartacus p.14)</characteristic>
              </characteristics>
            </profile>
            <profile id="6150-e063-dafc-5f12" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="03b7-f28d-cd41-f094" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="382d-8660-133b-aafc" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
