              </modifiers>
            </profile>
            <profile id="2d17-3438-5161-14ed" name="Equipment and options (as printed in WAB2 army list)" publicationId="eb14-e889-c793-0fc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with mixed weapons and shield. Any unit may replace shields with large shields (+2 pts), mixed weapons with throwing spear (+2 pts), and may be Stubborn (+3 pts). One unit may replace mixed weapons with pilum (+4 pts). Up to one unit may have light armour (+3 pts). Subject to Warband Rule 2. Hates Romans. Looting. Stealth. There must be at least as many Untrained Slave models in the army as Trained Slaves (not enforced). May not be taken in the Germano-Gallic army. Any one of Gladiators, Trained Slaves, Gallic or Germanic Slaves may carry the Fiery Rollers (+40 pts). (Spartacus p.13)</characteristic>
              </characteristics>
            </profile>
            <profile id="83fa-3078-2a51-9e24" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="ba99-c08b-24ec-9198" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3261-e10b-ff9b-d4a0" type="atLeast"/>
                <condition field="selections" scope="ba99-c08b-24ec-9198" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="05aa-55c3-469a-da23" type="lessThan"/>
