                <condition field="selections" scope="ba99-c08b-24ec-9198" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3261-e10b-ff9b-d4a0" type="lessThan"/>
                <condition field="selections" scope="ba99-c08b-24ec-9198" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="05aa-55c3-469a-da23" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="7349-090e-ca0b-09ce" value="4+">
                <conditions>
                <condition field="selections" scope="ba99-c08b-24ec-9198" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3261-e10b-ff9b-d4a0" type="atLeast"/>
                <condition field="selections" scope="ba99-c08b-24ec-9198" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="05aa-55c3-469a-da23" type="atLeast"/>
                </conditions>
              </modifier>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="ba99-c08b-24ec-9198" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3261-e10b-ff9b-d4a0" type="atLeast"/>
                <condition field="selections" scope="ba99-c08b-24ec-9198" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="05aa-55c3-469a-da23" type="atLeast"/>
