              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Brigans have hand weapon. May have light armour (+2), halberd (+3), thrusting spear (+2), and buckler (free). Open Order.</characteristic>
              </characteristics>
            </profile>
            <profile id="a8f5-5150-c8b4-ebda" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
