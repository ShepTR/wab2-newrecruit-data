            </profile>
            <profile id="9130-667c-8762-bd1d" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A Captain has a hand weapon and partial plate armour. May have shield (+1), double handed weapon (if dismounted) (+3) and full plate armour (+1). May ride a warhorse (+16) that may be cloth barded (+3). If mounted may have a lance (+6). One Captain may be upgraded to the Bearer of the Oriflamme (+30).</characteristic>
              </characteristics>
            </profile>
            <profile id="ef1c-6b86-03dc-5f51" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="3b4a-194f-78fd-bb3b" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="f3a4-c472-62fa-da9f" type="atLeast"/>
                <condition field="selections" scope="3b4a-194f-78fd-bb3b" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="cada-907f-5faa-0073" type="lessThan"/>
                <condition field="selections" scope="3b4a-194f-78fd-bb3b" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e0a9-eb2f-295e-88be" type="lessThan"/>
                <condition field="selections" scope="3b4a-194f-78fd-bb3b" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="ebe6-f3d8-dcd1-2cd4" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="3b4a-194f-78fd-bb3b" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="f3a4-c472-62fa-da9f" type="lessThan"/>
