              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Dismounted Knight have hand weapon, shield, and partial plate armour. May have full plate armour (free) and double handed weapon (+3). Veteran, Riding Horses. Sergeants</characteristic>
              </characteristics>
