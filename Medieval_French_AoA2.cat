            <profile id="f842-db9f-327e-c171" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mounted Knights have hand weapon, partial plate armour, horse, and shield. Shock Cavalry. First Charge. Veterans, Impetuous. May be mounted on a warhorse (+7) that may have cloth barding (+3). They may have full plate armour (free) and may take a lance (+6).</characteristic>
              </characteristics>
            </profile>
            <profile id="1616-cc73-0022-7c07" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="a3c5-ef9f-f16e-d545" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6bf8-fa5b-00ad-7244" type="lessThan"/>
