            <profile id="428f-caba-f66b-16cb" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and partial plate armour. Army General. May have shield (+1), double handed weapon (if dismounted) (+3), and full plate armour (+1). May ride a warhorse (+16) that may be cloth barded (+3). If mounted may have a lance (+6). May be Stubborn (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="9b82-b9ea-afdc-edd4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="e4d6-f76c-9ee2-d8eb" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="53b6-0249-fa1a-422d" type="atLeast"/>
