                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="81c5-e09e-3ece-1976" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand Weapon, thrusting spear, light armour, shield. Dismounted Sergeants may exchange thrusting spear and shield for crossbow (+1), and if they do may have pavise (+2). May alternatively exchange thrusting spear, shield and light armour for heavy armour and halberd (free). Crossbow equipped sergeants are open order.</characteristic>
              </characteristics>
            </profile>
            <profile id="b188-94c9-aeed-2111" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="4+ with Pavise +2 when shot at from the front only">
                <conditions>
                <condition field="selections" scope="e3b4-289e-0ba7-376c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e60b-82a1-207f-1066" type="atLeast"/>
