                <condition field="selections" scope="80c5-9f95-3c2f-552d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f9be-fb1b-38e9-09c7" type="atLeast"/>
                </conditions>
