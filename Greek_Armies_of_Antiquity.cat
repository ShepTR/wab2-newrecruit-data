            </profile>
            <profile id="9c03-7b3b-924a-28ba" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, thrusting spear and large shield. May have light armour (+2 pts) or heavy armour (+3 pts). Up to one unit in the army may be upgraded to a Sacred Band at +5 pts per model; the Sacred Band must have fewer models than any other Hoplite unit in the army, is immune to psychology and will never break. Spartans are drilled and stubborn (Toughness 4 is not a typo). All units fight in phalanx formation. (Armies of Antiquity p.15)</characteristic>
              </characteristics>
            </profile>
            <profile id="08e9-db1f-6fcb-13ad" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="80c5-9f95-3c2f-552d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="824e-9a0b-2bd8-b632" type="atLeast"/>
                <condition field="selections" scope="80c5-9f95-3c2f-552d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f9be-fb1b-38e9-09c7" type="lessThan"/>
