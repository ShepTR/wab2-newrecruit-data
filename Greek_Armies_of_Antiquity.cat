<catalogue id="eaae-80c3-653b-cdff" name="Ancient Greek (Armies of Antiquity)" revision="7" battleScribeVersion="2.03" authorName="WAB2 New Recruit pilot" library="false" gameSystemId="6f1f-5f84-d7e5-4889" gameSystemRevision="8" xmlns="http://www.battlescribe.net/schema/catalogueSchema" type="catalogue">
  <readme>Ancient Greek (Armies of Antiquity): units and points from the Armies of Antiquity army list book (Warhammer Historical).</readme>
  <selectionEntries>
    <selectionEntry id="4b1e-b287-f31a-8b63" name="Army General" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9d45-5a76-6fc8-1619" type="max"/>
      </constraints>
      <categoryLinks>
        <categoryLink id="79dc-31a7-8727-6655" name="Characters" hidden="false" targetId="d087-5488-98c4-52b6" primary="true"/>
      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="7119-93de-a26e-a2a7" name="General" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7eac-ee1d-ffe6-1936" type="min"/>
          </constraints>
          <profiles>
            <profile id="b9e9-6b8e-6593-e05e" name="General" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">6</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">4</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">4</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">3</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">5</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">3</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">9</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
              </modifier>
              </modifiers>
            </profile>
            <profile id="ecd8-d7de-d197-1d94" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, large shield and heavy armour. May be given a thrusting spear at no additional cost. The General must lead (and may not leave) a Hoplite phalanx. 0-1. (Armies of Antiquity p.15)</characteristic>
              </characteristics>
            </profile>
            <profile id="e9c8-d350-5014-45a8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="ff7c-66ba-ba34-e61f" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
            <infoLink id="0406-2a60-297c-5490" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="3ff4-dc7b-fcb8-ec17" name="Large Shield" hidden="false" targetId="8367-11b2-7778-977f" type="profile"/>
            <infoLink id="2493-c37f-2eea-c3a5" name="Heavy Armour" hidden="false" targetId="16c5-d2b2-fa96-9cd2" type="profile"/>
            <infoLink id="4d9d-d527-4c7c-a2fc" name="Ancient Greek (Armies of Antiquity) - List Notes" hidden="false" targetId="5f67-d33c-299e-002d" type="rule"/>
