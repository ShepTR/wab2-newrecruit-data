                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">6</characteristic>
              </characteristics>
            </profile>
            <profile id="0e09-6dff-ddd6-bb1c" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All Warriors have hand weapon, throwing Spear, javelins and shield. Warband. All Warriors may exchange throwing spear for heavy throwing spear (+1 point). In armies after 700 AD, all Warriors must exchange throwing spear for thrusting spear (+3). They cease to be Warband but gain Shieldwall. Combined units: formed units of elite and other warriors maybe in combined units where up to 75% of models maybe of the inferior type</characteristic>
              </characteristics>
            </profile>
            <profile id="aab7-9c53-f6d7-4b67" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="059a-b8ea-fc5f-d5e0" name="Warband" hidden="false" targetId="e230-5072-4109-a786" type="rule"/>
            <infoLink id="85da-7928-4f7e-8f49" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
