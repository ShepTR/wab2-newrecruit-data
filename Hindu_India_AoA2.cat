            <profile id="f293-cc32-e8c7-9028" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Elite Cavalry and Muslim Cavalry have hand weapon, light armour, thrusting spear and shield. Eastern Shock Cavalry. Used to Elephants. Elite Cavalry may have barding (+4) and heavy armour (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="5b9e-0262-7164-d2d7" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="2531-c88a-7251-cbf9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="430d-c059-7ef8-0c14" type="atLeast"/>
