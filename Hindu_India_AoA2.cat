            <profile id="9cbc-3964-0fd2-74ae" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A commander has a hand weapon and light armour. May ride a horse (+14), becoming Eastern Shock Cavalry and Used to Elephants. May have Shield (+1), heavy armour (+1), a thrusting spear (+3) and barding (+4pts). May be mounted on an elephant bought from the list below. If no other Army General is taken, a single Commander may be made Army General (+50).</characteristic>
              </characteristics>
            </profile>
            <profile id="2a2a-e687-13df-4fc3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
