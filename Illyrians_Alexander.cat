            </profile>
            <profile id="2bd9-9229-a37d-e5a3" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword and thrusting spear. May add javelins +2 pts. May have light armour +3 pts, heavy armour +4 pts. May have shield +3 pts. May ride a horse (free, increases Movement to 8, +1 save). 0-1 Chieftain may be upgraded to the Army Battle Standard for +15 pts. Warband Psychology. Stealth. (Alexander the Great p.85)</characteristic>
              </characteristics>
            </profile>
            <profile id="e347-ab16-8aec-280f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
