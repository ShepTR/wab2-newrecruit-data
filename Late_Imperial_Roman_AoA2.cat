                <condition field="selections" scope="6f1b-955c-29cb-2f64" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7b23-67ca-15ef-58c9" type="atLeast"/>
                <condition field="selections" scope="6f1b-955c-29cb-2f64" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="48a1-7019-e230-9a17" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="d4d7-1015-ee7c-591b" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Legionaries have a hand weapon, throwing spear, large shield and darts. Shieldwall. They may have light armour (+2). Throwing spears may be exchanged for either thrusting spears (free) or heavy throwing spears (+1). Legionary units may use Combined Formation with up to one third of the unit’s figures exchanging throwing spear, large shield and darts for composite bow and buckler (-3) and forming the rear rank(s) of the unit They may not take any other equipment. In an Imperial Field Army, any Legionary unit may be upgraded to elite Palatini (+4). Palatini have Ld8 and are Drilled.</characteristic>
              </characteristics>
            </profile>
            <profile id="52a2-296b-455c-84f6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="6f1b-955c-29cb-2f64" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7b23-67ca-15ef-58c9" type="atLeast"/>
                <condition field="selections" scope="6f1b-955c-29cb-2f64" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="48a1-7019-e230-9a17" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="6f1b-955c-29cb-2f64" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7b23-67ca-15ef-58c9" type="atLeast"/>
                <condition field="selections" scope="6f1b-955c-29cb-2f64" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="48a1-7019-e230-9a17" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
