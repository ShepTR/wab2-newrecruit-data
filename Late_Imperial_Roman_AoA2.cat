            </profile>
            <profile id="8129-33a7-4682-9658" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Light Cavalry have hand weapons and composite bows. Light Cavalry. Nomad Cavalry. They may have shield (+1) and throwing spear (+3). For every two Light Cavalry units, one foederate heavy cavalry unit may be upgraded to Steppe Nobles (+4). Steppe Nobles have composite bows and are Expert Horsemen.</characteristic>
              </characteristics>
            </profile>
            <profile id="73fa-7fd5-ac24-c216" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="c4c9-38b2-b147-dd85" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2c4b-8c3c-4d68-9a7e" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
