                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">4+</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="6">
              </modifier>
              </modifiers>
            </profile>
            <profile id="73f5-7f96-7c62-a221" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Catafractii and Clibanarii have hand weapons and cataphract armour. Cataphracts. They may have kontos (+3) and short bows (+1). Their horses may have full metal barding (+4). You may have one Catafractii or Clibanarii unit for every two Equites units. In an Imperial Field Army, any Equites or Catafractii/Clibanarii unit may be upgraded to elite Scholae (+4). Scholae have Ld8 and are Drilled.</characteristic>
              </characteristics>
            </profile>
            <profile id="f465-2ecb-24ce-3ea8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="4c09-33ef-4b1b-817e" name="Cataphracts" hidden="false" targetId="eb86-0081-b1a8-a733" type="rule"/>
            <infoLink id="8b9a-ca5e-5ecd-f081" name="Drilled" hidden="false" targetId="d6b3-51b2-64eb-2b91" type="rule"/>
            <infoLink id="2e29-e622-71d3-7262" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="3a9f-3d4e-3ae1-b389" name="Cataphract Armour" hidden="false" targetId="aa63-8f92-57ef-91e7" type="profile"/>
            <infoLink id="7766-e919-fded-ef5c" name="Kontos" hidden="true" targetId="f901-2529-d411-6ed0" type="profile">
              <modifiers>
