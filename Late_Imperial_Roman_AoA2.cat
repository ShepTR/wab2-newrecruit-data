            </profile>
            <profile id="0a49-02c6-6159-6693" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Equites Illyricani have a hand weapon, javelins and shield. Light Cavalry. Feigned Flight. They may have throwing spear (+3) Equites Sagitarii have hand weapons, javelins, shield with composite bow and buckler (free). Light Cavalry. Feigned Flight. May have light armour (+2).</characteristic>
              </characteristics>
            </profile>
            <profile id="96b4-9e1d-4e1b-a4b9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="d4b7-e8de-23db-fc78" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d3dc-d5bc-95da-80d7" type="lessThan"/>
