            <profile id="03b1-b522-6da1-5d82" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have hand weapon, pike and shield. They may have light armour (+2). Macedonian Phalanx. Argyraspids are Stubborn. At least one unit of phalangites must be fielded. In later armies Argyraspids may be fielded with hand weapon, light armour, heavy throwing spear and large shield (+1); they lose the phalanx rule.</characteristic>
              </characteristics>
            </profile>
            <profile id="7cc2-5cec-be5c-b4e9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="9063-8f9f-7ab1-c93e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ece7-2615-102e-9946" type="atLeast"/>
