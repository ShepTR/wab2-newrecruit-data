                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="b5f8-f98b-9efd-2c95" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Companions, Agema and Line cavalry have hand weapon, light armour and xyston and may upgrade to heavy armour (+1) and half barding (+2). Wedge. Agema and line cavalry may instead upgrade to Cataphract armour and full metal barding (+11) in which case they become Cataphracts but no longer fight in Wedge. All cavalry are Used to Elephants.</characteristic>
              </characteristics>
            </profile>
            <profile id="6419-fabd-94f2-87e4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="1558-b846-1228-5ee8" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="10e6-99fc-ace7-e321" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="7b28-2880-fd4e-5913" name="Wedge" hidden="false" targetId="1c16-3adf-a97d-1db8" type="rule"/>
