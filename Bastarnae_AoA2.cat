            <profile id="86a4-0f8c-899b-ba4a" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A crewman has a hand weapon and javelins. May swap javelins for short bow (free). The crew of the lager form a single unit which has a maximum size of 5 crew per wagon fielded. Wagon Tabor.</characteristic>
              </characteristics>
            </profile>
