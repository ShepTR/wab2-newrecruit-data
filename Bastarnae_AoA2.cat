              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Nobles have Mixed Weapons and shield. Stubborn. May have light armour (+2), and composite bow (+4). May exchange Mixed Weapons for thrusting spear (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="2e41-9180-9aaa-fdef" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
