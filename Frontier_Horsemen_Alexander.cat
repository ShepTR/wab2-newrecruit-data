                <condition field="selections" scope="a905-d52c-8b3c-d071" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e463-ed1c-c3e5-91bd" type="atLeast"/>
                </conditions>
              </modifier>
