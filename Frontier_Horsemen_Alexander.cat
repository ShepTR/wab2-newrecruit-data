            </profile>
            <profile id="5eed-24c0-cc6e-a8b6" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon, bow and light armour. May have javelins +2 pts, throwing spear or thrusting spear +4 pts, shield +2 pts, barding +4 pts. Light Cavalry. Feigned Flight and Parthian Shot. May fight in a Wedge or as Massed Cavalry but may not use Feigned Flight and Parthian Shot if in either of these formations. 0-1 unit. (Alexander the Great p.100)</characteristic>
              </characteristics>
            </profile>
            <profile id="ed4f-6523-ccb0-ba29" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="a905-d52c-8b3c-d071" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3996-c372-b1f5-d7fc" type="atLeast"/>
                <condition field="selections" scope="a905-d52c-8b3c-d071" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e463-ed1c-c3e5-91bd" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="a905-d52c-8b3c-d071" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3996-c372-b1f5-d7fc" type="lessThan"/>
                <condition field="selections" scope="a905-d52c-8b3c-d071" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e463-ed1c-c3e5-91bd" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
