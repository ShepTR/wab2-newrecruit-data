            <profile id="7dd8-f907-d632-ce61" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The General has a hand weapon, heavy armour and shield. Army General. May ride a warhorse (+16) and have a lance (+6). Unless mounted, may have a double handed weapon (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="259b-5415-8d1d-d4ca" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="7f65-90a7-aab0-c3cb" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="fdef-88e7-ea76-b216" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
