            <profile id="fb91-b37a-de2d-a87c" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Knights have hand weapon, lance, heavy armour and shield. They ride warhorses. Shock Cavalry. Ferocious Charge. Subject to Warband rules #1 and 3. Knights and Sergeants may dismount (-30 for Knights, -10 for Sergeants). Dismounted knights replace lance with thrusting spear (free) or double handed weapon (+1). Note dismounted Knights are still subject to Warband rules 1 and 3.</characteristic>
              </characteristics>
            </profile>
            <profile id="d332-5f68-838d-4351" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
