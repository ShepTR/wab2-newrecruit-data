                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="b3a4-2bce-a03a-90c2" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Men at Arms have thrusting spear, heavy armour and shield. Medieval Phalanx if in Schiltron. May have partial plate armour (+1). May be Stubborn (+3). The Schiltron is a Combined Unit made of at least 66% of spearmen and between 0% and 33% of Men at Arms. The Leader of the unit will always be a Man-At-Arms and the Standard and Musician will be Spearmen. The unit will remain stubborn as long as half the front rank is Man-At-Arms. Dismounted Knights</characteristic>
              </characteristics>
            </profile>
            <profile id="901d-6025-705b-6ae0" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="7d96-7669-e8f7-f0e8" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9b7e-743a-baae-859d" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="e12a-437b-d8ec-9ca5" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="1da5-ffab-48d8-20e8" name="Thrusting Spear" hidden="false" targetId="5a59-1efb-14ef-017a" type="profile"/>
            <infoLink id="dab8-d1d6-45a6-73c2" name="Heavy Armour" hidden="false" targetId="16c5-d2b2-fa96-9cd2" type="profile"/>
            <infoLink id="3c96-9aa7-3408-c9dd" name="Shield" hidden="false" targetId="b513-5c2a-34df-6a1d" type="profile"/>
          </infoLinks>
