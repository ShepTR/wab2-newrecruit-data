              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Men at Arms have thrusting spear, heavy armour and shield. May have partial plate armour (+1) and exchange thrusting spear for a double-handed weapon (+1). May be Stubborn (+3) and may be Riding Horses (+1). Light Foot</characteristic>
              </characteristics>
            </profile>
            <profile id="519d-dae8-9043-eaa2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
