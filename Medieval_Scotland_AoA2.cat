                <conditions>
                <condition field="selections" scope="cb2c-58ba-3dca-bb75" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d1b4-77a5-e06d-15db" type="atLeast"/>
