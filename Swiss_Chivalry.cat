            <profile id="dad9-ce4d-14ea-2012" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, partial or full plate armour, lance, and warhorse. May have cloth barding (+4 pts) or plate barding (+6 pts). May count a Rank Bonus of up to +1 in combat. (Armies of Chivalry p.57)</characteristic>
              </characteristics>
            </profile>
            <profile id="4efa-1af4-cfdc-97fa" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
