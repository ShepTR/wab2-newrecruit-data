            </profile>
            <profile id="9881-5e25-99ce-f409" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Pike. May wear light armour (+1 pt) or heavy armour (+2 pts). Stubborn and Medieval Phalanx. The Gewalthut costs an additional +25 pts (one unit; it must begin the game as the largest unit in the army; see Cantonal Standards). Pike and halberd units may purchase a Captain for 20 pts instead of a Leader. (Armies of Chivalry p.57)</characteristic>
              </characteristics>
            </profile>
            <profile id="544e-94c9-5b1c-01b7" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="677e-cc60-7932-31f9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4bd0-0163-2c3d-e670" type="atLeast"/>
