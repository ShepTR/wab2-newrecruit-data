                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="b569-1faa-e636-f408" name="Equipment and options (as printed in WAB2 army list)" publicationId="2127-dab1-0af6-7421" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Composite bow, sword. May have light armour (+2 pts) and/or shields (+1 pt). Light Infantry. May form a Combined Unit with Mercenary Spearmen. Aliados y Mercenarios: may have a leader, standard bearer and musician as normal; roll a dice the first time each unit moves, charges or shoots (on a 1 it stays stationary); may not benefit from the Army General or Army Standard Bearer abilities (they may be led by any appropriate character). One Aliados y Mercenarios unit may be personally led by the Army General and is then exempt from these rules. (El Cid p.54)</characteristic>
              </characteristics>
            </profile>
            <profile id="4c8b-c9df-9329-bab6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="12c6-6d54-840d-c365" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1a3b-ee78-991a-cd04" type="atLeast"/>
                <condition field="selections" scope="12c6-6d54-840d-c365" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8c8c-21b8-c185-ae7e" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="12c6-6d54-840d-c365" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1a3b-ee78-991a-cd04" type="lessThan"/>
                <condition field="selections" scope="12c6-6d54-840d-c365" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8c8c-21b8-c185-ae7e" type="atLeast"/>
