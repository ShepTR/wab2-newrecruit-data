                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
            </profile>
            <profile id="2991-e88f-c24f-b8f9" name="Equipment and options (as printed in WAB2 army list)" publicationId="2127-dab1-0af6-7421" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons, light armour, javelins, shield. May have throwing spears (+2 pts). Light Cavalry. Feigned Flight. Aliados y Mercenarios: may have a leader, standard bearer and musician as normal; roll a dice the first time each unit moves, charges or shoots (on a 1 it stays stationary); may not benefit from the Army General or Army Standard Bearer abilities (they may be led by any appropriate character). One Aliados y Mercenarios unit may be personally led by the Army General and is then exempt from these rules. (El Cid p.55)</characteristic>
              </characteristics>
            </profile>
            <profile id="caaf-6b3a-d113-3272" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="f43b-8144-4102-52a7" name="Feigned Flight" hidden="false" targetId="23ce-0721-aa10-1f4d" type="rule"/>
