            <profile id="22e3-88f5-381d-a8a5" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and partial plate armour. May wear full plate armour (free). Lance and warhorse. Any mounted unit may add cloth barding (+4 pts) or plate barding (+6 pts). May have up to +1 Rank Bonus. First Charge. May be the front rank(s) of a Combined Formation with Currours. (Armies of Chivalry p.62)</characteristic>
              </characteristics>
            </profile>
            <profile id="eced-9dc0-2a17-85c2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
