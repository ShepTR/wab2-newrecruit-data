            <profile id="58e2-2309-055a-ea6f" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and partial plate armour. May wear full plate armour (+2 pts). May have a halberd (+3 pts) or double-handed weapon (+3 pts). Stubborn. May be in Mixed Order with Retinue Longbowmen. (Armies of Chivalry p.62)</characteristic>
              </characteristics>
            </profile>
            <profile id="1e6d-6a94-8519-1638" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="1b76-c10f-7996-672b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="68ac-de7b-27d9-b665" type="atLeast"/>
                </conditions>
              </modifier>
