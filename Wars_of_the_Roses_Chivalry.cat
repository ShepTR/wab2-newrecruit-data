              </modifiers>
            </profile>
            <profile id="c033-4811-c13d-6c26" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and light armour. May upgrade to heavy armour (+1 pt). May have only one choice of halberd (+2 pts), thrusting spear (+1 pt), crossbow (+5 pts) or handgun (+4 pts). Crossbowmen and Handgunners may have pavises (+1 pt) if not in Mixed Order. Mixed Order: melee-weapon Continental Mercenaries with missile-weapon Continental Mercenaries. Availability: York, Lancaster, Tudor and Yorkist Pretenders. (Armies of Chivalry p.63)</characteristic>
              </characteristics>
            </profile>
            <profile id="46a8-d58d-ef58-ca58" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="86ce-58c8-f69c-897a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="28e1-0c8c-9316-56af" type="atLeast"/>
