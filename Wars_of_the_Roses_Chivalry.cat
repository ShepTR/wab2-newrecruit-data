                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Thrusting or throwing spear and shield (light armour as the entry reads). May be in Mixed Order with Welsh Longbowmen. Availability: Lancaster, York, Richard III and Henry Tudor. (Armies of Chivalry p.63)</characteristic>
              </characteristics>
            </profile>
            <profile id="2011-c99c-0007-c129" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="eff1-bd3a-1544-b527" name="Mixed Order (Chivalry)" hidden="false" targetId="5112-f682-7dc3-3910" type="rule"/>
            <infoLink id="5ba9-1a8b-6e76-afa7" name="Thrusting Spear" hidden="false" targetId="5a59-1efb-14ef-017a" type="profile">
