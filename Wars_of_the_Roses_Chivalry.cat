            <profile id="067f-e884-4ae5-0662" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Longbow, light armour, and hand weapon. May have a buckler (+1 pt). May have Stakes (+20 pts per unit) if not in Mixed Order. Stakes. May be in Mixed Order with Dismounted Men-at-Arms or Retinue Billmen. (Armies of Chivalry p.63)</characteristic>
              </characteristics>
            </profile>
            <profile id="e7da-3e29-3475-85bc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="5+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="dc9b-929d-b11d-da1a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f109-3abd-09fd-c14e" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
