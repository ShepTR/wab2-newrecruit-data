            <profile id="8ace-2b04-824f-f7a6" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Each gun has a crew of three; two additional crew may be added (+10 pts each). Crewmen have hand weapon and light armour and may upgrade to heavy armour (+2 pts). Light artillery range 36", Strength 6. Artillery: up to one gun for every 1,000 army points (bought from the Infantry allocation). Up to one gun for every 750 army points. (Armies of Chivalry p.63)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="63b2-e177-6edc-ee8b" name="Artillery (Chivalry)" hidden="false" targetId="dfeb-8f7d-cb3d-409f" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
          </costs>
