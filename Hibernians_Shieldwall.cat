                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="b174-d936-96b3-a158" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons, javelins and buckler. May have shield (+1 pt). May exchange javelins for double-handed axes (+2 pts). Light Infantry. Warband. Frenzied. Different Weapons. 0-1 unit. Dogs of War cannot be accompanied by characters and cannot benefit from the Army General and Standard Bearer rules; they may have a leader, standard and musician as normal. (Shieldwall p.77)</characteristic>
              </characteristics>
            </profile>
            <profile id="0fb3-6217-2697-706f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">6+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="8d2b-ac8d-fd5e-14eb" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6703-12c4-4fd5-62dd" type="atLeast"/>
