                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">6</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">None</characteristic>
              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="6+">
                <conditions>
                <condition field="selections" scope="06e0-4d70-665e-3d2e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="451f-9c36-8806-9020" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="436a-6dc4-88d4-25d5" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The Packmaster has hand weapons; Warhounds have teeth. The Packmaster may have javelins (+2 pts) and/or light armour (+3 pts). Skirmishers. Warband. Any hit inflicted by missile weapons should be randomly divided between the Packmaster and hounds. Each unit may contain a maximum of one Packmaster and up to six hounds. (Shieldwall p.63)</characteristic>
              </characteristics>
            </profile>
            <profile id="b518-d8b2-065f-b1d8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="06e0-4d70-665e-3d2e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="451f-9c36-8806-9020" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="66c5-3401-a432-898c" name="Warband" hidden="false" targetId="e230-5072-4109-a786" type="rule"/>
            <infoLink id="0aad-0608-7f37-5569" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
