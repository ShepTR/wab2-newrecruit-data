            <profile id="ec4b-396b-360a-6c20" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons, javelins and shield. May exchange their shields for double-handed axes (+1 pt). May be mounted (+8 pts per model), if so they count as light cavalry. Warband. Werod. 0-1 unit. Munster: may have light armour (+3 pts) and exchange javelins for thrusting spears (+3 pts); if armed with thrusting spear they may use Shieldwall. Leinster: light armour (+3 pts), throwing spears (+2 pts). Connacht: count as light infantry. Ulster: light armour (+3 pts) and may be Stubborn (+3 pts). (Shieldwall p.62)</characteristic>
              </characteristics>
            </profile>
            <profile id="46f0-22ae-a7c4-0512" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="None">
                <conditions>
                <condition field="selections" scope="4a8a-d76e-9e01-5d39" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0d52-2051-c04c-d3f7" type="atLeast"/>
