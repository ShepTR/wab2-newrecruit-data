                <conditions>
                <condition field="selections" scope="f53a-48ec-2aa2-6ef7" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9432-6b8d-9a2b-557f" type="atLeast"/>
