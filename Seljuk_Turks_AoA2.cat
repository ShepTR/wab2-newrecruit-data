            <profile id="96a1-de53-ffe3-681c" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The General rides a horse and has a hand weapon, light armour, composite bow and shield. Army General. May have heavy armour (+1), thrusting spear (+3) and cloth barding (+3).</characteristic>
              </characteristics>
