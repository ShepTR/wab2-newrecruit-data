              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Turcoman cavalry have a hand weapon and composite bow. Skirmishers. Nomad Cavalry. May have shield (+1) and throwing spear (+3) and cloth barding (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="8854-5359-961e-7bc9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
