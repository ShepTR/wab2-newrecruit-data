                <conditions>
                <condition field="selections" scope="29e6-776b-c877-d839" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="506e-3d74-b101-fb3e" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="2ce3-5cd3-cb67-5388" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All mercenaries have the Unreliable rule. Foot mercenaries have a hand weapon, thrusting spear and shield. They may have light armour (+2) and exchange thrusting spear and shield for crossbow (+1) or halberd (-1). If equipped with crossbows in late armies they may have pavises (+2). Foot Mercenaries with crossbows are Open Order.</characteristic>
              </characteristics>
            </profile>
            <profile id="93a9-cfc7-fdcc-d9b9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="29e6-776b-c877-d839" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="506e-3d74-b101-fb3e" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="9463-c19a-5abd-12dd" name="Allies and Mercenaries (Unreliable)" hidden="false" targetId="6e8f-14cf-a018-5d1c" type="rule"/>
