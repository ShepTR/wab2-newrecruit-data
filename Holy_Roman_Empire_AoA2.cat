                <characteristic name="T" typeId="d226-f704-80f9-6e23">4</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">2</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">5</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">2</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">3+</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
              </modifier>
              </modifiers>
            </profile>
            <profile id="b918-9ca5-4c36-20ae" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A Captain rides a warhorse and has a hand weapon, heavy or partial plate armour and shield. In Late armies he may have a lance (+6). Any Captain may be upgraded to Mercenary Captain (+30). Mercenary Captains are Unreliable and may only join a Mercenary unit. Any Mercenary unit within 8’’ of the Captain may use his Leadership value when taking a Leadership test, although he is not the Army General.</characteristic>
              </characteristics>
            </profile>
            <profile id="d4f1-2e5a-06fa-5719" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="aa76-d14e-f8db-81dd" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
            <infoLink id="647f-b2dd-1208-a96d" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="a1de-8540-e938-7c3c" name="Partial Plate Armour" hidden="false" targetId="8430-72da-5ac5-d33f" type="profile"/>
            <infoLink id="2030-555e-d2db-ecb7" name="Shield" hidden="false" targetId="b513-5c2a-34df-6a1d" type="profile"/>
            <infoLink id="bebf-c4a2-0591-5338" name="Holy Roman Empire (AoA2) - List Notes" hidden="false" targetId="fed8-bfd1-adc1-7961" type="rule"/>
          </infoLinks>
