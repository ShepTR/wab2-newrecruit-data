              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
                <conditions>
                <condition field="selections" scope="19c0-8a24-1031-1c05" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="c772-1b40-3419-4087" type="lessThan"/>
