          <profiles>
            <profile id="238e-1345-2877-8bae" name="Militia" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">2</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">2</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">6</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">None</characteristic>
              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="6+">
                <conditions>
                <condition field="selections" scope="b675-6af2-835c-f0ee" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8fa9-f206-926b-ad62" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="cf45-5715-4b69-ee90" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Militia have a hand weapon. They may have thrusting spear and shield (+3), or crossbows (+4), composite bows (+2) or in late army’s handguns (+4) or pike (+4). If equipped with crossbows in late armies, they may have pavises (+2). Militia with handguns are Skirmishers. Militia with crossbows or composite bows are Light Infantry, but if carrying pavises must form in Open Order. Militia with pikes are Medieval Phalanx. Any militia unit may be downgraded to Levies (-1 if armed with composite bow, 2 if armed with thrusting spear and shield, crossbow or handgun, -3 if armed with pike).</characteristic>
              </characteristics>
            </profile>
            <profile id="69f9-c9e8-f940-23e1" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="b675-6af2-835c-f0ee" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8fa9-f206-926b-ad62" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="a93f-589d-c480-c3c7" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="08db-8b8a-e565-445c" name="Shield" hidden="true" targetId="b513-5c2a-34df-6a1d" type="profile">
