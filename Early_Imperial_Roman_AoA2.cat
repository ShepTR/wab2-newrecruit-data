            <profile id="9990-7f83-2ac4-41ca" name="Equites Alares" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="8832-a681-b2ba-d58a" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Equites Alares and Cohort Cavalry have hand weapon, light armour, javelins, throwing or thrusting spear and shield. Light Cavalry. Equites Alares may be Drilled (+2). One unit of Drilled cavalry may be upgraded to Guards (WS4, BS4, +4). All Cohort Cavalry units should be smaller than the smallest Equites Alares unit. One unit of Equites Alares may be fielded as Legionary Cavalry. This unit may benefit from the Centurion upgrade (see Legionary Infantry below).</characteristic>
              </characteristics>
            </profile>
            <profile id="03bc-26ff-3b36-d361" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="214e-da66-8f7f-914e" name="Drilled" hidden="false" targetId="d6b3-51b2-64eb-2b91" type="rule"/>
            <infoLink id="ddc6-6426-c593-6845" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
