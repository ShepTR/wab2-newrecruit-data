              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Archers have a hand weapon, composite bow and buckler. Light Infantry. May have light armour (+2) and be Drilled (+2) and Veteran (+1). One unit may be upgraded to Elite (Ld8, +1).</characteristic>
              </characteristics>
            </profile>
            <profile id="27d6-2454-870a-c68c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">6+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="ba2a-c74d-6c20-b8b8" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7c42-ba75-36ef-71e0" type="atLeast"/>
