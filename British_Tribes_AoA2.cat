                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Improvised weapon and javelins. May have buckler (free) and may exchange javelins for sling (free). There may not be more sling units than javelin units, and no sling unit may be larger than the smallest javelin unit in the army.</characteristic>
              </characteristics>
            </profile>
            <profile id="3261-ff19-1f8a-a2b4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="6+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="541c-30f0-8d11-0e1d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0aa7-8525-f98b-5e7f" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="4197-c3fc-ee15-a353" name="Improvised Weapon" hidden="false" targetId="026a-8df7-0a12-0a18" type="profile"/>
            <infoLink id="3513-4db2-70ac-b23f" name="Javelin" hidden="false" targetId="10ef-3567-0d3f-d9e7" type="profile"/>
            <infoLink id="dbac-75b8-0e5f-17ea" name="Buckler" hidden="true" targetId="aa05-2e85-a1d8-8d69" type="profile">
