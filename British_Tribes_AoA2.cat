            <profile id="5951-dc4b-81a8-63b7" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, thrusting or throwing spear, javelins and shield. Army General. Warband. May ride a horse (+10) or a warhorse (+17) or a chariot as from the list below (+62). In each of these cases he becomes Ld8 but is no longer Warband.</characteristic>
              </characteristics>
            </profile>
