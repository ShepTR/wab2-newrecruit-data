            <profile id="61aa-5303-0598-bee4" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, partial plate armour and shield. May wear full plate armour (+2 pts if dismounted). Has a halberd or a double-handed weapon. Different Weapons if dismounted. Stubborn. First Charge. May be Veteran (+3 pts). Combined Formation; may include Turkopolen. When mounted, Brüder count a Rank Bonus of up to +1 in combat. Up to two units of Brüder (mounted and dismounted together; entered as 0-2 each) may be taken. One unit of Brüder may be upgraded to WS5 (+3 pts). (Armies of Chivalry p.42)</characteristic>
              </characteristics>
            </profile>
            <profile id="413b-e348-f379-922b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="6d0d-2856-657c-d213" name="Different Weapons" hidden="false" targetId="eef3-c374-e2ed-8cd9" type="rule"/>
