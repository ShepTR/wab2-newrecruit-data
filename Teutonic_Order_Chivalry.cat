  <sharedRules>
    <rule id="a55d-75f6-7396-4aed" name="The Teutonic Order (Armies of Chivalry) - List Notes" publicationId="da79-edc9-ea11-dbc4" hidden="false">
      <description>THE TEUTONIC ORDER 14th to late 15th century (Armies of Chivalry, pp.42-43).

ARMY COMPOSITION:
[The Teutonic Order]
  Characters: up to 25%
  Cavalry: up to 50%, at least 25%
  Infantry: up to 75%, at least 25%
  Characters 0-25%, Cavalry 25-50%, Infantry 25-75%. Artillery is bought from the Infantry allocation.</description>
    </rule>
  </sharedRules>
</catalogue>
