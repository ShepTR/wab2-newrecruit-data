                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="2+">
                <conditions>
                <condition field="selections" scope="0260-4f2c-bde2-0acf" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0f23-d2a2-d686-9f94" type="lessThan"/>
                <condition field="selections" scope="0260-4f2c-bde2-0acf" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e2ab-0c5d-ec6d-a0a0" type="lessThan"/>
