            <profile id="17ca-dbdc-c3d9-ba9f" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, partial plate armour and shield, lance and warhorse. May wear full plate armour (free if mounted). The warhorse may have cloth barding (+4 pts), or plate barding (+6 pts). Impetuous and First Charge if mounted. Mounted Crusader Knights count a Rank Bonus of up to +1 in combat. (Armies of Chivalry p.42)</characteristic>
              </characteristics>
            </profile>
            <profile id="fb19-2845-b8f1-ba7b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="0260-4f2c-bde2-0acf" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0f23-d2a2-d686-9f94" type="lessThan"/>
