              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Javelins and buckler. Skirmishers, Feigned Flight. No bow- or sling-equipped unit may outnumber the smallest javelin-equipped skirmisher unit. (Hannibal p.75)</characteristic>
              </characteristics>
            </profile>
            <profile id="54c6-d3a3-2681-b5bd" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
