              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, throwing spear and buckler. May have light armour (+2 pts) and javelins (+2 pts). Caetrati are skirmishers. Subject to the Allies &amp; Mercenaries special rule. (Armies of Antiquity p.23)</characteristic>
              </characteristics>
            </profile>
            <profile id="de40-9e33-040d-b1e4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="c2ef-080a-21c2-2141" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b06a-abbe-22bd-9035" type="atLeast"/>
