              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Heavy cavalry have hand weapon, throwing spear and shield. May have light armour (+2) and javelins (+1). May replace throwing spear with thrusting spear (free). May be Stubborn (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="a1cb-c8bb-5e7d-f609" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="dbc2-f046-0e3d-208b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b641-ecb5-347a-15bb" type="atLeast"/>
