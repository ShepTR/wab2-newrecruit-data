              <!-- sw-rule-Army General (Chariot Wars) -->
              <infoLinks>
                <infoLink id="3271-23fd-e64e-347e" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
              </infoLinks>
          <rules>
            <rule id="e7bc-905e-d6ac-11bd" name="Army General (+25 pts; if no other Army General)" hidden="false">
              <description>If no other Army General is taken, the Colonel may be made Army General for +25 pts.</description>
            </rule>
          </rules>
          <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <costs>
            <cost name="pts" typeId="points" value="75"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
