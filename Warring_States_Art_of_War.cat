                <characteristic name="A" typeId="ee87-e286-4768-82be">3</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">10</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">6+</characteristic>
              </characteristics>
            </profile>
            <profile id="9327-fe1d-ef3d-b758" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Special Character. Armed with a Noble sword, spear tipped halberd, light armour and horse (free; Movement 8"). May have a four-horse heavy chariot bought from the main list (not enforced). Army General. Warrior of Legend. Military Strategist. Stubborn. Famous general of the Qin state who secured the Ordos Loop from nomadic horse raiders, leading to the Great Wall. (The Art of War p.45)</characteristic>
              </characteristics>
            </profile>
            <profile id="89e5-3953-80c8-ae33" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="4681-2288-32df-c400" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
            <infoLink id="0264-ae1a-19d1-934e" name="Warrior of Legend" hidden="false" targetId="879e-372e-52e3-5bfb" type="rule"/>
            <infoLink id="61de-2c41-0342-5bdd" name="Military Strategist (Art of War)" hidden="false" targetId="a993-3dd8-9fb1-6761" type="rule"/>
            <infoLink id="d43a-c931-f9f3-6ac6" name="Stubborn (Art of War)" hidden="false" targetId="f116-0b2e-16ce-f7cc" type="rule"/>
