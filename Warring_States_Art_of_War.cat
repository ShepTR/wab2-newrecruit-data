            </profile>
            <profile id="2b95-05d3-b6d1-21c4" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon. May have a Noble Sword (+2 pts), shield (+2), light armour (+2), horse (free; Movement 8"). May ride in a four-horse heavy chariot bought from the Chariotry list (not enforced). Army General. 0-1 General (Yang or Yin): the heroic upfront school of generalship. (The Art of War p.42)</characteristic>
              </characteristics>
            </profile>
            <profile id="2246-ec1c-31ac-8413" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
