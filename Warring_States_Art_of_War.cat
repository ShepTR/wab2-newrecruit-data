            <profile id="f192-4f96-4925-715d" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Two crewmen with hand weapons armed with a repeat firing crossbow riding in a four-horse heavy chariot with driver. Crew may have light armour (+2 pts each) or heavy armour (+4 pts each). Chariots. Each turn the chariot moves it may fire D6 crossbow bolts at Strength 4; on a 1 the device is jammed and may not fire that turn. 0-1. (The Art of War p.44)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="ea9b-267e-3d79-d62f" name="Chariots" hidden="false" targetId="7637-c605-27c5-0aab" type="rule"/>
            <infoLink id="c01b-7579-d47c-318b" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="a591-658a-9793-8cac" name="Repeating Crossbow" hidden="false" targetId="aae1-ff76-b491-96e0" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="120"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
