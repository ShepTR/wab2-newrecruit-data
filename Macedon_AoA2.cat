            <profile id="d619-62c8-832a-fd85" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Agrianians, mercenaries and skirmishers have hand weapon, javelins and buckler. Agrianians may replace javelins with sling (free). Every second unit of mercenaries may replace javelins and buckler with composite bow (free). All are Skirmishers. There may be one unit of Agrianians for every two units of other skirmishers.</characteristic>
              </characteristics>
            </profile>
            <profile id="142e-183f-ebca-731f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="114a-9603-6f8d-cc50" name="Skirmishers (Art of War)" hidden="false" targetId="5c5e-9491-3100-c162" type="rule"/>
            <infoLink id="e7f2-8d5f-6715-e747" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="131e-80ab-c8c1-3289" name="Javelin" hidden="false" targetId="10ef-3567-0d3f-d9e7" type="profile"/>
            <infoLink id="6026-964b-56a2-9efc" name="Buckler" hidden="false" targetId="aa05-2e85-a1d8-8d69" type="profile"/>
