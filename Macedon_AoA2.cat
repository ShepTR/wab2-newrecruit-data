            <profile id="ac27-31e6-ac08-2efa" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hypaspists and Phalangites have hand weapon, pike and shield. They may have light armour (+2). Macedonian Phalanx. Mixed Armour. Hypaspists are Drilled; Phalangites may be Drilled (+2). One unit of each type may be Stubborn (+3). There may be one unit of Hypaspists for each unit of Phalangites in the army. At least one unit of Phalangites must be fielded. Hypaspists may alternatively be fielded with hand weapon, thrusting spear and large shield (-2), or hand weapon, javelins and shield (-3) in which case they are Drilled and Light Infantry. To represent the veteran nature of Alexander’s army later in his campaigns, Phalanx infantry can be upgraded to veterans with the Veteran rule for (+1) points.</characteristic>
              </characteristics>
            </profile>
            <profile id="541c-c6b3-0cbc-2b27" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="6312-b484-af18-a850" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4b85-cf4b-5980-6230" type="atLeast"/>
