            </profile>
            <profile id="34bd-dd7e-4af2-35b4" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Includes throwing spear, javelins, bow, and sword. May wear light armour +3 pts. May ride a warhorse +4 pts, the warhorse may have half-barding +2 pts. Or may ride in a four-horse light chariot at +15 pts, which includes one unarmed driver. Army General. The Great King: he is the Army General (if he flees off the table the army checks for panic as if he was killed); units within 12" gain +1 Leadership instead of using his Leadership for psychology and Break tests; certain units may only be included if the Great King is the General; he may only join Persian troops; he automatically flees if involved in a losing close combat that involves the enemy army general. 0-1. The Army General is either the Great King or a Satrapal General. (Alexander the Great p.92)</characteristic>
              </characteristics>
            </profile>
            <profile id="6a85-7605-847a-ae6d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="88cb-0f2b-36e2-bb8b" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="535c-931d-9201-de4b" type="atLeast"/>
