        <selectionEntry id="906e-8897-2378-c8c4" name="Noble Cavalryman" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="27a6-8788-74c6-a70d" type="min"/>
          </constraints>
          <profiles>
            <profile id="8793-6c31-37ef-29f5" name="Noble Cavalryman" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
            </profile>
            <profile id="da00-8890-302f-63a9" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword and throwing spears. May substitute thrusting spears for throwing spears. May have light armour +2 pts or heavy armour +3 pts. Noble Cavalry horses may have half barding +2 pts. 0-1 unit of Nobles may have short bows +1 pt. Levies. Massed Cavalry. Every second cavalry unit may be Noble Cavalry (not enforced). Bactrian, Kappadokian, Armenian and other effective native armoured cavalry. (Alexander the Great p.93)</characteristic>
              </characteristics>
            </profile>
            <profile id="9ec2-f6be-3b6d-8369" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="b5ef-9b41-845e-8f42" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="80d0-643c-dd36-a470" type="atLeast"/>
                <condition field="selections" scope="b5ef-9b41-845e-8f42" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ba28-edd7-b666-e82c" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="b5ef-9b41-845e-8f42" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="80d0-643c-dd36-a470" type="lessThan"/>
                <condition field="selections" scope="b5ef-9b41-845e-8f42" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ba28-edd7-b666-e82c" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="b5ef-9b41-845e-8f42" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="80d0-643c-dd36-a470" type="atLeast"/>
                <condition field="selections" scope="b5ef-9b41-845e-8f42" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ba28-edd7-b666-e82c" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
