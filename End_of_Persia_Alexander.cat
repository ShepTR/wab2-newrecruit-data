                <conditions>
                <condition field="selections" scope="80b1-72ad-516e-7dc0" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c1bf-ece5-95c9-3f1f" type="atLeast"/>
