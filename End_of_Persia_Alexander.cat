            <profile id="b9c1-12df-67f9-5399" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword. May have light armour +3 pts, heavy armour +4 pts, shield or buckler +1 pt (only if dismounted), throwing spear +2 pts, bow or javelins +2 pts. May ride a warhorse +4 pts, the warhorse may have half-barding +2 pts. A maximum of one Satrap may be taken for each Persian regiment, Levies, Nobles, and Shock cavalry unit in the army (not enforced). (Alexander the Great p.93)</characteristic>
              </characteristics>
            </profile>
            <profile id="4a6c-d78d-ee34-01f1" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
