                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="4d13-a43c-0cff-0a26" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, shield, and thrusting spears. May have light armour +2 pts. Large shields may be substituted for +1 pt. May have bows +2 pts. Combined Formation. Mixed armour. Melophorai (Apple Bearers) are stubborn, and only may be selected if the Great King is included. 0-1 unit. (Alexander the Great p.93)</characteristic>
              </characteristics>
            </profile>
            <profile id="a61e-e0db-ce2a-2e84" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="c11a-6b3a-4a27-a68c" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1d77-fc5a-1543-302c" type="atLeast"/>
