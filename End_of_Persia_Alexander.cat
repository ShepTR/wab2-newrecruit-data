              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Skirmishers are armed with dagger, javelins and buckler. Every second unit of Skirmishers may replace javelins and bucklers with bows +1 pt (not enforced). Levies. Skirmishers. (Alexander the Great p.94)</characteristic>
              </characteristics>
            </profile>
            <profile id="a321-1677-8b66-77d5" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
