            <profile id="c6c5-88e3-b673-25c9" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword and throwing spears. May substitute thrusting spears for throwing spears. May have light armour +2 pts or heavy armour +3 pts. Levies. Massed Cavalry. Loyal but less motivated horsemen such as the Medes, or Susians. (Alexander the Great p.93)</characteristic>
              </characteristics>
            </profile>
            <profile id="c865-296d-996a-8065" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="1b05-cd5a-9f3f-d582" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3aab-e538-ec57-d465" type="atLeast"/>
