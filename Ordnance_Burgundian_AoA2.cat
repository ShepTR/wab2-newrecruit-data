                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">4+</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
              </modifier>
              </modifiers>
            </profile>
            <profile id="8707-0714-1d7f-e8e6" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Retainers have hand weapon, lance and partial plate armour. They ride horses. Any unit may dismount (-12), M reduced to 4, and replace their lance with halberd. They gain the Riding Horses special rule. You may have up to 2 Retainers models per Knight model. Retainers may form the rear rank(s) of Knights units. The whole unit is a Combined Unit.</characteristic>
              </characteristics>
            </profile>
            <profile id="9c2e-9bb0-1a78-ad49" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="d71c-7f5b-a5e9-a6a1" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="90cb-84ba-e9c6-b742" name="Lance" hidden="false" targetId="a4b8-1d78-eb6b-c4f2" type="profile"/>
            <infoLink id="76f8-7e74-c68f-1035" name="Partial Plate Armour" hidden="false" targetId="8430-72da-5ac5-d33f" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="28"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
