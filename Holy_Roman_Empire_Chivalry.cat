                <condition field="selections" scope="e44c-a754-43a3-99c0" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b39d-c665-c4e3-2789" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
