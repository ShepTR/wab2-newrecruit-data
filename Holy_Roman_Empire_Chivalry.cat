              </infoLinks>
          <rules>
            <rule id="d863-82a2-7c47-f864" name="Army Standard Bearer (+15 pts)" hidden="false">
              <description>One Commander may be upgraded to Army General (+35 pts, +1 Wound); one other Commander may be upgraded to Army Standard Bearer (+15 pts), who may not upgrade equipment except for a warhorse and partial plate armour.</description>
            </rule>
          </rules>
          <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <costs>
            <cost name="pts" typeId="points" value="100"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
