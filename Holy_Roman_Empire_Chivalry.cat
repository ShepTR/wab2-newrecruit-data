      <selectionEntries>
        <selectionEntry id="c7dd-c715-f138-5664" name="Carrocio Wagon" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="93be-5528-5654-173d" type="min"/>
          </constraints>
          <profiles>
            <profile id="93f0-07ba-a0d5-da28" name="Carrocio Wagon" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">-</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">-</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">-</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">-</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">6</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">3</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">-</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">-</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">-</characteristic>
              </characteristics>
            </profile>
            <profile id="5ba5-f428-7cd3-5289" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The Carrocio (50 pts, plus the cost of the defenders; no handguns) is paid out of the Character points allowance and is an Army Standard Wagon - a regular Wagon (like Tabor wagons) as well as the Army Standard. It is placed last like other characters and is not restricted to the Tabor rule for placement, but cannot move once placed. Early Clerical and Early City armies where no Army Standard Bearer is chosen. (Armies of Chivalry p.41)</characteristic>
              </characteristics>
            </profile>
            <profile id="e7fd-5587-f307-819c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="81e2-4be4-ffe7-2f9f" name="Army Standard" hidden="false" targetId="41fc-5de5-0862-91b8" type="rule"/>
            <infoLink id="7525-f07f-395e-ec2d" name="Wagon Tabor (Chivalry)" hidden="false" targetId="b1b5-e018-17f8-3d3e" type="rule"/>
            <infoLink id="2d7b-a091-c163-f37c" name="Holy Roman Empire (Armies of Chivalry) - List Notes" hidden="false" targetId="ca59-2510-ce9e-ccce" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
          </costs>
        </selectionEntry>
