            <profile id="7633-1b73-013c-17a1" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, lance, heavy armour, shield and warhorse. May take partial plate armour instead of heavy armour (free). Warhorse may have cloth barding (+4 pts). Later Army: full plate armour (free). First Charge. Impetuous. May count Rank Bonus of up to +1. 0-2 units. Allies and Mercenaries rule applies. (Armies of Chivalry p.41)</characteristic>
              </characteristics>
            </profile>
            <profile id="e9c5-0105-0ce6-5048" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="e44c-a754-43a3-99c0" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0e64-4cf9-4e31-3224" type="lessThan"/>
