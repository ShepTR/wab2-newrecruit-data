                <characteristic name="W" typeId="ce59-af10-7f37-4238">2</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">-</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">-</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">-</characteristic>
              </characteristics>
            </profile>
            <profile id="22d2-d350-0ecb-e800" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Each gun has a crew of three; two additional crew may be added (+10 pts each). Crewmen have hand weapon and light armour and may upgrade to heavy armour (+2 pts). Multi-barrelled artillery (ribauld/organ-gun): fires with a template at Strength 4, can stand &amp; shoot when charged. Later armies only: one gun for every 1,000 army points (light artillery and multi-barrelled together). (Armies of Chivalry p.41)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="4c54-f598-d595-febd" name="Artillery (Chivalry)" hidden="false" targetId="dfeb-8f7d-cb3d-409f" type="rule"/>
            <infoLink id="1037-a719-8e59-3387" name="Multi-barrelled Artillery (Chivalry)" hidden="false" targetId="3546-8072-f93d-9bd9" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
          </costs>
        </selectionEntry>
