              <infoLinks>
                <infoLink id="c280-5a0d-96ae-a032" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
              </infoLinks>
          <rules>
            <rule id="4f76-5e70-841b-222d" name="Army General (+35 pts, +1 Wound)" hidden="false">
              <description>One Commander may be upgraded to Army General (+35 pts, +1 Wound); one other Commander may be upgraded to Army Standard Bearer (+15 pts), who may not upgrade equipment except for a warhorse and partial plate armour.</description>
            </rule>
          </rules>
          <costs>
                <cost name="pts" typeId="points" value="35"/>
              </costs>
            </selectionEntry>
