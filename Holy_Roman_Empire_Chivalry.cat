            <profile id="7e28-2f41-e347-eaf0" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and shield, thrusting spear. May take halberd or double-handed weapon instead of spear (+2 pts), and partial plate armour (+2 pts) instead of heavy armour. Later Army: full plate armour (+4 pts). One unit of Ritter may be Stubborn (+3 pts) and must be led by the Army General. Combined Formation; may combine with Ministerialen. 0-2 units. (Armies of Chivalry p.41)</characteristic>
              </characteristics>
            </profile>
            <profile id="f858-d0c6-4b58-1141" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="813f-a703-cc31-6bee" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5af5-087e-a0fd-c1be" type="atLeast"/>
                <condition field="selections" scope="813f-a703-cc31-6bee" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b536-0204-a2aa-9b9d" type="lessThan"/>
