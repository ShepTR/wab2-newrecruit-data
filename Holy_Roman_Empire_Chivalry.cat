                <constraint field="selections" scope="parent" value="0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2612-7b3a-8721-d4ed" type="min"/>
              </constraints>
              <!-- def-link -->
              <!-- sw-rule-Army General (Chariot Wars) -->
              <infoLinks>
                <infoLink id="6df8-9c5a-c7c6-da14" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
              </infoLinks>
          <rules>
            <rule id="7dfb-c34c-04a3-4c89" name="Army General (+35 pts, +1 Wound)" hidden="false">
              <description>One Commander may be upgraded to Army General (+35 pts, +1 Wound); one other Commander may be upgraded to Army Standard Bearer (+15 pts), who may not upgrade equipment except for a warhorse and partial plate armour. Imperial Commanders and Army Generals may only be chosen for Imperial armies.</description>
            </rule>
          </rules>
          <costs>
                <cost name="pts" typeId="points" value="35"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="6186-b935-1d2a-26b5" name="Army Standard Bearer (+15 pts)" hidden="false" collective="true" import="true" type="upgrade">
