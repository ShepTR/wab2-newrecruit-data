            </profile>
            <profile id="e84d-9439-48b8-6bed" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons, thrusting spears, light armour and shield. All may be equipped with javelins (+1 pt). May be mounted on horses (+8 pts). Shieldwall. Warband. Combined Units. Wessex: Veterans (once per battle may re-roll all hit dice; the army may not have more units of mounted Thegns than dismounted Thegns). Mercia: any unit may be designated as light infantry (cannot combine with Ceorls). Northumbria and Kent: may exchange thrusting spears for throwing spears at no additional cost. (Shieldwall p.23)</characteristic>
              </characteristics>
            </profile>
            <profile id="46fc-fd57-8afe-1eb0" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="7c18-a2f6-ff5a-50c0" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1426-0846-b7ac-4c5f" type="atLeast"/>
                </conditions>
