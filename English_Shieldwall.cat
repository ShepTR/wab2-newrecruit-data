              </characteristics>
            </profile>
            <profile id="2f6b-9545-9bca-193e" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons. May have shield (+2 pts) or additional hand weapon (+3 pts). May have throwing spear (+2 pts), double-handed axe (+3 pts) and javelins (+1 pt). Light Infantry. Fury of the Norsemen. Subject to Warband psychology rule 2. Different Weapons. 0-1 unit. Dogs of War cannot be accompanied by characters and cannot benefit from the Army General and Standard Bearer rules. (Shieldwall p.78)</characteristic>
              </characteristics>
            </profile>
            <profile id="bf10-7a40-7f42-e96b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="da72-4723-9438-b318" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c85b-dbd0-13f4-d393" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="38fb-cfa7-226b-13b0" name="Fury of the Norsemen" hidden="false" targetId="50ff-a1ae-ebe2-ce60" type="rule"/>
            <infoLink id="bd0e-4084-2515-628d" name="Warband Psychology (rule 2)" hidden="false" targetId="ff60-649f-f2b4-afff" type="rule"/>
