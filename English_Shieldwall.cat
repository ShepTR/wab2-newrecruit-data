              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="a881-e297-9c94-4f53" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="534b-62ef-3dce-cf1e" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="c6f9-accc-6a2e-34a6" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, shield and either throwing spear or thrusting spear. May upgrade armour to heavy armour (+1 pt), have javelins (+1 pt). Roll a dice the first time each unit wishes to move, charge or shoot: on a 1 it stays stationary and may not shoot (it may defend itself); on a 2-6 it may act as the player wishes. (The printed dismounted profile row has one value fewer than the header; Toughness 3 assumed.) Dogs of War cannot be accompanied by characters and cannot benefit from the Army General and Standard Bearer rules. (Shieldwall p.78)</characteristic>
              </characteristics>
            </profile>
            <profile id="8f4d-8204-295b-9732" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="a881-e297-9c94-4f53" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="534b-62ef-3dce-cf1e" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="e984-5cc4-2f70-15a0" name="Unreliable Mercenaries" hidden="false" targetId="b84a-af9a-c600-836a" type="rule"/>
