            <profile id="3b3f-80b5-91b8-34d3" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mounted milites (warhorses). Hand weapon, light armour, shield and either throwing spear or thrusting spear. May upgrade armour to heavy armour (+1 pt), have javelins (+1 pt). May receive up to a +1 rank bonus when mounted. Roll a dice the first time each unit wishes to move, charge or shoot: on a 1 it stays stationary and may not shoot (it may defend itself); on a 2-6 it may act as the player wishes. Dogs of War cannot be accompanied by characters and cannot benefit from the Army General and Standard Bearer rules. (Shieldwall p.78)</characteristic>
              </characteristics>
            </profile>
            <profile id="fdd8-55d0-e3e2-ef28" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="7aa2-2e7f-5c7a-c26a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d19a-ea42-8dcb-40cc" type="atLeast"/>
                </conditions>
