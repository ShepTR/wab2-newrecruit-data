            <profile id="ae3c-3032-02ae-10f6" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons, thrusting spears and shield. Shieldwall. Warband. Combined Units (the army may combine Ceorls with the Huscarls and Thegns). Kent: may exchange thrusting spears for throwing spears at no additional cost. Not available to Northumbria or Anglia. (Shieldwall p.23)</characteristic>
              </characteristics>
            </profile>
            <profile id="663d-6ccc-30b3-a5f3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="fb7c-3d8c-2f3a-ae4c" name="Shieldwall" hidden="false" targetId="2544-dbe7-a088-2de7" type="rule"/>
