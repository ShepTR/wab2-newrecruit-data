            <profile id="d149-a64d-b8a3-b0c2" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons, light armour and buckler. May exchange buckler for shield (+1 pt), have javelins (+2 pts), throwing spears (+2 pts) or thrusting spears (+2 pts). May be mounted (+8 pts). Warband. Hatred. If the unit is within charge range of a character or unit containing a character then it must charge (the exiles hold him responsible for their predicament). 0-1 unit. (The printed profile row has one value fewer than the table header; Toughness 3 assumed.) Dogs of War cannot be accompanied by characters and cannot benefit from the Army General and Standard Bearer rules. (Shieldwall p.77)</characteristic>
              </characteristics>
            </profile>
            <profile id="0bf4-e5de-9f4f-4ded" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">5+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="fd13-f9c5-5f2d-11bc" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a8aa-e751-dda3-4049" type="atLeast"/>
                <condition field="selections" scope="fd13-f9c5-5f2d-11bc" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d7b3-c136-654b-ddf8" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="-">
                <conditions>
                <condition field="selections" scope="fd13-f9c5-5f2d-11bc" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a8aa-e751-dda3-4049" type="atLeast"/>
                <condition field="selections" scope="fd13-f9c5-5f2d-11bc" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d7b3-c136-654b-ddf8" type="lessThan"/>
                </conditions>
