            <profile id="e513-856f-61c3-3abb" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The General rides a horse and has a hand weapon, heavy armour and shield. May have a thrusting spear (+3) or a lance (+6). He may ride a warhorse (+7) that may have cloth barding (+2). Army General.</characteristic>
              </characteristics>
            </profile>
