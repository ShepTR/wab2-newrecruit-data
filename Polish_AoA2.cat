                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="c252-6dd8-16d3-62da" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Strzelcy have hand weapon, thrusting spear, light armour and shield. They may exchange their thrusting spear and shield for a light crossbow (-2). They may be in Combined Formation with Rycerz, forming initially the rear rank(s) of the unit. If armed with light crossbows, the first rank of crossbowmen may shoot over any front rank(s) at full effect, even when moving. This is an exception to normal rules for Combined Formation. The number of Strzelcy models may be more than twice the number of Rycerz.</characteristic>
              </characteristics>
            </profile>
            <profile id="7385-123a-a6ad-76a1" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="efca-829d-c49b-3acc" name="Combined Formations" hidden="false" targetId="e22b-5445-d10a-9d89" type="rule"/>
