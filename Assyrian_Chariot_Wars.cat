        <selectionEntry id="9294-17c0-6187-3a8d" name="Greek/Lydian Hoplite" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e55c-4d07-aa2b-f8de" type="min"/>
          </constraints>
          <profiles>
            <profile id="bab2-a0fa-93ab-9e58" name="Greek/Lydian Hoplite" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
              </modifier>
              </modifiers>
            </profile>
            <profile id="85da-3c91-2b6f-7315" name="Equipment and options (as printed in WAB2 army list)" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, thrusting spear, shield and heavy armour. Stubborn. May only be used in Babylonian armies. 0-1 unit. Phalanx: in a unit of at least sixteen models with a rank bonus of at least +1: cavalry may not charge the front of the phalanx; phalanx models may charge and still fight in two ranks; all enemy attacks (shooting and hand-to-hand) at the front of the phalanx suffer -1 to hit. The only formation change allowed is an about face; may wheel, but cannot march or charge if they do so; may drift 1" to the right when they march or charge. As soon as it is reduced to less than sixteen models or loses its rank bonus these rules no longer apply. (Chariot Wars p.61)</characteristic>
              </characteristics>
            </profile>
            <profile id="4fff-abe6-27b5-2aad" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8eae-7351-1453-57b9" name="Stubborn" hidden="false" targetId="ce73-f053-8ef6-626c" type="rule"/>
            <infoLink id="164c-89aa-5b37-51c6" name="Phalanx (Chariot Wars)" hidden="false" targetId="196f-b39b-7a43-d796" type="rule"/>
            <infoLink id="510f-b702-3eae-aca4" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="05bb-f90e-7a1b-c6a7" name="Thrusting Spear" hidden="false" targetId="5a59-1efb-14ef-017a" type="profile"/>
            <infoLink id="b801-d439-ecf7-507d" name="Shield" hidden="false" targetId="b513-5c2a-34df-6a1d" type="profile"/>
            <infoLink id="ba55-ebdd-6bce-822a" name="Heavy Armour" hidden="false" targetId="16c5-d2b2-fa96-9cd2" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="19"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
  </selectionEntries>
  <sharedRules>
    <rule id="a01d-6c4a-83a8-748c" name="Assyrian Empire (Chariot Wars) - List Notes" publicationId="513c-2d0a-024a-da5a" hidden="false">
      <description>ASSYRIAN EMPIRE ARMY LIST (Chariot Wars, pp.53-61), 745 BC to 610 BC. The list can also represent a Babylonian army of the same period.
Characters up to 25%; at least one character to command. A small army of 1,000 points can be commanded by a Senior Officer (Shaknu) rather than a General (King or Turtanu). Chariotry &amp; Cavalry up to HALF the points value. Infantry at least 25%. Allies &amp; Mercenaries: Assyrian army up to a quarter; Babylonian army up to half. Only a Babylonian army can include Elamites or Hoplites.

ARMY COMPOSITIONS:
[Assyrian Empire - Assyrian]
  Characters: up to 25%
  Chariotry &amp; Cavalry: up to 50%
  Infantry: at least 25%
  Allies &amp; Mercenaries: up to 25%
  Assyrian army: Allies &amp; Mercenaries up to a quarter of the points. Assyrian special rules (Terror, Highly Professional) apply. No Elamites, Medes or Hoplites.
[Assyrian Empire - Babylonian]
  Characters: up to 25%
  Chariotry &amp; Cavalry: up to 50%
  Infantry: at least 25%
  Allies &amp; Mercenaries: up to 50%
  Babylonian army: Allies &amp; Mercenaries up to half the points. Assyrian special rules do not apply. May include an army standard bearer for free (pay for his chariot as normal). May not include Assyrian Cavalry, Assyrian Kisir Sharruti Infantry, Heavy Slingers or Urartians. Only Babylonian armies may include Chaldeans armed with spears and shields, Elamite Chariots or Cavalry, Medes or Hoplites.</description>
    </rule>
  </sharedRules>
</catalogue>
