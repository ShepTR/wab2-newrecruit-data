                <characteristic name="W" typeId="ce59-af10-7f37-4238">2</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">2</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
            </profile>
            <profile id="de50-7557-8e4c-ff75" name="Equipment and options (as printed in WAB2 army list)" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Two crew armed with thrusting spear, shield and light armour riding in a four-horse heavy chariot with a driver. One crewman has a bow. May have an extra crewman adding +1 to Attacks (+5 pts per chariot). Archer may have darts (siltahi, count as javelins) kept in quivers at front of chariot (+2 pts). Chariot archers do not suffer the -1 to hit for shooting on the move. Automatic hits inflicted by a charging heavy chariot are added to the hits scored by the crew and happen at the same time. (Chariot Wars p.57)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="54f9-9753-82d0-e0ff" name="Chariot Archers (Assyrian)" hidden="false" targetId="83ab-9c36-3a60-49fd" type="rule"/>
            <infoLink id="3a6d-7f78-fef9-4d90" name="Thrusting Spear" hidden="false" targetId="5a59-1efb-14ef-017a" type="profile"/>
            <infoLink id="b2c4-1817-fc3a-c7a5" name="Shield" hidden="false" targetId="b513-5c2a-34df-6a1d" type="profile"/>
            <infoLink id="af52-b173-1d27-6500" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
            <infoLink id="6afd-8d8c-2879-aec9" name="Bow" hidden="false" targetId="5d29-ba1e-8299-8085" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="97"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
