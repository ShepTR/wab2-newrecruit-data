        <selectionEntry id="8e73-6979-64e8-1285" name="Auxiliary" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="687d-6cb5-b541-412b" type="min"/>
          </constraints>
          <profiles>
            <profile id="579d-4649-29e9-fd46" name="Auxiliary" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">5</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
              </characteristics>
            </profile>
            <profile id="0705-9481-9e46-3899" name="Equipment and options (as printed in WAB2 army list)" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Half the unit are armed with sword, thrusting spear and shield. The other half are armed with swords and composite bows. Light Infantry. A single rank of archers may shoot over a single rank of spearmen. Crossing Water: one unit of Auxiliaries in the army may be equipped with inflated goatskins (+1 pt each) to cross water obstacles at half their Movement rate; you must have at least five models converted to represent swimming troops. (Chariot Wars p.58)</characteristic>
              </characteristics>
            </profile>
            <profile id="aa84-681a-a4cc-9ce9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="2a4a-833d-c4c6-60b1" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="9e4f-e41c-f1fe-1d06" name="Thrusting Spear" hidden="false" targetId="5a59-1efb-14ef-017a" type="profile"/>
            <infoLink id="197b-bf67-5eee-082c" name="Shield" hidden="false" targetId="b513-5c2a-34df-6a1d" type="profile"/>
            <infoLink id="7a43-dbe8-55dc-fc40" name="Bow" hidden="false" targetId="5d29-ba1e-8299-8085" type="profile"/>
