        <selectionEntry id="f83e-a5a1-972a-5b37" name="Mounted Infantry" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1b92-e927-c123-b9fe" type="min"/>
          </constraints>
          <profiles>
            <profile id="297d-cf6b-1edd-2583" name="Mounted Infantry" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">3</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
              </characteristics>
            </profile>
            <profile id="f6de-46eb-d00c-18a2" name="Equipment and options (as printed in WAB2 army list)" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a sword, composite bow and light armour. The entire unit is mounted on two-wheeled carts (Mule Cart, M6, free), each drawn by two mules and carrying up to five soldiers. The unit must be equipped with the required number of cart models. The infantry automatically dismount from the carts to fight or shoot, even if charged. The carts are non-combatant and always placed directly behind any dismounted infantry; they do not count as chariots. When mounted on carts the unit may march move but may not charge. Dismounted infantry must remount to be able to flee. 0-1 unit. (Chariot Wars p.59)</characteristic>
              </characteristics>
            </profile>
            <profile id="2eb8-85b3-de90-b366" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="9b01-e3e1-f91e-ab20" name="Mule Carts" hidden="false" targetId="bcac-aba6-f4aa-7196" type="rule"/>
            <infoLink id="da19-6479-8612-a577" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="3b4c-e076-da0d-fcc4" name="Bow" hidden="false" targetId="5d29-ba1e-8299-8085" type="profile"/>
            <infoLink id="13b8-0878-a7d5-47eb" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="8"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
