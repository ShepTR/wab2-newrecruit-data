              </characteristics>
            </profile>
            <profile id="3a86-540e-9caa-7aa0" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with spear tipped halberds or swords and shields. May have light armour (+2 pts). May exchange spear tipped halberds or swords and shields for improvised weapon and either bow (+1 pt) or crossbow (+2 pts). No Flags No Trumpets. Looting. (The Art of War p.110)</characteristic>
              </characteristics>
            </profile>
            <profile id="7fab-c90a-5ed9-0286" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="795b-a9e8-2b52-d2f7" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="cf86-2ad7-2d39-cbd9" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="80e0-70aa-fe99-8ed4" name="No Flags, No Trumpets (Art of War)" hidden="false" targetId="fdc0-f42c-7701-aa34" type="rule"/>
