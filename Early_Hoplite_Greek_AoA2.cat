            <profile id="3954-9297-9d73-57ac" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have hand weapons, thrusting spear and large shield. Phalanx. May take light armour (+2) or heavy armour (+3).</characteristic>
              </characteristics>
