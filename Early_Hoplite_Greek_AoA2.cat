            <profile id="b844-eeaf-4193-d7e5" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have hand weapons, thrusting spear and large shield. Phalanx. May take light armour (+2) or heavy armour (+3). Mercenary Hoplites may upgrade to WS4, Trained Phalanx (+3) as Elites. Mercenary Hoplites are not subject to the Allies and Mercenaries rule, unless you take them from your Allies and Mercenaries points allowance.</characteristic>
              </characteristics>
            </profile>
            <profile id="8a57-131c-bed4-cd4f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
