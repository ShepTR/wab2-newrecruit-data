            <profile id="291a-a402-640f-0499" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour, and shield. Must have a horse (free) or warhorse (+4 pts) if mounted. The warhorse may have half (+4 pts) or lamellar (plate) barding (+6 pts). May wear partial plate or full plate armour (free if mounted; partial plate is +4 pts if dismounted; full plate is +6 pts if dismounted). Army Standard Bearer. Eastern Shock Cavalry if mounted. 0-1. (Vlad the Impaler p.87)</characteristic>
              </characteristics>
            </profile>
            <profile id="82a1-c2d0-4dcd-6c9a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="e791-f050-14af-b891" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="795e-4549-40d8-6808" type="atLeast"/>
