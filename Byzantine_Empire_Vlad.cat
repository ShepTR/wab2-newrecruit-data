              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and bow. May substitute javelins and buckler for bow. 0-1 unit may take crossbows, or handguns after 1421 (+2 pts). Skirmishers. (Vlad the Impaler p.88)</characteristic>
              </characteristics>
            </profile>
