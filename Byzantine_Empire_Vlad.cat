            </profile>
            <profile id="9b51-1d2f-589d-0adb" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour, shield, thrusting spear, and bow. May have partial or full plate armour (partial plate is +2 pts if dismounted; full plate is +3 pts if dismounted), but may not then have a bow. May exchange thrusting spears for halberds. Stubborn. Guard Archers. Oiketai must be the smallest infantry or cavalry unit taken. May only be fielded if the Paleologan Emperor is taken. 0-1 (Oiketai, mounted or dismounted). (Vlad the Impaler p.88)</characteristic>
              </characteristics>
            </profile>
            <profile id="c4b9-0263-4e7b-a942" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="7fef-9884-02c5-0a9b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="dc41-276e-f7fd-d87c" type="atLeast"/>
                <condition field="selections" scope="7fef-9884-02c5-0a9b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="02e5-6932-94a0-fd01" type="lessThan"/>
