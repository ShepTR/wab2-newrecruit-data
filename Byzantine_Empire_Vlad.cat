            <profile id="f2df-91fc-3c10-e842" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, shield, thrusting spear, and horse. May have a bow (+3 pts) and may have heavy armour (+2 pts). Open Order and Eastern Shock Cavalry if mounted. (Vlad the Impaler p.87)</characteristic>
              </characteristics>
            </profile>
            <profile id="9f44-80d3-3f15-fe20" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
