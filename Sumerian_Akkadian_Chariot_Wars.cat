            </profile>
            <profile id="4cf8-ec72-b50c-9e23" name="Equipment and options (as printed in WAB2 army list)" publicationId="513c-2d0a-024a-da5a" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and thrusting spear. Ur-style spearmen may have light armour +2; Lagash-style spearmen may have large shields +2. Akkadian spearmen can have equipment of either type. If the unit has large shields every model is treated as shielded. (Chariot Wars p.9)</characteristic>
              </characteristics>
            </profile>
            <profile id="0eef-7cc8-a8a4-ca21" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="049c-e07f-9c49-48d3" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="21a6-f0be-6781-0ccc" type="atLeast"/>
