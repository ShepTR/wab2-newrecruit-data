              </characteristics>
            </profile>
            <profile id="6fe0-2e8a-9a3e-bf32" name="Equipment and options (as printed in WAB2 army list)" publicationId="0641-2ee1-c462-c414" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, and thrusting spear. May substitute thrusting spear with javelin (free) or xyston +2 pts. May have light armour +2 pts, or heavy armour +3 pts. Unarmoured cavalry may operate as Light Cavalry. 0-1 unit; one cavalry unit is allowed for each Hoplite or Peltast unit of Mercenaries. (Alexander the Great p.80)</characteristic>
              </characteristics>
            </profile>
            <profile id="5c84-5110-f423-5e67" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
