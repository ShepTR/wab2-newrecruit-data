              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelins, and pelta (buckler). May add thrusting spear +1 pt and may upgrade to shield +1 pt. Light Infantry. (Alexander the Great p.80)</characteristic>
              </characteristics>
            </profile>
            <profile id="a3fb-e92b-d601-ac34" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
