            </profile>
            <profile id="4618-51b4-682a-4f44" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, bow, shield and a horse. May have a thrusting spear (+2 pts). Every other unit of Boieri may be upgraded to Curteni with Ld 8 (+2 pts). Curteni may wear heavy armour (+2 pts). Eastern Shock Cavalry. (Armies of Chivalry p.49)</characteristic>
              </characteristics>
            </profile>
            <profile id="8add-6627-d3d5-dc68" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="83b0-89ad-95b7-d80f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0795-69eb-ada2-d48a" type="atLeast"/>
