            <profile id="3d2c-2cf3-8e25-2667" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and a shield. May be mounted on a horse (+8 pts) or a warhorse (+16 pts). May have a thrusting spear (+2 pts) and may wear partial plate armour (+2 pts). If on foot, may have a two-handed weapon (+2 pts). May take either the Voievod or the Vornic as the Army General. (Armies of Chivalry p.46)</characteristic>
              </characteristics>
            </profile>
            <profile id="5e35-018e-6de8-f648" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
