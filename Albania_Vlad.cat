            <profile id="7de2-cfb0-dfaf-9df0" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, shield, and heavy armour. May take partial or full plate armour (free if mounted). Must take warhorse and lance. May take cloth barding (+4 pts). If mounted, may count rank bonus up to +1 in combat. Allies and Mercenaries. (Vlad the Impaler p.80)</characteristic>
              </characteristics>
            </profile>
            <profile id="c82b-4689-9f10-5022" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
