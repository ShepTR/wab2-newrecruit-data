            <profile id="9f20-4d12-8ffb-cc97" name="Equipment and options (as printed in WAB2 army list)" publicationId="eb14-e889-c793-0fc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Points cost and stats as Spartacus's Untrained Slaves. One Herdsmen or Untrained Slave unit may have integral dogs (+30 pts) in the First Sicilian Slave Revolt army: the Dogs do not actually fight, cannot be targeted or otherwise killed, do not add to the strength of the unit, but cause the owning unit to cause fear in enemy skirmishers, light infantry in skirmish order or cavalry. (Spartacus p.42)</characteristic>
              </characteristics>
            </profile>
            <profile id="d70e-2b6b-1642-7454" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="d7c9-c0a7-4308-bb00" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f744-f548-4327-ac4d" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
