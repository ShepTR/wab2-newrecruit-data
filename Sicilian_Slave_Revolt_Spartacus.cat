          <!-- def-link -->
          <rules>
            <rule id="c081-92ee-c832-9d70" name="Dogs (+30 pts; one unit)" hidden="false">
              <description>One Herdsmen or Untrained Slave unit may have integral dogs (+30 pts) in the First Sicilian Slave Revolt army: the Dogs do not actually fight, cannot be targeted or otherwise killed, do not add to the strength of the unit, but cause the owning unit to cause fear in enemy skirmishers, light infantry in skirmish order or cavalry.</description>
            </rule>
          </rules>
          <!-- ac-flat -->
<costs>
            <cost name="pts" typeId="points" value="30"/>
          </costs>
