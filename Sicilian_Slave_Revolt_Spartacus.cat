            <profile id="79e3-006d-3e30-da26" name="Equipment and options (as printed in WAB2 army list)" publicationId="eb14-e889-c793-0fc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Points cost and stats as Spartacus's Trained Slaves. In the First Sicilian Slave Revolt the Slave units may not take pilum or large shield. Titus Minutius's army may have up to two Trained Slave units. (Spartacus p.42)</characteristic>
              </characteristics>
            </profile>
            <profile id="9c18-6ddc-cafd-9eac" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="f25e-da0c-8522-ec5f" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a9b4-3009-2692-7418" type="atLeast"/>
