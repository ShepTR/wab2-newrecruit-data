            </profile>
            <profile id="7812-c8ed-7662-9c95" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, javelins and buckler. They may replace javelins and buckler with composite bow (+1) or sling (free). Skirmishers may be fielded as Levy (-1). All are Skirmishers. One unit of skirmishers may be upgraded to WS3, BS4, LD7 armed with bow (+8) as Cretans but this must be the smallest skirmishing unit in the army. Note that the Allies and Mercenaries rule does not apply to these troops.</characteristic>
              </characteristics>
            </profile>
            <profile id="b878-60a2-7a4b-4f32" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="908b-318b-a8ab-dc42" name="Skirmishers (Art of War)" hidden="false" targetId="5c5e-9491-3100-c162" type="rule"/>
