                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">5+</characteristic>
              </characteristics>
              <modifiers>
                <!-- sv-stat -->
              <modifier type="set" field="7349-090e-ca0b-09ce" value="4+">
                <conditions>
                <condition field="selections" scope="8536-5682-1de8-bf46" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="41fd-d4e8-ada0-58a1" type="atLeast"/>
                </conditions>
              </modifier>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="3">
                <conditions>
                <condition field="selections" scope="8536-5682-1de8-bf46" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="41fd-d4e8-ada0-58a1" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="6a95-b305-986f-1604" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, large shield and heavy throwing spear. May have light armour (+2) and javelins (+1). Elite Legionaries may be Drilled (+2), Stubborn (+3) and Veteran (+1). Legionary units are led by a Centurion who costs 10 points rather than the usual 5-point leader cost. The Centurion increases the Ld of the unit by 1. He counts as a normal leader in every other respect.</characteristic>
              </characteristics>
            </profile>
            <profile id="6423-5986-00e1-efe6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="8536-5682-1de8-bf46" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="41fd-d4e8-ada0-58a1" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="5199-6dbe-6023-5abf" name="Stubborn" hidden="false" targetId="ce73-f053-8ef6-626c" type="rule"/>
            <infoLink id="120e-a455-376a-ae9b" name="Veteran" hidden="false" targetId="4c9b-509e-486d-f0af" type="rule"/>
            <infoLink id="21d1-ec68-633c-e7ba" name="Drilled" hidden="false" targetId="d6b3-51b2-64eb-2b91" type="rule"/>
