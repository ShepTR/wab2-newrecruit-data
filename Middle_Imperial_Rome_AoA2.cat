              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Equites Alares have a hand weapon, light armour, javelins, thrusting or throwing spear and shield. Light Cavalry. May be Drilled (+2). One unit of Drilled cavalry may be upgraded to Guards (WS4, BS4, +4).</characteristic>
              </characteristics>
            </profile>
            <profile id="af47-4b6d-f9c8-0187" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
