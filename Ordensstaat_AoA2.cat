            <profile id="77df-b8fd-0e82-d460" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Infantry have a hand weapon, light armour, thrusting spear and shield. They may have heavy armour (+1) or in late armies, partial plate armour (+2). They may exchange thrusting spear and shield for crossbows (+1) and if equipped with crossbows may (in late armies) have pavise (+2). Infantry may be Stubborn (+3). If equipped with crossbows, they are Open Order.</characteristic>
              </characteristics>
            </profile>
            <profile id="5a95-9c7e-c857-eea9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="949e-0fca-91ab-4e2d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="04c7-6cca-ccad-3d7c" type="atLeast"/>
                <condition field="selections" scope="949e-0fca-91ab-4e2d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="649c-9951-c5e1-0e4a" type="lessThan"/>
                <condition field="selections" scope="949e-0fca-91ab-4e2d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2226-2f1b-32e0-80c1" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="949e-0fca-91ab-4e2d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="04c7-6cca-ccad-3d7c" type="lessThan"/>
                <condition field="selections" scope="949e-0fca-91ab-4e2d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="649c-9951-c5e1-0e4a" type="atLeast"/>
                <condition field="selections" scope="949e-0fca-91ab-4e2d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2226-2f1b-32e0-80c1" type="lessThan"/>
