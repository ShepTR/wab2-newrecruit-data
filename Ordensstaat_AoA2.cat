                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="4+ with Pavise +2 when shot at from the front only">
                <conditions>
                <condition field="selections" scope="152d-4c85-73c0-cd6d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d2fc-2387-4733-4bd2" type="atLeast"/>
