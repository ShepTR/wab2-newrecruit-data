                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="d458-82ea-8ba6-4928" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and shield. Rides a warhorse. May have a lance (+6). The warhorse may have a cloth barding (+3) or (in a Late Army) a full metal barding (+4). Army General. Veteran.</characteristic>
              </characteristics>
            </profile>
            <profile id="59f1-f776-ca3e-1156" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="7215-bb90-7b36-6cae" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5344-c17c-8bc7-122c" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
