            <profile id="1f49-3d13-182f-6965" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The Commander has a hand weapon, heavy armour and shield. Veteran. He may ride a warhorse (+16) that may have a cloth barding (+3) and if mounted, may have a lance (+6). If dismounted, he may have a double-handed weapon (+3). In a Late Army, he may have partial plate armour (+1) or a full plate armour (+2) and the warhorse may have full metal barding (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="c0f6-27cc-8f48-dce7" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
