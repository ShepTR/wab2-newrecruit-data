                <condition field="selections" scope="949e-0fca-91ab-4e2d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="04c7-6cca-ccad-3d7c" type="lessThan"/>
                <condition field="selections" scope="949e-0fca-91ab-4e2d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="649c-9951-c5e1-0e4a" type="lessThan"/>
