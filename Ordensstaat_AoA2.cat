            <profile id="f671-b38a-1b3b-aa81" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Turkopolen have a hand weapon, light armour, throwing or thrusting spear and shield. They may have heavy armour (+1) or exchange throwing spear and shield for light crossbows (-2).</characteristic>
              </characteristics>
