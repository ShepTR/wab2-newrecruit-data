            <profile id="5b96-fd02-f818-1300" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Dismounted Brother Knights have a hand weapon and heavy armour. Stubborn. Veteran. They may have a shield (+1) and in late armies, partial plate armour (+1) or full plate armour (+2). They may have a thrusting spear (+2) or double-handed weapon (+3). Brother Knights may re-roll any failed Panic test. Other Troops</characteristic>
              </characteristics>
            </profile>
            <profile id="1356-35b8-822a-a2dc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
