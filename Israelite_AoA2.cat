              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Chariots Driver armed with hand weapon and shield, and one crewman armed with hand weapon, bow, javelins, light armour and shield. Crewman may have thrusting spear (+6 points). Light Chariots. Expert Horseman.</characteristic>
              </characteristics>
            </profile>
            <profile id="022f-0659-5cd3-b6c8" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
