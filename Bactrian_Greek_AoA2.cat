                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
                <conditions>
                <condition field="selections" scope="0cc4-51fa-51ba-b110" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fe77-1fd2-212e-26ee" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="51dc-d414-180f-5624" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Saka Nobles have hand weapon, heavy armour, kontos and half barding. Wedge. May take Cataphract armour and Kontos (+5) points a model and then become Cataphracts but lose wedge. If they take cataphract armour may take barding (+4) points a model.</characteristic>
              </characteristics>
            </profile>
            <profile id="9b44-1631-1fca-5beb" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="0cc4-51fa-51ba-b110" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fe77-1fd2-212e-26ee" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="72fc-adb4-d992-eeb1" name="Wedge" hidden="false" targetId="1c16-3adf-a97d-1db8" type="rule"/>
            <infoLink id="8157-51d6-69b4-7a1b" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
