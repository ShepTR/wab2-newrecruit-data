            </profile>
            <profile id="32dc-ea2a-bf0d-92f2" name="Equipment and options (as printed in WAB2 army list)" publicationId="28aa-c13e-b61d-4f3e" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, javelins and Saxon buckler. May have light armour (+3), throwing spears (+4), horse (+8). One Atheling may be upgraded to Army Standard Bearer (+15); if no Cyning, one Atheling may be upgraded to Army General (+25). One Character Advantage (two if Army General). (The Age of Arthur p.49)</characteristic>
              </characteristics>
            </profile>
            <profile id="4429-7c83-0874-29b1" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">6+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="ae0c-91e6-05b6-b309" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="6253-0c39-299d-c0e3" type="atLeast"/>
