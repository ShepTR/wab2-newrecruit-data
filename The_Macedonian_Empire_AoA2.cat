            <profile id="319b-24a1-a2fc-9548" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have hand weapon, pike and shield. Macedonian Phalanx. Mixed Armour. They may have light armour (+2). Seasoned Phalangites may be Drilled (+2). There may be one unit of Hypaspists/Veterans for every two units of other Phalangites in the army. At least one unit of phalangites must be fielded.</characteristic>
              </characteristics>
            </profile>
            <profile id="fad7-eaf4-c277-2c52" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="a7c8-31b5-de08-05b6" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="490d-9569-0130-d2a7" type="atLeast"/>
                </conditions>
              </modifier>
