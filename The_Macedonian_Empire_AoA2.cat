            <profile id="4a47-7724-6475-6477" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have hand weapon, pike and shield. Macedonian Phalanx. Mixed Armour. They may have light armour (+2). Hypaspists/Veterans are Drilled and may be Stubborn (+3). In Alexandrian armies, Hypaspists may alternatively be fielded with thrusting spear and large shield (-2), or javelins and shield (-4) in which case they are Drilled and Light Infantry. Phalanx infantry can be upgraded to veterans with the Veteran rule for (+1) points.</characteristic>
              </characteristics>
            </profile>
            <profile id="7148-8013-054f-5bab" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="ca44-0580-ba75-2f08" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="46d8-4539-74c8-7ebb" type="atLeast"/>
