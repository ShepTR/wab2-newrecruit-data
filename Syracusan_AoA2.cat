              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Celt infantry have Mixed Weapons and shield. May take light armour (+2). Warband. Stealth. Peltasts and Skirmishers from the Light Troops section may be fielded as mercenaries, with the points being taken from this section. Peltasts become Ld7 (+1) and Skirmishers become WS3, Ld7 (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="7afd-9842-bce7-9074" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="e0a6-e8da-afb7-ea32" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ed2b-ce63-a532-578e" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
