            <profile id="2f4b-34ad-bc82-dd15" name="Equipment and options (as printed in WAB2 army list)" publicationId="556c-7119-7234-b625" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword. Army General: units within 12" may use his Leadership. Horse free (M8) or light chariot at additional cost. (rulebook p.183)</characteristic>
              </characteristics>
            </profile>
            <profile id="5942-9b0a-d27e-06c4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
