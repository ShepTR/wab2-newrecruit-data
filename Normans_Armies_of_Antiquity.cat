            <profile id="ab11-9f59-d772-f65d" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a sword, light armour and shield. May have heavy armour (+2 pts), lance (+3 pts), warhorse (+3 pts). The army must have a General. 0-1. (Armies of Antiquity p.39)</characteristic>
              </characteristics>
            </profile>
