                <conditions>
                <condition field="selections" scope="abda-f8c7-b803-7c89" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8fe6-f4b8-77d2-bf96" type="atLeast"/>
