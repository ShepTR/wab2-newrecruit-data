                <conditions>
                <condition field="selections" scope="77e1-a4f6-c0b1-d24a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0226-14bc-2c97-eaff" type="lessThan"/>
                <condition field="selections" scope="77e1-a4f6-c0b1-d24a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fee4-86fe-71be-278c" type="atLeast"/>
