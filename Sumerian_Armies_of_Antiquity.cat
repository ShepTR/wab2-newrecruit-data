            <profile id="a119-3435-8d7e-e04b" name="Equipment and options (as printed in WAB2 army list)" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and thrusting spear. Ur-style spearmen may have light armour (+2); Lagash-style spearmen may have large shields (+2). Akkadians may be armed in either fashion. (Armies of Antiquity p.3)</characteristic>
              </characteristics>
            </profile>
            <profile id="c3b7-04e4-1dba-9902" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="77e1-a4f6-c0b1-d24a" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0226-14bc-2c97-eaff" type="atLeast"/>
