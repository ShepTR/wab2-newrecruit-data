            <profile id="b69c-bac2-9855-48a7" name="General" publicationId="aab0-aa1e-0319-4ffe" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">5</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">5</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">4</characteristic>
