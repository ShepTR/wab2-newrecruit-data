              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and bow. May have throwing spear (+1 pt), shields (+1 pt), light armour (+2 pts). Cause fear in enemy cavalry. 0-1. (Armies of Antiquity p.31)</characteristic>
              </characteristics>
            </profile>
            <profile id="add2-deec-51d0-8581" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="f574-ad80-aaf4-9af2" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2912-476a-2803-1567" type="atLeast"/>
