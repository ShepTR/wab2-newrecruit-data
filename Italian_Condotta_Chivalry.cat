            <profile id="43db-22f6-0af3-2f65" name="Carrocio Wagon" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">-</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">-</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">-</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">-</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">6</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">3</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">-</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">-</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">-</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">None</characteristic>
              </characteristics>
            </profile>
            <profile id="afe8-9df3-52f0-fc85" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The Carrocio (50 pts, plus the cost of the defenders; no handguns) is paid out of the Character points allowance and is an Army Standard Wagon - a regular Wagon (like Tabor wagons) as well as the Army Standard. It is placed last like other characters and is not restricted to the Tabor rule for placement, but cannot move once placed. Early armies only, and only if no Army Standard Bearer is chosen. (Armies of Chivalry p.35)</characteristic>
              </characteristics>
            </profile>
            <profile id="4c77-fcb6-898a-d859" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
