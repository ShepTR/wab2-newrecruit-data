            </profile>
            <profile id="0a4d-331d-39e5-0a2f" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour, lance, shield and warhorse. May wear partial or full plate armour (free). Cloth barding (+4 pts) or plate barding (+6 pts). First Charge. Rank Bonus up to +1. 0-1 unit may upgrade to Casa (+2 pts, WS5) and cannot outnumber any other Mercenary Knights unit. 1+ unit. (Armies of Chivalry p.36)</characteristic>
              </characteristics>
            </profile>
            <profile id="91cf-eaf0-07e6-16e2" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
