            <profile id="5f33-5e0c-757d-0f4e" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">As the German/Bohemian Mercenary Knights in the Kingdom of Hungary list: hand weapon, thrusting spear, heavy armour, shield and horse. Partial or full plate (free). Cloth (+4 pts) or plate (+6 pts) barding. Rank Bonus up to +2. All Early armies. (Armies of Chivalry p.36)</characteristic>
              </characteristics>
            </profile>
            <profile id="49a8-8075-8604-64dd" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
