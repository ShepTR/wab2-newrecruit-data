              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, shield or buckler. May have javelins (+1 pt). Open Order. Rank Bonus up to +2 in the open. 0-1 unit. (Armies of Chivalry p.37)</characteristic>
              </characteristics>
            </profile>
            <profile id="a480-e96b-0fe4-38dd" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="87dc-7a6f-157f-dee9" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e979-2d45-c148-e11a" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="5+ with Buckler +1 in hand-to-hand only">
