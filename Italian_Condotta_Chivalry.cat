            <profile id="5f37-55a2-c44a-2260" name="Equipment and options (as printed in WAB2 army list)" publicationId="da79-edc9-ea11-dbc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, lance, shield and horse. May have heavy armour (+1 pt) or partial plate armour (+2 pts). Rank Bonus +1. One unit in Milanese armies may upgrade to Familia Ducale (WS4, Ld8; +5 pts per model) if a Feudal General is used. 0-2 units. Early: Naples, Milan; Late: Venetian Greek, Milan. (Armies of Chivalry p.36)</characteristic>
              </characteristics>
            </profile>
            <profile id="e9bc-7911-6d20-1834" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="4ed3-aaca-2621-8024" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3f17-564c-5cce-e23b" type="atLeast"/>
                <condition field="selections" scope="4ed3-aaca-2621-8024" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c13c-26cd-c905-e5a1" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
