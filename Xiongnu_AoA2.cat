              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Warriors have hand weapon and composite bow. May exchange composite bow for javelins and buckler (-1) and exchange bucker for shield (+1). May exchange javelins for throwing spear (+2). Light Infantry.</characteristic>
              </characteristics>
            </profile>
            <profile id="1634-45a2-7b2d-b7e3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="6+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="f311-df5f-12e2-c20b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="36fa-9720-f2f6-b28a" type="atLeast"/>
