            </profile>
            <profile id="f99a-d009-41fc-61cc" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The Irish King has a hand weapon, light armour, thrusting or throwing spear, javelins and buckler. Army General. Warband. May ride a horse (+11). In that case he becomes Ld8 but is no longer Warband.</characteristic>
              </characteristics>
            </profile>
            <profile id="c974-b9d2-c98e-a24a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">5+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="0c2f-5dbc-687a-5118" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="7603-298f-27fd-f71c" type="atLeast"/>
