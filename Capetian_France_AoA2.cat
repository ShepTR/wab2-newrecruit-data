            <profile id="abcf-5197-5bdc-99ed" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Dismounted Sergeants have a hand weapon, light armour, thrusting spear and shield. May exchange thrusting spear for halberd (free) or a double-handed weapon (+1) or crossbows (+2). Sergeants without crossbows may be combined with Knights (Mounted Sergeants may be combined with Mounted Knights, Dismounted Sergeants with Dismounted Knights). The unit is then subject to the rules for Combined Formation. Dismounted Sergeants with crossbows, not in Mixed Order, are Open Order.</characteristic>
              </characteristics>
            </profile>
            <profile id="3dce-6e7f-33ce-35bd" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
