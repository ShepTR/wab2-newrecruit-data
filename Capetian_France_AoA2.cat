            </profile>
            <profile id="64b9-d28b-41be-74b7" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">A Captain rides a warhorse and has a hand weapon, heavy armour and shield. In Late armies he may have a lance (+6). Any Captain may be upgraded to Mercenary Captain (+30). Mercenary Captains are Unreliable and may only join a Mercenary unit. Any Mercenary unit within 8’’ of the Captain may use his Leadership value when taking a Leadership test, although he is not the Army General.</characteristic>
              </characteristics>
            </profile>
            <profile id="10d8-f947-6ee7-7498" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
