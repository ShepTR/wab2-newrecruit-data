            <profile id="4dad-6c82-a731-1954" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Mercenary Knights ride warhorses and have a hand weapon, heavy armour, thrusting spear and shield. First Charge. In Late armies, thrusting spears must be replaced by lances (+3) and the warhorses may have cloth barding (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="ab53-a424-7e3a-3a6d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="82c8-6503-cef8-4fc5" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="56d7-07c1-5a54-0b89" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
