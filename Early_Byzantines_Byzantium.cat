              </characteristics>
              <modifiers>
                <!-- swstat-M-opt -->
                <modifier type="set" field="35a2-714d-db3e-3738" value="4">
                  <conditions>
                    <condition field="selections" scope="293f-ca1a-26b3-1123" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2d71-851c-176f-306a" type="atLeast"/>
                  </conditions>
