                  <conditions>
                    <condition field="selections" scope="c758-0b5c-9b4b-961e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="940f-5d6f-d30b-fdb1" type="atLeast"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
            <profile id="3dda-5034-011f-b597" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon. Rides a horse. May have light armour (+3 pts) or heavy armour (+4 pts), bow (+3 pts), javelins (+2 pts), and either thrusting or throwing spear &amp; shield (+4 pts), or kontos &amp; buckler (+4 pts). May have barding (+4 pts). Characters leading a unit of dismounted cavalry may dismount (-8 pts, reduce Movement to 4). Heraclian characters may exchange kontos &amp; buckler for Kontarion &amp; shield (+1 pt) and may have half-barding for their mounts (+2 pts). Phylarch: Bedouin Cavalry - the Phylarch must lead and may not leave a unit of Ghassanid Arab Cavalry. (Byzantium p.38)</characteristic>
              </characteristics>
            </profile>
            <profile id="7456-26c5-fcfa-58a9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="5cb6-b418-92b7-cd36" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="f6c9-ce5f-9571-b6c0" type="atLeast"/>
