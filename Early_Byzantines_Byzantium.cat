              </characteristics>
              <modifiers>
                <!-- swstat-M-opt -->
                <modifier type="set" field="35a2-714d-db3e-3738" value="4">
                  <conditions>
                    <condition field="selections" scope="6523-f5cd-8af2-8e83" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9b5d-76f9-6a9e-0610" type="atLeast"/>
                  </conditions>
