            <profile id="652b-b98c-7970-d606" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, throwing or thrusting spear and shield. Heruls also have javelins. May dismount (-8 pts, reduce Movement to 4). Superior Germanic Cavalry. Mounted Heruls are also Light Cavalry. 0-2 units. Justinian armies only. (Byzantium p.41)</characteristic>
              </characteristics>
            </profile>
            <profile id="8b30-24dd-772f-e35d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
