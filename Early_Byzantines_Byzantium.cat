            <profile id="f2d7-3873-3d59-2068" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon. Rides a horse. May have light armour (+3 pts) or heavy armour (+4 pts), buckler (+1 pt) or shield (+2 pts) and barding (+4 pts). Army Standard Bearers accompanying a unit of dismounted cavalry may dismount (-8 pts, reduce Movement to 4). 0-1. (Byzantium p.38)</characteristic>
              </characteristics>
            </profile>
            <profile id="b41e-83e7-eb89-1dee" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="3958-7aba-c007-3c5f" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="39e3-cf2c-a590-fda9" type="atLeast"/>
