                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">2</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">3</characteristic>
              </characteristics>
            </profile>
            <profile id="f291-8475-d8ca-cc2a" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with whatever they can lay their hands on (count as improvised weapons). Green or Blue Circus Faction mob, 0-1 unit, with an optional Faction Leader. Mobs and their Faction Leader are subject to Warband Psychology Rule 1; they cannot Fall Back in Good Order, cannot benefit from the Leadership of characters other than their Faction Leader, nor use the re-roll benefit of the Army Standard. Mobs are deployed last, as far from the enemy as possible. Rousing the Mob: at the start of the Byzantine first turn the mob takes a Leadership test; if passed the mob is roused (subtract the roll from Ld: 0-3 move forward at least 4" and subject to all Warband Psychology rules; 4 also hates the enemy; 5 also Frenzied); if failed the mob counts as Levies for the rest of the game. (Byzantium p.40)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="74df-dbe6-0c6a-f1ab" name="Circus Faction Mob" hidden="false" targetId="8660-df66-d3fc-41c8" type="rule"/>
            <infoLink id="63c3-e450-1efe-9d76" name="Warband Psychology (rule 1)" hidden="false" targetId="74dd-cf08-7426-ea66" type="rule"/>
            <infoLink id="d9ad-d395-9bd5-c07b" name="Improvised Weapon" hidden="false" targetId="026a-8df7-0a12-0a18" type="profile"/>
          </infoLinks>
          <costs>
