            <profile id="f0be-f45d-638a-fcc5" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, sling or javelins and buckler. May replace sling or javelins with bow (+2 pts). Isaurians with javelins may also have throwing spear (+1 pt), and replace buckler with shield (+1 pt). Skirmishers. Isaurians are Light Infantry. Irregular Psiloi count as Levies. 0-2 units. (Byzantium p.39)</characteristic>
              </characteristics>
            </profile>
            <profile id="83af-ed9c-9722-7cbf" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="26b3-45d5-0a49-c98d" name="Skirmishers (Byzantium)" hidden="false" targetId="ce4b-42b1-6eb6-6e51" type="rule"/>
