        <selectionEntry id="9994-86ae-a855-b21d" name="Comitatus" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="5" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8443-e07f-a881-165e" type="min"/>
          </constraints>
          <profiles>
            <profile id="84cf-5ce9-22e7-3863" name="Comitatus" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
              </characteristics>
              <modifiers>
                <!-- swstat-M-opt -->
                <modifier type="set" field="35a2-714d-db3e-3738" value="4">
                  <conditions>
                    <condition field="selections" scope="5bdf-74b7-cf29-1215" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="b058-71fa-2d67-2896" type="atLeast"/>
                  </conditions>
                </modifier>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
                <conditions>
                <condition field="selections" scope="5bdf-74b7-cf29-1215" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="77c6-f4f2-0fb5-0ca8" type="atLeast"/>
                <condition field="selections" scope="5bdf-74b7-cf29-1215" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6abd-28b4-4add-44a0" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="994f-d7c2-3b77-3749" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, and either bow &amp; buckler or javelins &amp; shield. May exchange light armour for heavy armour (+1 pt). Bucellarii and Comitatus with bows may have kontos (+2 pts), and the Bucellarii may have barding for their mounts (+4 pts). Any Heavy Cavalry may either have throwing or thrusting spear (+1 pt), or exchange bow &amp; buckler/javelins &amp; shield for kontos &amp; buckler (free). Dismounted Heavy Cavalry Option: may dismount (-10 pts, reduce Movement to 4). Dismounted Heavy Cavalry with bucklers may exchange them for shields (+1 pt). Mounted Heavy Cavalry are Superior Byzantine Cavalry. Dismounted Heavy Cavalry with shields may form a shieldwall. Units without kontos may be designated as light cavalry (free). 0-2 units. (Byzantium p.38)</characteristic>
              </characteristics>
            </profile>
            <profile id="2af2-133f-b349-b1eb" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">5+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="5bdf-74b7-cf29-1215" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="77c6-f4f2-0fb5-0ca8" type="atLeast"/>
                <condition field="selections" scope="5bdf-74b7-cf29-1215" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6abd-28b4-4add-44a0" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="4+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="5bdf-74b7-cf29-1215" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="77c6-f4f2-0fb5-0ca8" type="atLeast"/>
                <condition field="selections" scope="5bdf-74b7-cf29-1215" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6abd-28b4-4add-44a0" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="5bdf-74b7-cf29-1215" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="77c6-f4f2-0fb5-0ca8" type="lessThan"/>
                <condition field="selections" scope="5bdf-74b7-cf29-1215" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6abd-28b4-4add-44a0" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="-">
                <conditions>
                <condition field="selections" scope="5bdf-74b7-cf29-1215" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="77c6-f4f2-0fb5-0ca8" type="lessThan"/>
