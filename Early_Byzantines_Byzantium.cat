                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">6</characteristic>
              </characteristics>
            </profile>
            <profile id="b8fe-9d09-05a8-038a" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, javelins and shield. May have throwing or thrusting spear (+1 pt). Every other unit may have light armour (+2 pts). Ghassanid Arab cavalry with light armour are Bedouin Cavalry. All other Ghassanid Arab cavalry are Light Cavalry with Feigned Flight. 0-2 units. (Byzantium p.40)</characteristic>
              </characteristics>
            </profile>
            <profile id="b2cd-d65a-c4c5-393b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="4a7e-47a3-c3ff-2b02" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3c95-84a6-6d67-5185" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
