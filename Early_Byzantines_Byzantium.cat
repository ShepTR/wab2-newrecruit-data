            </profile>
            <profile id="68d2-1449-1dc0-f98a" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and bow. May have shield (+1 pt), light armour (+2 pts), and either javelins (+1 pt) or throwing spear (+1 pt). May dismount (-12 pts, reduce Movement to 4). Mounted Hun Horse Archers are Light Cavalry and Nomad Cavalry. Dismounted Huns without armour are Light Infantry. 0-2 Hun units in all (with Nobles). (Byzantium p.41)</characteristic>
              </characteristics>
            </profile>
            <profile id="d74d-0093-544b-ce7e" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="d613-cc01-983b-201d" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ae9c-3a5a-8f52-7921" type="atLeast"/>
