          </constraints>
          <profiles>
            <profile id="22a1-e4b0-261b-1062" name="Irregular Skutatos" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">2</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">2</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">2</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
              </characteristics>
            </profile>
            <profile id="d388-9a6e-49a5-4b9d" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, thrusting spear and large shield. May have darts or javelins (+1 pt). Two units of Regular Skutatoi may have light armour (+3 pts). Shieldwall. Combined Formation - up to a third of the models in any Skutatoi unit may be Skutatoi archers, who are placed in the rear ranks. Heraclian Skutatoi may be Drilled (+1 pt). Irregular Skutatoi count as Levies. In Justinian armies units of Irregular Skutatoi and Psiloi may count as Rusticani (rural) troops (free): each Rusticani unit takes a Leadership test at the start of the battle using its own Ld; if failed it counts as Levies, if passed it is subject to Warband Psychology Rule 2 and does not count as Levies. (Byzantium p.39)</characteristic>
              </characteristics>
            </profile>
            <profile id="376a-ba90-3f64-14e3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="a61b-3589-3f30-7ae5" name="Shieldwall (Byzantium)" hidden="false" targetId="e3a9-d9d8-2307-2312" type="rule"/>
            <infoLink id="2eb7-5fc4-7eb3-a10a" name="Combined Formation (Byzantium)" hidden="false" targetId="2280-7c4f-4408-0d5e" type="rule"/>
