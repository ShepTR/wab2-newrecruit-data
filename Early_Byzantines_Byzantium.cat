        <selectionEntry id="cccf-37ac-f042-1801" name="Javelins &amp; shield (replaces bow &amp; buckler)" hidden="false" collective="false" import="true" type="upgrade">
<constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b7c0-6849-5541-88c3" type="max"/>
