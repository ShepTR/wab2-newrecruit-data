            </profile>
            <profile id="5505-2ca2-6cfc-2e14" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon and javelins. May exchange javelins for bow (+1 pt), and have shield (+1 pt). Combined Formation - archers must combine with Skutatoi, they cannot be in their own units (built as a separate unit entry; combine them with a Skutatoi unit on the table). Heraclian Skutatoi archers may be Drilled (+1 pt). Irregular Skutatoi count as Levies.  (Byzantium p.39)</characteristic>
              </characteristics>
            </profile>
            <profile id="dfac-66c4-5bdc-412c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="1df6-c312-fcea-7966" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="240b-cd9e-9c56-6537" type="atLeast"/>
                </conditions>
              </modifier>
