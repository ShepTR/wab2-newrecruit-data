              </characteristics>
              <modifiers>
                <!-- swstat-M-opt -->
                <modifier type="set" field="35a2-714d-db3e-3738" value="4">
                  <conditions>
                    <condition field="selections" scope="d6f0-df2e-384f-cdcf" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="57eb-1adf-3285-8817" type="atLeast"/>
                  </conditions>
                </modifier>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
                <conditions>
                <condition field="selections" scope="d6f0-df2e-384f-cdcf" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5658-8182-5be2-914c" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="eb4e-63e9-9b2f-576d" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, Kontarion and shield. May have heavy armour (+1 pt). The Bucellarii may also take bows (+2 pts), and either half-barding (+2 pts) or barding (+4 pts) for their mounts. Dismounted Cavalry Option: may dismount (-10 pts, reduce Movement to 4). Defensores &amp; Cursores: for every two units of the same type and with the same equipment, the smallest unit may be designated as Cursores (free), who count as light cavalry. Combined Formation - up to a third of the models in any unit may exchange Kontarion for either javelins (-1 pt) or bow (free) - archers/javelineers are placed in the rear ranks. Mounted cavalrymen are Superior Byzantine Cavalry. Dismounted cavalrymen may form a shieldwall. The Bucellarii and Optimates may be Drilled (+1 pt).  (Byzantium p.39)</characteristic>
              </characteristics>
            </profile>
            <profile id="16ff-ff06-3c37-d86f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="d6f0-df2e-384f-cdcf" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="5658-8182-5be2-914c" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="7644-7a2d-fe66-295a" name="Superior Byzantine Cavalry" hidden="false" targetId="d81e-b4ce-ed5b-0f8a" type="rule"/>
            <infoLink id="36b3-3621-6e26-7bcc" name="Combined Formation (Byzantium)" hidden="false" targetId="2280-7c4f-4408-0d5e" type="rule"/>
