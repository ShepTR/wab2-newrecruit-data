            <profile id="dddb-74c0-b3d6-3b9d" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Light Cavalry have a hand weapon and light armour. Light Cavalry. May have heavy armour (+1), composite bow (+2), javelins (+1), throwing or thrusting spear (+3) and shield (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="6c4b-e139-36f0-dd72" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="4ef1-d833-5536-ddee" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="82fe-18da-0310-9827" type="atLeast"/>
