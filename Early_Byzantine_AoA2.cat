            <profile id="bcf9-e66d-3398-2f85" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, throwing or thrusting spear and shield. Eastern Shock Cavalry. First Charge. Lombards and Goths may have light armour (+2) or heavy armour (+3). Goths may exchange thrusting spear and shield for kontos and buckler (-1).</characteristic>
              </characteristics>
            </profile>
