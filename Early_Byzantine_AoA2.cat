            <profile id="6503-baab-409d-9f3b" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Bucellarii and Cavalry have a hand weapon and light armour. Eastern Shock Cavalry. They may have heavy armour (+1). Cavalry have either kontos, composite bow and buckler (+5), or throwing or thrusting spear and shield (+4). In the latter case they may have composite bow (+2) or javelins (+1). Cavalry have thrusting spear and shield (+4).</characteristic>
              </characteristics>
            </profile>
            <profile id="d43b-144b-21d6-54e4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="8cd0-25b0-2b5c-0bd8" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="7593-c596-b099-eec0" type="atLeast"/>
