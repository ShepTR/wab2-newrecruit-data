            </profile>
            <profile id="85a9-5d3e-c637-1876" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Regular and Levy infantry have hand weapon, thrusting spear and large shield. Shieldwall. They may have darts (+1), and up to two regular units may have light armour (+2). All may use Combined Formation with up to half the unit’s figures exchanging thrusting spear and large shield for composite bow (-2) and forming the rear ranks. Levies are Levies.</characteristic>
              </characteristics>
            </profile>
            <profile id="fb0c-7e6d-b1b8-0040" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="dc1a-5c8a-717b-ae23" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fa03-e55b-b8e3-c5ca" type="atLeast"/>
                </conditions>
