            </profile>
            <profile id="b95f-1b95-1d6f-0d15" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">All have a hand weapon, and may ride a horse (+9). Companions of the Prophet and Sheikhs may have light armour (+2) or heavy armour (+3), short bow (+2) and thrusting spear (+2). May be Riding Horses or Riding Camels (+1). Units led by a Companion of the Prophet may re-roll failed panic tests. One Companion may be upgraded to Army General (+50).</characteristic>
              </characteristics>
            </profile>
            <profile id="a41e-2e40-5074-67d6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
