              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Tribal and Militia cavalry have a hand weapon, javelins and shield. Light Cavalry. Feigned Flight. May exchange javelins for short bow (free) or thrusting spear (+2).</characteristic>
              </characteristics>
