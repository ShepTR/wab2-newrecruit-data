            <profile id="168a-751d-5c7c-513c" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Burghers have a hand weapon, shield and partial plate armour. Ride a horse. Shock Cavalry. First Charge. May have full plate armour (+1). May be mounted on a warhorse (+7) that may have cloth barding (+3). May have a lance (+6). May dismount (-17) and if dismounted, may have a double handed weapon (+3). Dismounted Burghers may be Stubborn (+3) and may be Riding Horses (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="363a-5939-2991-07f6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
