                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="dd01-714b-a75a-e925" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Knights have a hand weapon, shield and partial plate armour. May have double handed weapon (+3) and full plate armour (+1). May be Veteran (+1), and Stubborn (+3). May be Riding Horses (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="903e-aa76-3ef0-8da5" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="c3cd-6ed2-3160-cc01" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="23ab-25b5-a116-3fa7" name="Shield" hidden="false" targetId="b513-5c2a-34df-6a1d" type="profile"/>
            <infoLink id="2950-77d8-79e4-0fc7" name="Partial Plate Armour" hidden="false" targetId="8430-72da-5ac5-d33f" type="profile"/>
