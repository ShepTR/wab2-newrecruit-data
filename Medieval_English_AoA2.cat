            <profile id="d88c-288e-4a63-77ef" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The General and The King have a hand weapon and partial plate armour. Army General. May have shield (+1), double handed weapon (if dismounted) (+3), and full plate armour (+1). May ride a warhorse (+16) that may be cloth barded (+3). If mounted may have a lance (+6). May have Stratagem (+20).</characteristic>
              </characteristics>
            </profile>
            <profile id="c678-1adb-53c6-b83f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="8c54-30d1-d65d-e170" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="adf6-222a-ad9e-9a03" type="atLeast"/>
