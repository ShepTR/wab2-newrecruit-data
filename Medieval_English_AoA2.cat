            <profile id="2cd6-a11a-da91-7251" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Knights have hand weapon, partial plate armour, lance and shield. Shock Cavalry. First Charge. Warband rules#1 and 3. May be mounted on a warhorse (+7) that may have cloth barding (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="4b2f-e08b-c831-7ed0" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="ea08-a188-4f1e-c167" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6084-5845-eede-8aa2" type="lessThan"/>
                <condition field="selections" scope="ea08-a188-4f1e-c167" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4999-f8f9-2a17-16b0" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="ea08-a188-4f1e-c167" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6084-5845-eede-8aa2" type="atLeast"/>
