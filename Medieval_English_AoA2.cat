              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Knights have hand weapon, partial plate armour, lance and shield. Shock Cavalry. First Charge. May be mounted on a warhorse (+7) that may have cloth barding (+3).</characteristic>
              </characteristics>
            </profile>
            <profile id="511e-28b7-ea92-4315" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
