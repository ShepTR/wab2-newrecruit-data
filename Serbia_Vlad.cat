              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Improvised weapons and shield. Warband Rule 1. The emergency levy of all able bodied freemen, called to serve in defence of the Serbian Kingdom or Empire. (Vlad the Impaler p.70)</characteristic>
              </characteristics>
            </profile>
            <profile id="193d-43a8-15ed-3515" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="d368-596a-50ca-a557" name="Warband Psychology (rule 1)" hidden="false" targetId="74dd-cf08-7426-ea66" type="rule"/>
            <infoLink id="a2ae-2ade-8037-2af1" name="Improvised Weapon" hidden="false" targetId="026a-8df7-0a12-0a18" type="profile"/>
            <infoLink id="aca5-70c5-1628-2d57" name="Shield" hidden="false" targetId="b513-5c2a-34df-6a1d" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="4"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
