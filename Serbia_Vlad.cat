            <profile id="8638-f12f-0f77-efb3" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, thrusting spear, shield and light armour. May take heavy armour (+2 pts) and may upgrade from thrusting spear to bills or roncones (count as halberds, +1 pt). (Vlad the Impaler p.70)</characteristic>
              </characteristics>
            </profile>
            <profile id="5b4a-189c-33a0-9b5c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="42e1-a5ab-4d84-f1f4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3352-31dc-e7c6-9633" type="atLeast"/>
