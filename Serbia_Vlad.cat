            <profile id="c889-b600-c4a3-d5f7" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Bow and spear armed: hand weapon, heavy armour, shield, thrusting spear, bow and horse. 0-1 unit may take cloth (+4 pts) or plate barding (+6 pts). May wear partial plate or plate armour (free). Eastern Shock Cavalry. Vlastella may count a +1 rank bonus. Kingdom of Serbia: a maximum of one lance armed unit may be taken for every bow and spear armed unit. Serbian Empire: a maximum of one bow and spear armed unit may be taken for every lance armed unit (not enforced). (Vlad the Impaler p.69)</characteristic>
              </characteristics>
            </profile>
            <profile id="3b59-b2c8-521f-eee0" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="f155-04ac-d98c-425e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="f627-d7c8-2172-dd73" type="atLeast"/>
