            <profile id="1ec1-e2b1-ca62-e533" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, lance, shield, heavy armour, and warhorse. May have cloth (+4 pts) or plate barding (+6 pts). Allies and Mercenaries. Count rank bonus of up to +1 in combat. European Mercenary Knights are limited to 0-1 in the first 2,000 points, and an additional 0-1 for every 1,000 points thereafter (the limit is lifted for Stefan Dušan's Wealthy rule). (Vlad the Impaler p.71)</characteristic>
              </characteristics>
            </profile>
            <profile id="a8d4-6939-d411-5b01" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="c6ab-e31c-2dba-a579" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d801-10ba-1a83-fab7" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="d899-d86f-db5c-173f" name="Allies and Mercenaries (Chivalry)" hidden="false" targetId="1011-1e73-6be9-a6cc" type="rule"/>
