            <profile id="4c3f-ca2b-a4d1-d5ea" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Lance armed: hand weapon, heavy armour, lance, shield and warhorse. 0-1 unit may take cloth (+4 pts) or plate barding (+6 pts). May wear partial plate or plate armour (free). First Charge. Vlastella may count a +1 rank bonus. Serbian Vlastellini (Barons) or Pronija (fief holders) formed the backbone of Serbian armies throughout this period. (Vlad the Impaler p.69)</characteristic>
              </characteristics>
            </profile>
            <profile id="2e20-2987-6a05-957b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
