            <profile id="a866-e3fd-d389-2641" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon. May have a Noble Sword (+2 pts), shield (+2), light armour (+2), heavy armour (+4). May ride in a four-horse heavy chariot bought at an additional cost from the Chariotry list (not enforced). Army General. Rightful Conduct (Spring and Autumn period only). 0-1 Army Commander. (The Art of War p.29)</characteristic>
              </characteristics>
            </profile>
            <profile id="f888-29c8-ea21-242e" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
