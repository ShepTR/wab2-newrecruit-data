            <profile id="19c1-08be-e24c-c716" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon, shield, thrusting spear and light armour. May have dagger axe instead of thrusting spear and shield. May only be fielded if a Duke is the Army Commander. Drilled. Stubborn. Must be the smallest Infantry unit fielded (not enforced). 0-1. The Zhou had an elite group known as the Tiger Guards. (The Art of War p.30)</characteristic>
              </characteristics>
            </profile>
            <profile id="60c3-08f6-a96e-1945" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="a785-2202-1f95-33b4" name="Drilled (Art of War)" hidden="false" targetId="31d0-26b7-5526-b650" type="rule"/>
            <infoLink id="1628-9cba-649f-4744" name="Stubborn (Art of War)" hidden="false" targetId="f116-0b2e-16ce-f7cc" type="rule"/>
