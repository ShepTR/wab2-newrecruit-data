            <profile id="f8e1-27a8-220d-1ac5" name="Duke of Song" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">2</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">8</characteristic>
                <characteristic name="Sv" typeId="7349-090e-ca0b-09ce">6+</characteristic>
              </characteristics>
            </profile>
            <profile id="f46c-ffc4-0fe3-4ec5" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Special Character (Spring and Autumn period only). Armed with a hand weapon, dagger axe and light armour, with a four-horse heavy chariot (S3 T4 W2 I4 A4, animal skin carapace which acts as a shield) with unarmed driver and archer with light armour. Army General. Rightful Conduct. Meddlesome: before any unit may charge it must test on the Duke of Song's Leadership; if failed, it may not charge. If the Duke is fleeing at any time or is slain he is not an influence and they may charge as normal. Cost includes the chariot (not modelled separately). (The Art of War p.31)</characteristic>
              </characteristics>
            </profile>
            <profile id="36c7-fc47-2b6c-59a3" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="bad5-b6d3-117c-cd89" name="Army General (Chariot Wars)" hidden="false" targetId="592c-3ef3-9392-535a" type="rule"/>
            <infoLink id="3be0-625e-2388-40c9" name="Rightful Conduct (Art of War)" hidden="false" targetId="348a-833d-46cc-9155" type="rule"/>
            <infoLink id="fbc0-1a2f-6f24-ef34" name="Meddlesome (Art of War)" hidden="false" targetId="4c03-4086-03bc-230d" type="rule"/>
            <infoLink id="c44e-250a-5b2a-1465" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="515f-b8cc-95fb-85c6" name="Halberd" hidden="false" targetId="635a-1d79-5976-954c" type="profile"/>
            <infoLink id="c2c6-6fbe-f3eb-0074" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile"/>
            <infoLink id="f0cc-2797-b2ce-6220" name="Bow" hidden="false" targetId="5d29-ba1e-8299-8085" type="profile"/>
            <infoLink id="a891-ee25-6e71-40d3" name="Zhou Dynasty (Art of War) - List Notes" hidden="false" targetId="613a-1ad3-95b2-83e4" type="rule"/>
          </infoLinks>
