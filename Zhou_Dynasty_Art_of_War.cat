            <profile id="e297-7d1a-ef57-e4a4" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon and shield or dagger axe. May have light armour (+2 pts). Light Infantry. Chariot Runners: up to one unit of 10 models per chariot fielded; initially deployed within 6" of the chariot model. (The Art of War p.30)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="4810-c42a-c943-e25f" name="Chariot Runners (Art of War)" hidden="false" targetId="5f0c-fa3d-8e2c-a7d5" type="rule"/>
