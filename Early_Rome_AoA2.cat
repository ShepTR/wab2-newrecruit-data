            <profile id="97c7-73ba-101b-de1f" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, thrusting spear, light armour and large shield. May ride a 6” movement horse (+6) in which case reduce from large shield to shield. Army General.</characteristic>
              </characteristics>
            </profile>
