                <condition field="selections" scope="e766-56b9-2904-57df" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="23f1-5a70-b88b-cbd8" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="8ab5-632b-e583-585a" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Regular spearmen may have light armour (+2). Both types may use a Combined Formation in which up to half the figures in the unit exchange thrusting spear for composite bow (free for regulars, +1 for Levy) and form the rear ranks. The bowmen may exchange composite bow for crossbow (+2) and then form in Mixed Order.</characteristic>
              </characteristics>
            </profile>
            <profile id="4856-2a20-e794-7ae9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="e766-56b9-2904-57df" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="23f1-5a70-b88b-cbd8" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
