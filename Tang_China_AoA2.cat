            <profile id="0350-2b02-6b90-939e" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Lancers have a hand weapon, heavy armour and thrusting spear. May have cataphract armour (+1) and barding (+4). Note the Cataphract rule does not apply to them however.</characteristic>
              </characteristics>
            </profile>
            <profile id="a19c-dd48-eb30-55fb" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="3cac-cd36-8214-d73b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8de9-eaaa-78d7-adf3" type="atLeast"/>
                <condition field="selections" scope="3cac-cd36-8214-d73b" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="86cc-1d88-5431-8cbd" type="lessThan"/>
