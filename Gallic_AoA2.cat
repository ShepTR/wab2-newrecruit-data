            <profile id="efa0-fe37-482c-c68b" name="Equipment and options (as printed in WAB2 army list)" publicationId="fcb9-17be-94c2-bcfc" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Improvised weapon and javelins. May have buckler (free) and may exchange javelins for sling (free) or composite bow (+1). There may not be more bow units than sling units and sling or bow units may not be larger than the smallest javelin unit in the army.</characteristic>
              </characteristics>
            </profile>
            <profile id="4b49-d38b-17c1-d3ad" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="6+ with Buckler +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="e481-23b6-534c-a175" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8fac-7448-6cfa-ea91" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
