            <profile id="4cec-fed5-2e39-0599" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon. May have a shield (+2 pts), light armour (+2), horse (free, M8). May ride in a four-horse heavy chariot (not enforced). Army General. Military Strategist. 0-1 General (Yang or Yin): leads by superior strategy. (The Art of War p.107)</characteristic>
              </characteristics>
            </profile>
            <profile id="0c35-9d42-eb53-ca9d" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
