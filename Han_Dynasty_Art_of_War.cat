            <profile id="6e69-bffe-07b6-79cf" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon. May have javelin and shield (+2 pts). Skirmishers. Straw Dogs: if the unit flees or is destroyed, it does not cause panic in any other unit. Amnestied convicts were used as conscripts for line forces. (The Art of War p.108)</characteristic>
              </characteristics>
            </profile>
            <profile id="431c-3b06-e9e9-fd66" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="4bd7-22ac-0b71-a8d8" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="cba4-e449-fa2b-d67c" type="atLeast"/>
