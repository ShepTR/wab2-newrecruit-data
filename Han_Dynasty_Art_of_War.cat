            <profile id="aac3-dd65-6f0b-212f" name="Equipment and options (as printed in WAB2 army list)" publicationId="b792-78e1-7b03-d4d6" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with a hand weapon and shield. May have light armour (+2 pts) and large shield (+1 pt). May have two handed sword instead of hand weapon and shield for no extra cost. May use Left Handed Fighting Style (+2 pts): reduces an opponent's Initiative and saving throw by 1. Light Infantry. (The Art of War p.108)</characteristic>
              </characteristics>
            </profile>
            <profile id="099b-f862-9d27-074c" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="bb20-64b8-bd1c-d58e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c092-a79f-e549-83af" type="atLeast"/>
                <condition field="selections" scope="bb20-64b8-bd1c-d58e" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2851-770b-ccdd-44aa" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
