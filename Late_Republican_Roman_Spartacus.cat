            </profile>
            <profile id="ca2a-05c8-450c-c0e9" name="Equipment and options (as printed in WAB2 army list)" publicationId="eb14-e889-c793-0fc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, light armour. May carry a shield (+2 pts). May ride a horse (free, his Movement rate increases to 8). If a consul is not chosen, a Praetor may be made General (+25 pts). If taken as the Army General the Praetor may take up to one Lictor in the same manner as the Consul. (Spartacus p.16)</characteristic>
              </characteristics>
            </profile>
            <profile id="d1db-b214-29e5-126a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="d139-aa4b-dd7a-1d03" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="7fdf-8919-b447-4082" type="atLeast"/>
                </conditions>
              </modifier>
