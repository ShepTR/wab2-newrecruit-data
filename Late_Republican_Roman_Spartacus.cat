        <selectionEntry id="3ecd-5380-dd30-0b10" name="Crassus" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="6c3a-b2ce-f85e-e1c4" type="min"/>
          </constraints>
          <profiles>
            <profile id="341f-cea2-4f1c-0d00" name="Crassus" publicationId="eb14-e889-c793-0fc4" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">5</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">5</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">2</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">5</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">2</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">9</characteristic>
              </characteristics>
            </profile>
            <profile id="a25d-5853-a062-5955" name="Equipment and options (as printed in WAB2 army list)" publicationId="eb14-e889-c793-0fc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, light armour. May carry a shield (+2 pts). May ride a horse (free, his Movement increases to 8). Army General. Up to one Lictor can be taken in the same manner as a Consul. Reputation: at the start of the game Crassus may remove one legionary in ten (removed equally as possible across all legionary units rounding to the nearest ten); this allows all Roman Legionary units to re-roll failed Panic tests and, should a legion break and be caught from combat, the slaves cannot loot its equipment; once a re-rolled Panic test is also failed both benefits are lost (the re-roll may be made using the Lictor). Wealthy: at the start of the game Crassus may nominate and upgrade one Legionary unit to become Drilled and Stubborn at no additional points cost. 0-1. (Spartacus p.16)</characteristic>
              </characteristics>
            </profile>
            <profile id="ccb0-7516-956e-56a1" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="3ecd-5380-dd30-0b10" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="054e-89e1-c146-b29a" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
