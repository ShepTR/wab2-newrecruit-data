              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Armed with mixed weapons and shield. May take throwing spear (+2 pts), and replace shields with large shields (+2 pts). Warband. Stealth. (Spartacus p.17)</characteristic>
              </characteristics>
            </profile>
            <profile id="16a5-e8fe-1ca9-ebf6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="280f-6157-0a70-fa82" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="9540-f908-aa56-da9e" type="atLeast"/>
