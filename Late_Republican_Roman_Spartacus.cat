            </profile>
            <profile id="faf1-18e8-5b61-acc3" name="Equipment and options (as printed in WAB2 army list)" publicationId="eb14-e889-c793-0fc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Throwing spear, sword and shield. May have javelins (+1 pt), light armour (+2 pts). By this time Roman cavalry only played a scouting, messenger or escort service in the Roman army but they are included for completeness. (Spartacus p.17)</characteristic>
              </characteristics>
            </profile>
            <profile id="2566-3761-626f-9302" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="4+">
                <conditions>
                <condition field="selections" scope="c630-a284-aec2-6b58" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="cfe0-2a01-2a1f-ddf2" type="atLeast"/>
                </conditions>
              </modifier>
