                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">5</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">2</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">9</characteristic>
              </characteristics>
            </profile>
            <profile id="f0d1-73cf-c538-1a11" name="Equipment and options (as printed in WAB2 army list)" publicationId="eb14-e889-c793-0fc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword, light armour. May carry a shield (+2 pts). May ride a horse (free, his Movement increases to 8). A Roman Consul may have up to two Lictors who must remain in base contact with the Consul (if mounted it is assumed the Lictors can keep pace). Army General. 0-1. (Spartacus p.15)</characteristic>
              </characteristics>
            </profile>
            <profile id="e660-c3e0-b5dd-7ee7" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="38d9-bff2-4608-62b2" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="2e31-a081-8a9c-a43a" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
