          <profiles>
            <profile id="f3a9-345d-055d-98c4" name="Lictor" publicationId="eb14-e889-c793-0fc4" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">3</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">3</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">2</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="e709-a52b-96a0-d71a" name="Equipment and options (as printed in WAB2 army list)" publicationId="eb14-e889-c793-0fc4" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sword. Fasces: the Lictor carries the Fasces, which allows the Consul the following options once per Lictor during the game: (1) re-roll any Roman Leadership test once within 12" of the Consul; or (2) add +1 to any Roman combat resolution once within 12" of the Consul. Lictors may be captured in the same way as a unit standard or killed in hand-to-hand combat; either way each is worth an additional 200 Victory points. 0-2 Lictors (up to two with a Consul, one with a Praetor as General or with Crassus: not enforced). (Spartacus p.15)</characteristic>
              </characteristics>
            </profile>
            <profile id="d98d-f845-51c7-e82b" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="d6e1-fd1e-ee99-4146" name="Fasces" hidden="false" targetId="e883-1394-227e-6cf9" type="rule"/>
            <infoLink id="b2f0-bf14-3811-99f0" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="a481-30d4-2f1b-19a4" name="Late Republican Roman Consular Army (Spartacus) - List Notes" hidden="false" targetId="c2d0-a5a4-68f4-3a99" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
          </costs>
        </selectionEntry>
