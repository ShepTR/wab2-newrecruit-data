            </profile>
            <profile id="f464-ef0a-8068-ba29" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour and shield. May have throwing spear (+2 pts), javelins (+2 pts). May exchange shield for additional hand weapons (+3 pts) or double-handed axe (+3 pts). May be mounted on a horse (+8 pts). Army General. 0-1 Army General (Konnungr or Jarl). (Shieldwall p.12)</characteristic>
              </characteristics>
            </profile>
            <profile id="95b7-87df-0198-4e85" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
