                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
            </profile>
            <profile id="4eba-2da1-f75a-d375" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons. May have shield (+1 pt), light armour (+2 pts), javelin (+1 pt), throwing spear (+1 pt), double-handed axes/swords (+2 pts), bows (+2 pts) or crossbow (+5 pts). Any unit of Serjeants may be designated as light infantry at no additional cost. Roll a dice the first time each unit wishes to move, charge or shoot: on a 1 it stays stationary and may not shoot (it may defend itself); on a 2-6 it may act as the player wishes. Dogs of War cannot be accompanied by characters and cannot benefit from the Army General and Standard Bearer rules. (Shieldwall p.78-79)</characteristic>
              </characteristics>
            </profile>
            <profile id="1005-0564-69b4-8391" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="f7b8-4701-1e30-d447" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="36b9-a055-4bc4-799b" type="atLeast"/>
