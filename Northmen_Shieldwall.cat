            </profile>
            <profile id="ca39-883b-0da7-5795" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons, throwing spear, sword and shield. May exchange spear and shield for bow at no additional cost. Bow-armed Bondir count as light infantry; a player may not have more bow-armed Bondir than he has Bondir armed with other weapons (not enforced). Hiberno-Norse and Orkneyinga: may exchange throwing spear for thrusting spear (free). (Shieldwall p.14)</characteristic>
              </characteristics>
            </profile>
            <profile id="78d1-ac28-e71e-578f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="None">
                <conditions>
                <condition field="selections" scope="144d-7d04-1d0c-46b1" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="78ed-ea7d-e7a2-5a1c" type="atLeast"/>
