              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Driver and one crewman armed with hand weapon, javelins, light armour and shield. Light Chariots.</characteristic>
              </characteristics>
            </profile>
            <profile id="5b26-5237-b98a-2a2f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
