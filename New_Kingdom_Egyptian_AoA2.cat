              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Sea Peoples have Hand weapon, javelins and shield Option: May have light armour (+2 points). Warband (rule 2 does not apply) Libyans &amp; Kushites Hand weapon and javelins. Light Infantry. Warband (rule 2 does not apply) Syrians Hand weapon and javelins. Option: May have short bows (+1 point) or bows (+2 point). Light Infantry. Numbians Hand weapon and short bow. Skirmishers. Slingers Hand weapon and sling. Option: May have buckler (free) Skirmishers.</characteristic>
              </characteristics>
            </profile>
            <profile id="0379-3c5b-92bf-36de" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="b309-1993-9551-2479" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0f06-d149-fee5-afbc" type="atLeast"/>
                <condition field="selections" scope="b309-1993-9551-2479" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="dba9-733b-0a22-8768" type="lessThan"/>
                </conditions>
