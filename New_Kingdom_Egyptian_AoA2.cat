              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Marines have hand weapon and bow. Marines: may exchange bow for javelins and shield (free) and may have light armour (+2 points) Marines: different weapons. Shielded troops may for the front rank(s) of a unit.</characteristic>
              </characteristics>
            </profile>
            <profile id="27ca-194c-a1a2-e2ed" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="9fae-9463-c797-1ca8" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="cc1b-01dc-de3d-5dcc" type="atLeast"/>
