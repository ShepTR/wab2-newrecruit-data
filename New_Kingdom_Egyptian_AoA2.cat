              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="b309-1993-9551-2479" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="0f06-d149-fee5-afbc" type="atLeast"/>
