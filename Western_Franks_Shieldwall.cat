          <profiles>
            <profile id="7e9a-85fe-d77d-7ab2" name="Freeman" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">4</characteristic>
