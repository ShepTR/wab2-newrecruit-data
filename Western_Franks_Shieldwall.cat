                  <conditions>
                    <condition field="selections" scope="bfb2-dd35-1a89-23b4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6c12-f08e-604e-c42f" type="atLeast"/>
                  </conditions>
                </modifier>
              </modifiers>
            </profile>
            <profile id="2696-1fd1-4e18-66ee" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapons, thrusting spears and shield. May be additionally equipped with javelins (+1 pt). Every other unit may exchange thrusting spear and shield for bows (free). Any unit of Liberi may be designated as light infantry (free). Carolingian French: units may be upgraded to Men of the Marches (+1 pt; Leadership 7). Flanders: cost 7 pts each, have Shieldwall and may be given light armour (+2 pts). Bretons: all Liberi count as light infantry and may exchange thrusting spears for throwing spears (free). (Shieldwall p.73)</characteristic>
              </characteristics>
            </profile>
            <profile id="97d3-aff7-ff03-53c5" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="None">
                <conditions>
                <condition field="selections" scope="bfb2-dd35-1a89-23b4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="635a-60ca-982a-cd40" type="atLeast"/>
                <condition field="selections" scope="bfb2-dd35-1a89-23b4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2a82-6e44-84eb-16a4" type="lessThan"/>
                </conditions>
              </modifier>
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="bfb2-dd35-1a89-23b4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="635a-60ca-982a-cd40" type="lessThan"/>
                <condition field="selections" scope="bfb2-dd35-1a89-23b4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2a82-6e44-84eb-16a4" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
