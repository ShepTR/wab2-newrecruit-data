                <conditions>
                <condition field="selections" scope="5f7f-4b2e-7a1f-4251" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4ac4-fe0c-0c50-15f0" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="ea04-5db0-8852-d5e5" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, shield and either throwing spear or thrusting spear. Mounted Milites have warhorses. May upgrade armour to heavy armour (+1 pt), have javelins (+1 pt). Mounted Milites may receive up to a +1 rank bonus. Carolingian French: may have bows (+1 pt); up to half of a unit may exchange shield and spear for bow (free). Normandy: cost 30 pts each, may exchange thrusting spear for lance (+4 pts), Ferocious Charge. Bretons: cost 30 pts each and have BS 4; fleeing/firing and fleeing as a charge reaction rallies automatically (see rule); all mounted troops count as light cavalry. Capetian French: cost 29 pts each, Ferocious Charge. (Shieldwall p.73)</characteristic>
              </characteristics>
            </profile>
            <profile id="8c24-e4e0-777d-4b65" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="5f7f-4b2e-7a1f-4251" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="4ac4-fe0c-0c50-15f0" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
