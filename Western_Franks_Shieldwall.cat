          <profiles>
            <profile id="5476-13b1-1160-3e00" name="Breton Exile Cavalryman" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="a802-40b5-d980-cabc" typeName="Model">
              <characteristics>
                <characteristic name="M" typeId="35a2-714d-db3e-3738">8</characteristic>
                <characteristic name="WS" typeId="bb04-2b70-ae79-3559">4</characteristic>
                <characteristic name="BS" typeId="ffff-54f0-d131-b6a9">4</characteristic>
                <characteristic name="S" typeId="9e7c-6fc0-c50c-ee53">3</characteristic>
                <characteristic name="T" typeId="d226-f704-80f9-6e23">3</characteristic>
                <characteristic name="W" typeId="ce59-af10-7f37-4238">1</characteristic>
                <characteristic name="I" typeId="8ec4-e9a6-0b8a-08aa">4</characteristic>
                <characteristic name="A" typeId="ee87-e286-4768-82be">1</characteristic>
                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">7</characteristic>
              </characteristics>
              <modifiers>
                <!-- encumbrance -->
              <modifier type="set" field="35a2-714d-db3e-3738" value="7">
                <conditions>
                <condition field="selections" scope="6e94-55bf-d42c-8965" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6967-c63e-02bd-eeea" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="f3ce-dce3-ea45-1439" name="Equipment and options (as printed in WAB2 army list)" publicationId="af20-e256-4a51-93aa" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, shield and throwing spear, mounted on a warhorse. May upgrade armour to heavy armour (+1 pt), javelins (+2 pts). May receive up to a +1 rank bonus when mounted. Any unit that chooses to flee or fire &amp; flee as a charge reaction rallies automatically at the end of its move and may reform facing in any direction; a charging enemy that encounters them does not destroy them. Despite their warhorses and armour the Devroet count as Light Cavalry. (The printed profile gives M4; M8 entered because the unit is mounted on warhorses.) Dogs of War cannot be accompanied by characters and cannot benefit from the Army General and Standard Bearer rules. (Shieldwall p.79)</characteristic>
              </characteristics>
            </profile>
            <profile id="d841-6f22-46a6-caca" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="6e94-55bf-d42c-8965" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="6967-c63e-02bd-eeea" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="4230-1d4e-dde1-645d" name="Mercenary Rally" hidden="false" targetId="3fe9-fce0-4973-895a" type="rule"/>
            <infoLink id="cdcd-ad0f-9e77-d68b" name="Hand Weapon" hidden="false" targetId="a423-b782-e1ce-43e2" type="profile"/>
            <infoLink id="035a-8d39-fcff-8b68" name="Light Armour" hidden="false" targetId="e1d7-1cd3-1431-4862" type="profile">
