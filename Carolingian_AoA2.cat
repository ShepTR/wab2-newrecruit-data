              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Heavy Cavalry have a hand weapon, light armour, throwing spears and shield. First Charge. They may have heavy armour (+1) Dismounted Cavalry have a hand weapon, light armour, thrusting spear and shield. They may have heavy armour (+1).</characteristic>
              </characteristics>
            </profile>
            <profile id="a75b-c6d8-44fb-954a" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="8a7f-1ffd-0525-3660" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="a7f7-d712-f641-5767" type="atLeast"/>
                </conditions>
              </modifier>
