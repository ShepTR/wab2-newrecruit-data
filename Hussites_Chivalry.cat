              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, lance, heavy armour, shield, and a warhorse. May wear partial plate armour (free). The warhorse may have cloth barding (+4 pts). 0-1 unit. (Armies of Chivalry p.56)</characteristic>
              </characteristics>
            </profile>
            <profile id="ddc8-ef5e-2706-67bc" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
