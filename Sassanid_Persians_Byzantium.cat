              </characteristics>
            </profile>
            <profile id="6e8a-9ea3-4e15-dba7" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">The Throne may be guarded by up to five Throne Guards armed with a hand weapon, light armour and a shield at the cost of +10 pts per model. The Throne is placed on a small mound and surrounded by the Throne Guards, who must remain in base contact with it. The Throne is immobile and is not a large target. Missile fire hits are allocated: D6 1-3 the Throne is hit, 4-6 the Guards or the Army General is hit. The Army General is always the last to receive hits. All fleeing Sassanid units within 6" of the Throne may immediately take a Rally test, even if in the middle of a flight. Sassanid units who were pursued and caught but who rallied do not count as destroyed - the pursuing unit counts as charging in the next turn of close combat. Shahanshah or Spahbedh may be seated on it. (Byzantium p.47)</characteristic>
              </characteristics>
            </profile>
            <profile id="0e28-4793-c4f2-2f53" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <!-- armour-save -->
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="fb9f-3392-c0a6-1918" name="Throne (Sassanid)" hidden="false" targetId="d880-9592-829c-72f3" type="rule"/>
            <infoLink id="4e3b-f6fe-549c-855c" name="Sassanid Persians (Byzantium) - List Notes" hidden="false" targetId="38bf-29c2-cb27-bd99" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
          </costs>
        </selectionEntry>
