            <profile id="b8c2-15ab-7ade-909f" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, heavy armour and kontos. May have a buckler (+1 pt), and barding for their mounts (+4 pts). Superior Persian Cavalry. Cataphract - may count their rank bonus up to a maximum of +2. If they wheel more than 1" during the Movement phase, Cataphracts may only move at their normal Movement rate. 0-1 unit. Early Sassanid armies only. (Byzantium p.48)</characteristic>
              </characteristics>
            </profile>
            <profile id="2111-1bf3-b9ad-d360" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="2+">
                <conditions>
                <condition field="selections" scope="b3da-e838-fe86-7bdf" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="dc53-acf8-501e-2efe" type="lessThan"/>
