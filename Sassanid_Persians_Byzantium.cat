                <condition field="selections" scope="703e-d8f8-86d7-5083" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="d6c3-e3d3-47ae-d1ea" type="atLeast"/>
                </conditions>
