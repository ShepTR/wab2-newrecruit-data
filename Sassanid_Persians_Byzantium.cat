                <characteristic name="Ld" typeId="b6d1-0987-3a4d-d6a9">5</characteristic>
              </characteristics>
            </profile>
            <profile id="2a69-a416-94e5-4eaf" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">One Crewman armed with dagger &amp; heavy armour. Scythed Chariot: in addition to the rules on pages 57-59 of the WAB rulebook, scythed chariots may be fielded in units of less than three models. They may not have Standards, Leaders or Musicians. A Scythed Chariot counts as three models for the calculation of unit size. Early Sassanid Persians only. 0-1 per 1,000 pts. (Byzantium p.49)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="d845-1706-0f0a-1c70" name="Scythed Chariots (Sassanid)" hidden="false" targetId="1012-5401-b259-113c" type="rule"/>
