            </profile>
            <profile id="deb1-e88e-f464-3c1a" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon &amp; light armour. On foot. May only have either shield (+2 pts), Cane Shield (+3 pts), and a bow (+3 pts). Tirbadhs must lead a City Militia or Levy unit. (Byzantium p.47)</characteristic>
              </characteristics>
            </profile>
            <profile id="b865-14f5-bbf5-1e83" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="a78e-4bae-9217-53c0" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="689a-8779-c6b2-3434" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
