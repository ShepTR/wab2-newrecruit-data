              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Elephants have a mahout armed with a dagger, and a crewman armed with a hand weapon and javelins. They may have a howdah (+8 pts) and up to two additional crew armed with javelins (+6 pts each) may be added. The crew may have light armour (+3 pts), bow (+3 pts), and either thrusting spear (+1 pt) or shield (+1 pt). Elephant. 0-1 per 1,000 pts. (Byzantium p.48)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="f429-28fc-f1bc-f9ba" name="Elephant (Sassanid)" hidden="false" targetId="64e7-ecbd-f9c6-14ae" type="rule"/>
