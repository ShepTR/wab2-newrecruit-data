                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="71b7-21e1-e7ca-4f3f" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, javelins and shield. May exchange javelins for throwing spear (+1 pt). May have large shield (+2 pts), light armour (+2 pts), bow (+3 pts), and may be Riding Camels (+1 pt). May be Stubborn (+3 pts). Light Infantry. Warband. Shieldwall. Stealth. 0-2 units. (Byzantium p.49)</characteristic>
              </characteristics>
            </profile>
            <profile id="b74e-91e6-2948-4dc7" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="703e-d8f8-86d7-5083" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="52fa-222a-46b0-1bad" type="atLeast"/>
