              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, sling or javelins and a buckler. Any unit may exchange buckler for shield (+1 pt), and sling or javelins for bow (+1 pt). Light Infantry. Warband Psychology Rules 1 &amp; 2. Stealth. 0-2 units. (Byzantium p.49)</characteristic>
              </characteristics>
            </profile>
            <profile id="f79b-4f1e-fc94-b0c9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">6+ with Buckler +1 in hand-to-hand only</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="10f7-084c-319f-3643" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e7b4-da81-e578-58aa" type="atLeast"/>
                </conditions>
              </modifier>
              <modifier type="set" field="5882-dd5a-bc28-4024" value="-">
                <conditions>
                <condition field="selections" scope="10f7-084c-319f-3643" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="e7b4-da81-e578-58aa" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
