            <profile id="0a2f-633b-0e11-aa56" name="Equipment and options (as printed in WAB2 army list)" publicationId="15ea-5299-d0f5-5dbb" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon &amp; bow. May have shield (+1 pt) and javelins (+1 pt). Iranians may exchange bow for javelins and shield (free). Light Cavalry. Parthians and Ephthalites are Nomad Cavalry. Iranians have Parthian Shot. Ephthalites may not be chosen in Later Sassanid armies. (Byzantium p.48)</characteristic>
              </characteristics>
            </profile>
            <profile id="865e-5815-4d01-a5d4" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="fef9-cb38-1ade-01e2" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="3195-a9eb-abf0-bbda" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
