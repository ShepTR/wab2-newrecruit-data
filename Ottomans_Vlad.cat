                <conditions>
                <condition field="selections" scope="a677-8db9-99e2-d437" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c068-070b-d8ab-4091" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
            <profile id="3c70-5a9d-41bc-159b" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, bow, and shield. May have light armour (+2 pts) and may take pole arms (+2 pts); may take Ditch &amp; Stakes (+20 pts for frontal protection; +50 points for full encirclement) and Tethered Camels (+1 pt). Guard Archers. Kapikulu. Drilled rules 2, 3, and 4. Stubborn. Veterans. Ditch &amp; Stakes. Tethered Camels. Open Order - but counts rank bonus of up to +2 in open terrain. Solaks must be the smallest Janissary unit in the army. 0-1 unit; may be taken only if a Padişah is also taken (Ottoman Empire). (Vlad the Impaler p.41)</characteristic>
              </characteristics>
            </profile>
            <profile id="8a12-0958-276d-bc29" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="a677-8db9-99e2-d437" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c068-070b-d8ab-4091" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
          </profiles>
