            <profile id="733b-a119-8fdf-ce4d" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, lance, heavy armour, shield and warhorse. May wear partial plate or full plate armour (free) and may take cloth (+4 pts) or plate barding (+6 pts). First Charge. Serb Vlastella may count a +1 rank bonus. Ottoman Empire only. (Vlad the Impaler p.42)</characteristic>
              </characteristics>
            </profile>
            <profile id="971d-835e-86e7-1ced" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">3+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="5882-dd5a-bc28-4024" value="2+ with Cloth barding +1 in hand-to-hand only">
                <conditions>
                <condition field="selections" scope="b440-cc30-70ce-a3c4" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1b20-ea37-a9a0-c7bf" type="lessThan"/>
