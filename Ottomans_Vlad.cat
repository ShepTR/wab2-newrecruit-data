            <profile id="61c7-efe5-3eb1-a705" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, and shield. Must have a horse (free) if mounted. May have cloth (+4 pts) or plate barding (+6 pts). May wear heavy (+2 pts) or partial plate armour (+2 if mounted, +4 pts if dismounted). Army Standard Bearer. Eastern Shock Cavalry if mounted. 0-1. (Vlad the Impaler p.38)</characteristic>
              </characteristics>
            </profile>
            <profile id="1a3f-ff4e-4ac9-7fd6" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">5+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
