            <profile id="125c-8e14-51cc-c5de" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, bow, and horse. May take shields (+2 pts). Vlachs may take thrusting spears (+2 pts). Nomad Cavalry. Skirmishers. 0-2 units. This entry represents horse archers from conquered territories that served in Ottoman armies, whether ex-Byzantine, Bulgar, Cuman, Hungarian, Serbian or Vlachs. Ottoman Empire only. (Vlad the Impaler p.43)</characteristic>
              </characteristics>
            </profile>
            <profile id="8297-547d-cfdc-6dac" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="a1d0-73d8-bf25-93bc" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="134a-afe1-e421-b237" type="atLeast"/>
                </conditions>
              </modifier>
              </modifiers>
            </profile>
