            </profile>
            <profile id="febc-9c4e-8170-9a73" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, and either bow or polearm. May have shield (+1 pt) and light armour (+2 pts). Bow armed models may take polearms (+2 pts). May trade bow for crossbow or handgun (+2 pts). May take Ditch &amp; Stakes (+20 pts per unit for frontal protection; +50 points for full encirclement) and Tethered Camels (+1 pt). Kapikulu. Drilled rules 2, 3, and 4. Open Order - but counts rank bonus of up to +2 in open terrain. Polearm and bow armed models may be taken together in Mixed Order. May be upgraded to Stubborn (+3 pts). 0-1 unit may take crossbows up to 1429; after 1429 every other unit may take handguns. (Vlad the Impaler p.41)</characteristic>
              </characteristics>
            </profile>
            <profile id="daa9-c270-2a89-1782" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">None</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="6+">
                <conditions>
                <condition field="selections" scope="04df-64f3-05de-3abd" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="67cf-8092-b2ad-ca59" type="atLeast"/>
