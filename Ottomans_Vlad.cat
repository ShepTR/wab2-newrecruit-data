            <profile id="529c-f69e-d009-32df" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, light armour, bow, thrusting spear, shield, and horse. May have heavy or partial plate armour (+2 pts) and horses may take cloth (+4 pts) or lamellar (counts as plate) barding (+6 pts). Kapikulu. Eastern Shock Cavalry. Open Order. If barding is taken in a unit, it loses Open Order, but then counts as Drilled. If a Padişah leads the army, 0-1 unit may upgrade to Silahtars (Sword Bearers) or Sipahi Oglan (Sipahi's Children) which are WS 5 and Stubborn (+5 pts). 0-1 per first 2,000 pts, and 0-1 per each 1,000 pts thereafter (Ottoman Empire). (Vlad the Impaler p.41)</characteristic>
              </characteristics>
            </profile>
            <profile id="410b-02e1-a0d8-f60f" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">4+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="3+">
                <conditions>
                <condition field="selections" scope="3ef4-2d5c-8a0e-d832" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="fb73-ae25-b523-3301" type="atLeast"/>
                <condition field="selections" scope="3ef4-2d5c-8a0e-d832" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="00cc-a889-5eed-2d23" type="lessThan"/>
