            <profile id="559a-ce7b-ff5a-ac27" name="Equipment and options (as printed in WAB2 army list)" publicationId="dab5-785d-be28-f228" hidden="false" typeId="b19e-ee0c-17d1-6e33" typeName="Equipment and Notes">
              <characteristics>
                <characteristic name="Text" typeId="63ac-8f60-d28a-2232">Hand weapon, bow, thrusting spear, shield, and horse. May have light (+2 pts) or heavy armour (+3 pts). Eastern Shock Cavalry. Open Order. Gazi State: 0-1 unit per 1,000 pts. Ottoman Empire: 1+ unit. (Vlad the Impaler p.39)</characteristic>
              </characteristics>
            </profile>
            <profile id="e642-2f87-caec-7fd9" name="Armour Save" hidden="false" typeId="0dbe-f4ed-ef08-8e86" typeName="Armour Save">
              <characteristics>
                <characteristic name="Save" typeId="603e-2898-6af9-6cf1">6+</characteristic>
                <characteristic name="With conditional bonuses" typeId="5882-dd5a-bc28-4024">-</characteristic>
                <characteristic name="Notes" typeId="d5e4-804e-6192-0114">Armour save from armour, shield and barding bonus pips (rulebook pp.95-98); maximum 3+ (2+ for barded cavalry). M already includes encumbrance for armour/barding (p.96). Conditional pips are in the next column.</characteristic>
              </characteristics>
              <modifiers>
                <!-- armour-save -->
              <modifier type="set" field="603e-2898-6af9-6cf1" value="5+">
                <conditions>
                <condition field="selections" scope="1045-20b1-1779-fcb7" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="58e4-9cd3-d597-ea13" type="atLeast"/>
